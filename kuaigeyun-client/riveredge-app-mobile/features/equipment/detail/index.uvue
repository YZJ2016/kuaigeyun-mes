<template>
	<scroll-view class="page" direction="vertical">
		<view class="card">
			<text class="title">设备详情</text>
			<button :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="loadDetail">刷新</button>
			<text v-if="summaryText.length > 0" class="hint">{{ summaryText }}</text>
			<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { request } from '../../../shared/api/index.uts'
	import { asJsonObject, fieldText } from '../../../shared/api/fields.uts'
	import { joinParts, readError } from '../json-text.uts'

	const busy = ref(false)
	const queryUuid = ref('')
	const summaryText = ref('')
	const errorText = ref('')

	function readQueryUuid(options: OnLoadOptions): string {
		const raw = options['uuid']
		if (raw == null) {
			return ''
		}
		return ('' + raw).trim()
	}

	async function loadDetail(): Promise<void> {
		if (busy.value) {
			return
		}
		const uuid = queryUuid.value
		if (uuid.length == 0) {
			errorText.value = '缺少设备 uuid'
			summaryText.value = ''
			return
		}
		busy.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment/' + encodeURIComponent(uuid),
				method: 'GET',
				data: null
			})
			const body = asJsonObject(raw)
			summaryText.value = joinParts([
				fieldText(body, 'code'),
				fieldText(body, 'name'),
				fieldText(body, 'status'),
				fieldText(body, 'production_line_name'),
				fieldText(body, 'workshop_name'),
				fieldText(body, 'uuid')
			])
			if (summaryText.value.length == 0) {
				errorText.value = '未打开设备'
			}
		} catch (e) {
			errorText.value = readError(e)
			summaryText.value = ''
		}
		busy.value = false
	}

	onLoad((options: OnLoadOptions) => {
		queryUuid.value = readQueryUuid(options)
	})

	onShow(() => {
		loadDetail()
	})
</script>


