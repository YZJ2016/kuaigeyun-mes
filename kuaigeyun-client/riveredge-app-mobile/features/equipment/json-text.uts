import { errorText } from '../../shared/api/fields.uts'

export function joinParts(parts: Array<string>): string {
	let text = ''
	for (let i = 0; i < parts.length; i++) {
		const part = parts[i]
		if (part.length == 0) {
			continue
		}
		if (text.length > 0) {
			text = text + ' · '
		}
		text = text + part
	}
	return text
}

export function parseRequiredInt(raw: string): number | null {
	const text = raw.trim()
	if (text.length == 0) {
		return null
	}
	const value = parseInt(text)
	if (isNaN(value) || value <= 0) {
		return null
	}
	return value
}

export function parseIdList(raw: string): Array<number> | null {
	const text = raw.trim()
	const ids: Array<number> = []
	if (text.length == 0) {
		return ids
	}
	const parts = text.split(',')
	for (let i = 0; i < parts.length; i++) {
		const value = parseRequiredInt(parts[i])
		if (value == null) {
			return null
		}
		ids.push(value)
	}
	return ids
}

export function jsonObjectList(body: UTSJSONObject | null, key: string): Array<UTSJSONObject> {
	const rows: Array<UTSJSONObject> = []
	if (body == null) {
		return rows
	}
	const raw = body.getArray<UTSJSONObject>(key)
	if (raw == null) {
		return rows
	}
	for (let i = 0; i < raw.length; i++) {
		const row = raw[i]
		if (row != null) {
			rows.push(row)
		}
	}
	return rows
}

function digitsOnly(text: string): boolean {
	if (text.length == 0) {
		return false
	}
	for (let i = 0; i < text.length; i++) {
		const ch = text.charAt(i)
		if (ch < '0' || ch > '9') {
			return false
		}
	}
	return true
}

/** 校验 YYYY-MM-DD 且为真实日期（含闰年 2 月）。 */
export function isValidDateText(raw: string): boolean {
	const text = raw.trim()
	if (text.length != 10) {
		return false
	}
	if (text.charAt(4) != '-' || text.charAt(7) != '-') {
		return false
	}
	const yearText = text.substring(0, 4)
	const monthText = text.substring(5, 7)
	const dayText = text.substring(8, 10)
	if (!digitsOnly(yearText) || !digitsOnly(monthText) || !digitsOnly(dayText)) {
		return false
	}
	const year = parseInt(yearText)
	const month = parseInt(monthText)
	const day = parseInt(dayText)
	if (month < 1 || month > 12) {
		return false
	}
	let maxDay = 31
	if (month == 4 || month == 6 || month == 9 || month == 11) {
		maxDay = 30
	}
	if (month == 2) {
		const leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
		maxDay = leap ? 29 : 28
	}
	return day >= 1 && day <= maxDay
}

/** 错误透传：读 message/detail，兜底 '请求失败'。 */
export function readError(err: any | null): string {
	return errorText(err)
}
