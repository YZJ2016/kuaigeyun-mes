<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<view class="card">
			<text class="title">换线绑定</text>
			<action-button label="刷新" tone="secondary" :disabled="loading || busy" @press="loadList" />
			<text v-if="!loading && rows.length == 0 && errorText.length == 0" class="empty">暂无记录</text>
			<view class="item" v-for="item in rows" :key="item.rowKey">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</view>
		</view>
		<view class="card">
			<text class="title">新建</text>
			<input class="field" v-model="productionLineIdText" placeholder="产线 ID"  :disabled="loading || busy" />
			<input class="field" v-model="overdueHoursText" placeholder="强制初检超时小时（默认 4）"  :disabled="loading || busy" />
			<input class="field" v-model="equipmentIdsText" placeholder="预置设备 ID，逗号分隔（可空）"  :disabled="loading || busy" />
			<input class="field" v-model="remarkText" placeholder="备注（可空）"  :disabled="loading || busy" />
			<action-button label="新建" tone="primary" :disabled="loading" :busy="busy" busy-label="提交中" @press="submitCreate" />
			<text v-if="messageText.length > 0" class="hint">{{ messageText }}</text>
			<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { asJsonObject, fieldText, readRows } from '../../../shared/api/fields.uts'
	import { joinParts, parseIdList, parseRequiredInt, readError } from '../json-text.uts'

	type ListRow = {
		rowKey: string
		title: string
		detail: string
	}

	const busy = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	const rows = ref<Array<ListRow>>([])
	const productionLineIdText = ref('')
	const overdueHoursText = ref('4')
	const equipmentIdsText = ref('')
	const remarkText = ref('')
	const messageText = ref('')
	const errorText = ref('')

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment-line-rebinds',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const title = fieldText(row, 'document_no')
				const detail = joinParts([
					fieldText(row, 'production_line_name'),
					fieldText(row, 'status'),
					fieldText(row, 'item_count'),
					fieldText(row, 'force_spot_overdue_hours')
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					title: title.length > 0 ? title : '换线绑定',
					detail: detail
				}
				next.push(view)
			}
			if (ticket != mine) {
				return
			}
			rows.value = next
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false; loadSettled.value = true
	}

	async function submitCreate(): Promise<void> {
		if (busy.value) {
			return
		}
		busy.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const productionLineId = parseRequiredInt(productionLineIdText.value)
			if (productionLineId == null) {
				errorText.value = '请填写产线 ID'
				busy.value = false
				return
			}
			const hoursText = overdueHoursText.value.trim().length == 0 ? '4' : overdueHoursText.value
			const hours = parseRequiredInt(hoursText)
			if (hours == null || hours > 720) {
				errorText.value = '超时小时须在 1 到 720'
				busy.value = false
				return
			}
			const equipmentIds = parseIdList(equipmentIdsText.value)
			if (equipmentIds == null) {
				errorText.value = '预置设备 ID 无效'
				busy.value = false
				return
			}
			const data = new UTSJSONObject()
			data.set('production_line_id', productionLineId)
			data.set('force_spot_overdue_hours', hours)
			data.set('equipment_ids', equipmentIds)
			if (remarkText.value.trim().length > 0) {
				data.set('remark', remarkText.value.trim())
			}
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment-line-rebinds',
				method: 'POST',
				data: data
			})
			const documentNo = fieldText(asJsonObject(raw), 'document_no')
			messageText.value = documentNo.length > 0 ? ('已新建 ' + documentNo) : '已新建'
			await loadList()
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	onShow(() => {
		loadList().catch((e) => {
			errorText.value = readError(e)
		})
	})
</script>


