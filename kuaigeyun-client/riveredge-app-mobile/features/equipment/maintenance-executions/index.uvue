<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<view class="card">
			<text class="title">保养执行记录</text>
			<button :class="loading ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="loading" @click="loadList">刷新</button>
			<text v-if="!loading && rows.length == 0 && errorText.length == 0" class="empty">暂无记录</text>
			<view class="item" v-for="item in rows" :key="item.rowKey">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</view>
			<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		</view>
	</scroll-view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { fieldText, readRows } from '../../../shared/api/fields.uts'
	import { joinParts, readError } from '../json-text.uts'

	type ListRow = {
		rowKey: string
		title: string
		detail: string
	}

	const loading = ref(false)
	let ticket = 0
	const rows = ref<Array<ListRow>>([])
	const errorText = ref('')

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/maintenance-plans/executions',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const title = fieldText(row, 'execution_no')
				const detail = joinParts([
					fieldText(row, 'equipment_name'),
					fieldText(row, 'execution_date'),
					fieldText(row, 'status'),
					fieldText(row, 'execution_result'),
					fieldText(row, 'executor_name')
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					title: title.length > 0 ? title : '保养执行',
					detail: detail
				}
				next.push(view)
			}
			if (ticket != mine) {
				return
			}
			rows.value = next
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	onShow(() => {
		loadList()
	})
</script>


