<template>
	<scroll-view class="page" direction="vertical">
		<view class="card">
			<text class="title">维护提醒</text>
			<button :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="loadList">刷新</button>
			<text v-if="rows.length == 0" class="empty">暂无记录</text>
			<view class="item" hover-class="pressed" v-for="(item, index) in rows" :key="item.rowKey" @click="selectRow(index)">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</view>
		</view>
		<view class="card" v-if="reminderUuid.length > 0">
			<text class="title">标记已处理</text>
			<input class="field" v-model="remarkText" placeholder="处理备注（可空）" />
			<button :class="busy ? 'btn-primary is-disabled' : 'btn-primary'" :disabled="busy" @click="submitHandled">标记已处理</button>
		</view>
		<text v-if="messageText.length > 0" class="hint page-hint">{{ messageText }}</text>
		<text v-if="errorText.length > 0" class="error page-hint">{{ errorText }}</text>
	</scroll-view>
</template>

<script setup lang="uts">
	import { request } from '../../../shared/api/index.uts'
	import { fieldBool, fieldText, readRows } from '../../../shared/api/fields.uts'
	import { joinParts, readError } from '../json-text.uts'

	type ListRow = {
		rowKey: string
		uuid: string
		title: string
		detail: string
		canHandle: boolean
	}

	const busy = ref(false)
	const rows = ref<Array<ListRow>>([])
	const reminderUuid = ref('')
	const remarkText = ref('')
	const messageText = ref('')
	const errorText = ref('')

	function selectRow(index: number): void {
		const item = rows.value[index]
		errorText.value = ''
		messageText.value = ''
		if (!item.canHandle) {
			errorText.value = '该提醒已处理'
			reminderUuid.value = ''
			return
		}
		reminderUuid.value = item.uuid
	}

	async function loadList(): Promise<void> {
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/maintenance-reminders',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const handled = fieldBool(row, 'is_handled', false)
				const title = fieldText(row, 'equipment_name')
				const detail = joinParts([
					fieldText(row, 'reminder_type'),
					fieldText(row, 'planned_maintenance_date'),
					fieldText(row, 'reminder_message'),
					handled ? '已处理' : '未处理'
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					uuid: key,
					title: title.length > 0 ? title : '维护提醒',
					detail: detail,
					canHandle: !handled && key.length > 0
				}
				next.push(view)
			}
			rows.value = next
		} catch (e) {
			errorText.value = readError(e)
		}
	}

	async function submitHandled(): Promise<void> {
		if (busy.value) {
			return
		}
		const uuid = reminderUuid.value
		if (uuid.length == 0) {
			errorText.value = '请选择一条提醒'
			return
		}
		busy.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const data = new UTSJSONObject()
			data.set('reminder_uuid', uuid)
			if (remarkText.value.trim().length > 0) {
				data.set('remark', remarkText.value.trim())
			}
			await request({
				url: '/api/v1/apps/kuaizhizao/maintenance-reminders/mark-handled',
				method: 'POST',
				data: data
			})
			messageText.value = '已标记已处理'
			reminderUuid.value = ''
			remarkText.value = ''
			await loadList()
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	onShow(() => {
		loadList().catch((e) => {
			errorText.value = readError(e)
		})
	})
</script>


