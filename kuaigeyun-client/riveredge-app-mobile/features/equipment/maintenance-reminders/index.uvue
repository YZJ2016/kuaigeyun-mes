<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<view class="card">
			<text class="title">维护提醒</text>
			<action-button label="刷新" tone="secondary" :disabled="loading || busy" @press="loadList" />
			<empty-state v-if="!loading && rows.length == 0 && errorText.length == 0" title="暂无记录" :compact="true" />
			<action-card v-for="(item, index) in rows" :key="item.rowKey" @press="selectRow(index)" :disabled="loading || busy" variant="row">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</action-card>
		</view>
		<view class="card" v-if="reminderUuid.length > 0">
			<text class="title">标记已处理</text>
			<text class="hint">确认后标记已处理。</text>
			<input class="field" v-model="remarkText" placeholder="备注（可选，不会保存）"  :disabled="loading || busy" />
			<action-button label="标记已处理" tone="primary" :disabled="loading" :busy="busy" busy-label="提交中" @press="submitHandled" />
		</view>
		<text v-if="messageText.length > 0" class="hint page-hint">{{ messageText }}</text>
		<text v-if="errorText.length > 0" class="error page-hint">{{ errorText }}</text>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../../shared/ui/action-card.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { fieldBool, fieldText, readRows } from '../../../shared/api/fields.uts'
	import { joinParts, readError } from '../json-text.uts'
	import EmptyState from '../../../shared/ui/empty-state.uvue'

	type ListRow = {
		rowKey: string
		uuid: string
		title: string
		detail: string
		canHandle: boolean
	}

	const busy = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	const rows = ref<Array<ListRow>>([])
	const reminderUuid = ref('')
	const remarkText = ref('')
	const messageText = ref('')
	const errorText = ref('')

	function selectRow(index: number): void {
		const item = rows.value[index]
		errorText.value = ''
		messageText.value = ''
		if (!item.canHandle) {
			errorText.value = '该提醒已处理'
			reminderUuid.value = ''
			return
		}
		reminderUuid.value = item.uuid
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/maintenance-reminders',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const handled = fieldBool(row, 'is_handled', false)
				const title = fieldText(row, 'equipment_name')
				const detail = joinParts([
					fieldText(row, 'reminder_type'),
					fieldText(row, 'planned_maintenance_date'),
					fieldText(row, 'reminder_message'),
					handled ? '已处理' : '未处理'
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					uuid: key,
					title: title.length > 0 ? title : '维护提醒',
					detail: detail,
					canHandle: !handled && key.length > 0
				}
				next.push(view)
			}
			if (ticket != mine) {
				return
			}
			rows.value = next
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false; loadSettled.value = true
	}

	async function submitHandled(): Promise<void> {
		if (busy.value) {
			return
		}
		const uuid = reminderUuid.value
		if (uuid.length == 0) {
			errorText.value = '请选择一条提醒'
			return
		}
		busy.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const data = new UTSJSONObject()
			data.set('reminder_uuid', uuid)
			if (remarkText.value.trim().length > 0) {
				data.set('remark', remarkText.value.trim())
			}
			await request({
				url: '/api/v1/apps/kuaizhizao/maintenance-reminders/mark-handled',
				method: 'POST',
				data: data
			})
			messageText.value = '已标记已处理'
			reminderUuid.value = ''
			remarkText.value = ''
			await loadList()
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	onShow(() => {
		loadList().catch((e) => {
			errorText.value = readError(e)
		})
	})
</script>


