import { uploadImage } from '../../shared/api/upload.uts'

function chosenPaths(raw: any | null): Array<string> {
	const paths: Array<string> = []
	if (raw == null) {
		return paths
	}
	const list = raw as Array<any>
	for (let i = 0; i < list.length; i++) {
		const item = list[i]
		if (item == null) {
			continue
		}
		const text = ('' + item).trim()
		if (text.length == 0) {
			continue
		}
		paths.push(text)
	}
	return paths
}

async function uploadPaths(paths: Array<string>, category: string): Promise<Array<UTSJSONObject>> {
	const files: Array<UTSJSONObject> = []
	for (let i = 0; i < paths.length; i++) {
		const file = await uploadImage(paths[i], category)
		files.push(file)
	}
	return files
}

export function uploadChosenImages(category: string): Promise<Array<UTSJSONObject>> {
	return new Promise<Array<UTSJSONObject>>((resolve, reject) => {
		uni.chooseImage({
			count: 9,
			success: (res) => {
				const paths = chosenPaths(res.tempFilePaths)
				if (paths.length == 0) {
					resolve([] as Array<UTSJSONObject>)
					return
				}
				uploadPaths(paths, category).then((files) => {
					resolve(files)
				}).catch((err) => {
					reject(err)
				})
			},
			fail: (err) => {
				let message = ''
				if (err != null && err.errMsg != null) {
					message = '' + err.errMsg
				}
				if (message.indexOf('cancel') >= 0) {
					resolve([] as Array<UTSJSONObject>)
					return
				}
				reject(new Error('请求失败'))
			}
		})
	})
}
