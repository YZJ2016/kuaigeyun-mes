<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<view class="card">
			<text class="title">维修台账</text>
			<action-button label="刷新" tone="secondary" :disabled="loading || busy" @press="loadList" />
			<text v-if="!loading && rows.length == 0 && errorText.length == 0" class="empty">暂无记录</text>
			<action-card v-for="(item, index) in rows" :key="item.rowKey" @press="selectRow(index)" :disabled="loading || busy" variant="row">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</action-card>
		</view>
		<view class="card" v-if="completeUuid.length > 0">
			<text class="title">完工</text>
			<text class="hint">维修结果：{{ repairResult }}</text>
			<view class="choices">
				<choice-button label="成功" :selected="repairResult == repairResults[0]" @choose="chooseResult(0)" :disabled="loading || busy" />
				<choice-button label="失败" :selected="repairResult == repairResults[1]" @choose="chooseResult(1)" :disabled="loading || busy" />
				<choice-button label="部分成功" :selected="repairResult == repairResults[2]" @choose="chooseResult(2)" :disabled="loading || busy" />
			</view>
			<input class="field" v-model="faultCauseText" placeholder="故障原因"  :disabled="loading || busy" />
			<input class="field" v-model="repairContentText" placeholder="维修内容"  :disabled="loading || busy" />
			<input class="field" v-model="remarkText" placeholder="备注（可空）"  :disabled="loading || busy" />
			<action-button label="完工" tone="primary" :disabled="loading" :busy="busy" busy-label="提交中" @press="submitComplete" />
		</view>
		<text v-if="messageText.length > 0" class="hint page-hint">{{ messageText }}</text>
		<text v-if="errorText.length > 0" class="error page-hint">{{ errorText }}</text>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../../shared/ui/action-card.uvue'
	import ChoiceButton from '../../../shared/ui/choice-button.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { fieldText, readRows } from '../../../shared/api/fields.uts'
	import { joinParts, readError } from '../json-text.uts'

	type ListRow = {
		rowKey: string
		uuid: string
		title: string
		detail: string
		canComplete: boolean
		blocked: string
	}

	const repairResults: string[] = ['成功', '失败', '部分成功']

	const busy = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	const rows = ref<Array<ListRow>>([])
	const completeUuid = ref('')
	const repairResult = ref('成功')
	const faultCauseText = ref('')
	const repairContentText = ref('')
	const remarkText = ref('')
	const messageText = ref('')
	const errorText = ref('')

	function chooseResult(index: number): void {
		repairResult.value = repairResults[index]
	}

	function selectRow(index: number): void {
		const item = rows.value[index]
		errorText.value = ''
		messageText.value = ''
		if (!item.canComplete) {
			errorText.value = item.blocked
			completeUuid.value = ''
			return
		}
		completeUuid.value = item.uuid
		repairResult.value = '成功'
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment-faults/repairs',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const status = fieldText(row, 'status')
				const arrival = fieldText(row, 'arrival_at')
				let canComplete = false
				let blocked = '当前状态不可完工'
				if (status == '已完成') {
					blocked = '该维修已完工'
				} else if (status == '已取消') {
					blocked = '该维修已取消'
				} else if (status == '进行中') {
					if (arrival.length == 0) {
						blocked = '须先到场后再完工'
					} else {
						canComplete = true
						blocked = ''
					}
				}
				const title = fieldText(row, 'repair_no')
				const detail = joinParts([
					fieldText(row, 'equipment_name'),
					fieldText(row, 'repair_type'),
					status,
					arrival.length > 0 ? arrival : '未到场'
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					uuid: key,
					title: title.length > 0 ? title : '维修',
					detail: detail,
					canComplete: canComplete,
					blocked: blocked
				}
				next.push(view)
			}
			if (ticket != mine) {
				return
			}
			rows.value = next
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false; loadSettled.value = true
	}

	async function submitComplete(): Promise<void> {
		if (busy.value) {
			return
		}
		const uuid = completeUuid.value
		if (uuid.length == 0) {
			errorText.value = '请选择一条维修'
			return
		}
		const cause = faultCauseText.value.trim()
		const content = repairContentText.value.trim()
		if (cause.length == 0) {
			errorText.value = '请填写故障原因'
			return
		}
		if (content.length == 0) {
			errorText.value = '请填写维修内容'
			return
		}
		busy.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const data = new UTSJSONObject()
			data.set('fault_cause', cause)
			data.set('repair_content', content)
			data.set('repair_result', repairResult.value)
			if (remarkText.value.trim().length > 0) {
				data.set('remark', remarkText.value.trim())
			}
			await request({
				url: '/api/v1/apps/kuaizhizao/equipment-faults/repairs/' + encodeURIComponent(uuid) + '/complete',
				method: 'POST',
				data: data
			})
			messageText.value = '已完工'
			completeUuid.value = ''
			faultCauseText.value = ''
			repairContentText.value = ''
			remarkText.value = ''
			await loadList()
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	onShow(() => {
		loadList().catch((e) => {
			errorText.value = readError(e)
		})
	})
</script>

<style>
	.choices {
		flex-direction: row;
		flex-wrap: wrap;
	}
</style>
