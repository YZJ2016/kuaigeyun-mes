<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<view class="card">
			<text class="title">路线巡检</text>
			<button :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="loadList">刷新</button>
			<text v-if="!loading && rows.length == 0 && errorText.length == 0" class="empty">暂无记录</text>
			<view class="item" v-for="item in rows" :key="item.rowKey">
				<text class="item-title">{{ item.title }}</text>
				<text class="hint">{{ item.detail }}</text>
			</view>
		</view>
		<view class="card">
			<text class="title">新建</text>
			<master-picker kind="route" title="巡检路线" :disabled="busy" @choose="chooseRoute" />
			<input class="field" v-model="patrolDateText" placeholder="巡检日期（可空，YYYY-MM-DD）" />
			<text class="hint">巡检人默认使用当前操作人</text>

			<input class="field" v-model="remarkText" placeholder="备注（可空）" />
			<button :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="loadPreview">加载巡检项</button>
			<text v-if="lines.length > 0" class="hint">第 {{ pointIndex + 1 }} 点，共 {{ lines.length }} 点</text>
			<view v-for="(line, index) in lines" :key="line.rowKey">
				<view class="item" v-if="index == pointIndex">
				<text class="item-title">{{ line.title }}</text>
				<text v-if="line.detail.length > 0" class="hint">{{ line.detail }}</text>
				<text class="hint">采集模式 {{ line.captureMode }}</text>
				<text v-if="line.isBoolean && line.showPass" class="hint">{{ line.measuredValue }}</text>
				<input v-if="line.showMeasured" class="field" :value="line.measuredValue" placeholder="实测值" @input="onMeasured(index, $event)" />
				<button v-if="line.showPass" :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="onTogglePass(index)">{{ line.passLabel }}</button>
				<text v-if="line.photoHint.length > 0" class="hint">{{ line.photoHint }}</text>
				<button :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="onLinePhoto(index)">上传照片</button>
				<text v-if="line.attachments.length > 0" class="hint">已选 {{ line.attachments.length }} 张</text>
				<button v-if="line.attachments.length > 0" :class="busy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="busy" @click="clearLinePhotos(index)">清除照片</button>
				</view>
			</view>
			<button v-if="lines.length > 0 && pointIndex > 0" class="btn-secondary" @click="pointBack">上一点</button>
			<button v-if="lines.length > 0" :class="busy ? 'btn-primary is-disabled' : 'btn-primary'" :disabled="busy" @click="advancePoint">{{ pointButtonLabel() }}</button>
			<button v-else :class="busy ? 'btn-primary is-disabled' : 'btn-primary'" :disabled="busy" @click="submitCreate">新建</button>
			<text v-if="messageText.length > 0" class="hint">{{ messageText }}</text>
			<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		</view>
	</scroll-view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import MasterPicker from '../components/master-picker.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { fieldText, readRows } from '../../../shared/api/fields.uts'
	import { pickAndUploadImage } from '../../../shared/api/pick-image.uts'
	import { joinParts, parseRequiredInt, readError } from '../json-text.uts'
	import { loadRoutePatrolPreview, PatrolLineForm, submitRoutePatrol, togglePatrolPass } from '../route-patrol-create.uts'

	type ListRow = {
		rowKey: string
		title: string
		detail: string
	}

	const busy = ref(false)
	const loading = ref(false)
	let ticket = 0
	const rows = ref<Array<ListRow>>([])
	const routeIdText = ref('')
	const patrolDateText = ref('')
	const inspectorIdText = ref('')
	const inspectorNameText = ref('')
	const remarkText = ref('')
	const messageText = ref('')
	const errorText = ref('')
	const loadedRouteId = ref(0)
	const lines = ref<Array<PatrolLineForm>>([])
	const pointIndex = ref(0)

	function chooseRoute(row : any) {
		if (busy.value) { return }
		routeIdText.value = fieldText(row, 'id')
		clearPreview()
	}

	function optionalInt(raw: string): number | null {
		if (raw.trim().length == 0) {
			return null
		}
		return parseRequiredInt(raw)
	}

	function inputValue(event: UniInputEvent): string {
		return event.detail.value
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		try {
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment-route-patrols',
				method: 'GET',
				data: null
			})
			const items = readRows(raw)
			const next: Array<ListRow> = []
			for (let i = 0; i < items.length; i++) {
				const row = items[i]
				const title = fieldText(row, 'document_no')
				const detail = joinParts([
					fieldText(row, 'route_name'),
					fieldText(row, 'patrol_date'),
					fieldText(row, 'status'),
					fieldText(row, 'inspector_name')
				])
				const key = fieldText(row, 'uuid')
				const view: ListRow = {
					rowKey: key.length > 0 ? key : ('' + i),
					title: title.length > 0 ? title : '巡检单',
					detail: detail
				}
				next.push(view)
			}
			if (ticket != mine) {
				return
			}
			rows.value = next
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function clearPreview(): void {
		loadedRouteId.value = 0
		lines.value = []
		pointIndex.value = 0
	}

	function pointButtonLabel(): string {
		if (pointIndex.value + 1 < lines.value.length) {
			return '巡下一点'
		}
		return '完成巡检'
	}

	function pointBack(): void {
		if (pointIndex.value > 0) {
			pointIndex.value = pointIndex.value - 1
		}
	}

	function advancePoint(): void {
		if (pointIndex.value + 1 < lines.value.length) {
			pointIndex.value = pointIndex.value + 1
			return
		}
		void submitCreate()
	}

	async function loadPreview(): Promise<void> {
		if (busy.value) {
			return
		}
		errorText.value = ''
		messageText.value = ''
		const routeId = parseRequiredInt(routeIdText.value)
		if (routeId == null) {
			errorText.value = '请选择巡检路线'
			return
		}
		busy.value = true
		try {
			const preview = await loadRoutePatrolPreview(routeId)
			loadedRouteId.value = routeId
			pointIndex.value = 0
			lines.value = preview.lines
			messageText.value = '已加载 ' + preview.lines.length + ' 行'
		} catch (e) {
			clearPreview()
			errorText.value = readError(e)
		}
		busy.value = false
	}

	function onMeasured(index: number, event: UniInputEvent): void {
		const list = lines.value
		list[index].measuredValue = inputValue(event)
		lines.value = list
	}

	function onTogglePass(index: number): void {
		const list = lines.value
		togglePatrolPass(list[index])
		lines.value = list
	}

	async function onLinePhoto(index: number): Promise<void> {
		if (busy.value) {
			return
		}
		busy.value = true
		errorText.value = ''
		try {
			const file = await pickAndUploadImage('equipment_route_patrol_line')
			if (file != null) {
				const list = lines.value
				const attachments = list[index].attachments
				attachments.push(file)
				list[index].attachments = attachments
				lines.value = list
			}
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	function clearLinePhotos(index: number): void {
		const list = lines.value
		const cleared: Array<UTSJSONObject> = []
		list[index].attachments = cleared
		lines.value = list
	}

	async function submitCreate(): Promise<void> {
		if (busy.value) {
			return
		}
		busy.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const routeId = parseRequiredInt(routeIdText.value)
			if (routeId == null) {
				errorText.value = '请选择巡检路线'
				busy.value = false
				return
			}
			if (inspectorIdText.value.trim().length > 0 && optionalInt(inspectorIdText.value) == null) {
				errorText.value = '巡检人 ID 无效'
				busy.value = false
				return
			}
			if (loadedRouteId.value != routeId) {
				errorText.value = '请先加载巡检项'
				busy.value = false
				return
			}
			const result = await submitRoutePatrol({
				routeId: routeId,
				patrolDate: patrolDateText.value.trim(),
				inspectorId: optionalInt(inspectorIdText.value),
				inspectorName: inspectorNameText.value.trim(),
				remark: remarkText.value.trim(),
				lines: lines.value
			})
			if (result.errorText.length > 0) {
				errorText.value = result.errorText
				busy.value = false
				return
			}
			const documentNo = fieldText(result.saved, 'document_no')
			messageText.value = documentNo.length > 0 ? ('已新建 ' + documentNo) : '已新建'
			clearPreview()
			await loadList()
		} catch (e) {
			errorText.value = readError(e)
		}
		busy.value = false
	}

	onShow(() => {
		loadList().catch((e) => {
			errorText.value = readError(e)
		})
	})
</script>


