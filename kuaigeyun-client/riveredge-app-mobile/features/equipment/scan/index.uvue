<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<view class="card">
			<text class="title">扫码查设备</text>
			<action-button label="扫码" tone="primary" :disabled="loading" @press="onScan" />
			<text v-if="messageText.length > 0" class="hint">{{ messageText }}</text>
			<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		</view>
	</scroll-view>
		<load-feedback :active="loading" mode="blocking" label="正在解析扫码内容" />
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { asJsonObject, fieldText } from '../../../shared/api/fields.uts'
	import { scan } from '../../../shared/channel/index.uts'
	import { openRegisteredRoute } from '../../../shell/registry/index.uts'
	import { readError } from '../json-text.uts'

	const loading = ref(false)
	let ticket = 0
	const messageText = ref('')
	const errorText = ref('')

	async function onScan(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorText.value = ''
		messageText.value = ''
		try {
			const code = await scan()
			if (ticket != mine) {
				return
			}
			const text = code == null ? '' : ('' + code).trim()
			if (text.length == 0) {
				errorText.value = '未得到扫码内容'
				loading.value = false
				return
			}
			const raw = await request({
				url: '/api/v1/apps/kuaizhizao/equipment/resolve-scan?q=' + encodeURIComponent(text),
				method: 'GET',
				data: null
			})
			if (ticket != mine) {
				return
			}
			const uuid = fieldText(asJsonObject(raw), 'uuid')
			if (uuid.length == 0) {
				errorText.value = '未解析到设备'
				loading.value = false
				return
			}
			const opened = openRegisteredRoute('/equipment/detail?uuid=' + encodeURIComponent(uuid))
			if (!opened) {
				errorText.value = '无法打开设备'
			}
		} catch (e) {
			if (ticket != mine) {
				return
			}
			errorText.value = readError(e)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}
</script>


