import { isDateText as validDateText, todayDate as currentDateText } from '../../shared/ui/date.uts'
import { SheetOption, sheetOption } from '../../shared/ui/sheet-option.uts'
import { request } from '../../shared/api/index.uts'
import { asJsonObject, fieldNumber, fieldText, readRows } from '../../shared/api/fields.uts'

export const MOLD_ARCHIVE = '/api/v1/apps/kuaizhizao/molds'
export const MOLD_BORROWS = '/api/v1/apps/kuaizhizao/mold-borrows'
export const MOLD_BORROWS_OUTSTANDING = '/api/v1/apps/kuaizhizao/mold-borrows/outstanding'
export const MOLD_RETURNS = '/api/v1/apps/kuaizhizao/mold-returns'
export const MOLD_RETURN_USAGE_PREVIEW = '/api/v1/apps/kuaizhizao/mold-returns/usage-preview'
export const MOLD_MAINTENANCES = '/api/v1/apps/kuaizhizao/mold-maintenances'
export const MOLD_MAINTENANCE_SCHEMES = '/api/v1/apps/kuaizhizao/mold-maintenance-schemes'
export const MOLD_REPAIRS = '/api/v1/apps/kuaizhizao/mold-repairs'
export const MOLD_REPAIR_SCHEMES = '/api/v1/apps/kuaizhizao/mold-repair-schemes'
export const MOLD_REMINDERS = '/api/v1/apps/kuaizhizao/molds/maintenance-reminders'

export function withQuery(url: string, query: string): string {
	if (query == '') {
		return url
	}
	return url + '?' + query
}

/** 对象响应收口：unwrap 为 null、裸数组或非对象时返回 null，调用点判空。 */
export async function apiGet(url: string): Promise<UTSJSONObject | null> {
	const raw = await request({
		url: url,
		method: 'GET'
	})
	return asJsonObject(raw)
}

/** 列表响应收口：兼容裸数组与 {items}/{data} 包装，失败或不可读时返回空列表。 */
export async function apiGetRows(url: string): Promise<UTSJSONObject[]> {
	const raw = await request({
		url: url,
		method: 'GET'
	})
	return readRows(raw)
}

export async function apiPost(url: string, data: UTSJSONObject): Promise<UTSJSONObject | null> {
	const raw = await request({
		url: url,
		method: 'POST',
		data: data
	})
	return asJsonObject(raw)
}

export function putText(body: UTSJSONObject, key: string, value: string): void {
	const trimmed = value.trim()
	if (trimmed != '') {
		body.set(key, trimmed)
	}
}

export function isDateText(value: string): boolean { return validDateText(value) }
export function todayDate(): string { return currentDateText() }

export class NamedOption {
	id: number = 0
	label: string = ''
}

export function toSheetOptions(items: NamedOption[]): SheetOption[] {
	const rows: SheetOption[] = []
	for (let i = 0; i < items.length; i++) {
		rows.push(sheetOption(items[i].id, items[i].label))
	}
	return rows
}

export function mapNamedOptions(items: UTSJSONObject[]): NamedOption[] {
	const rows: NamedOption[] = []
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		const row = new NamedOption()
		row.id = fieldNumber(item, 'id')
		const code = fieldText(item, 'code')
		const name = fieldText(item, 'name')
		if (code != '' && name != '') {
			row.label = code + ' - ' + name
		} else if (name != '') {
			row.label = name
		} else if (code != '') {
			row.label = code
		} else {
			row.label = '' + row.id
		}
		rows.push(row)
	}
	return rows
}

export class DocLine {
	title: string = ''
	detail: string = ''
}

export class SubmitLine {
	lineNo: number = 1
	itemId: number = 0
	itemCode: string = ''
	itemName: string = ''
	requirement: string = ''
	remark: string = ''
	executed: boolean = false
	label: string = ''
}

export function readPreviewLines(payload: UTSJSONObject | null): SubmitLine[] {
	const rows: SubmitLine[] = []
	if (payload == null) {
		return rows
	}
	const raw = payload.getArray<UTSJSONObject>('lines')
	if (raw == null) {
		return rows
	}
	for (let i = 0; i < raw.length; i++) {
		const item = raw[i]
		const line = new SubmitLine()
		const lineNo = fieldNumber(item, 'line_no')
		line.lineNo = lineNo > 0 ? lineNo : (i + 1)
		line.itemId = fieldNumber(item, 'item_id')
		line.itemCode = fieldText(item, 'item_code')
		line.itemName = fieldText(item, 'item_name')
		line.requirement = fieldText(item, 'requirement')
		line.remark = fieldText(item, 'remark')
		line.executed = false
		if (line.itemName != '') {
			line.label = line.itemName
		} else if (line.itemCode != '') {
			line.label = line.itemCode
		} else {
			line.label = '明细 ' + line.lineNo
		}
		rows.push(line)
	}
	return rows
}

export function toPcLines(lines: SubmitLine[]): UTSJSONObject[] {
	const rows: UTSJSONObject[] = []
	for (let i = 0; i < lines.length; i++) {
		const line = lines[i]
		const row = new UTSJSONObject()
		row.set('line_no', line.lineNo)
		if (line.itemId > 0) {
			row.set('item_id', line.itemId)
		}
		if (line.itemCode != '') {
			row.set('item_code', line.itemCode)
		}
		if (line.itemName != '') {
			row.set('item_name', line.itemName)
		}
		if (line.requirement != '') {
			row.set('requirement', line.requirement)
		}
		row.set('executed', line.executed)
		if (line.remark != '') {
			row.set('remark', line.remark)
		}
		rows.push(row)
	}
	return rows
}

export function joinParts(parts: string[]): string {
	let text = ''
	for (let i = 0; i < parts.length; i++) {
		const part = parts[i]
		if (part == '') {
			continue
		}
		if (text != '') {
			text = text + ' · '
		}
		text = text + part
	}
	return text
}
