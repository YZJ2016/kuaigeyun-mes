<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<text class="section">模具</text>
		<sheet-picker title="模具" :options="moldSheetOptions" :selected-id="moldId" :selection-text="chosenMold" :loading="loading" :disabled="loading || submitting" :error="hint" @search="onMoldSearch" @choose="chooseMold" />
		<date-field label="领用日期" v-model="borrowDate" :disabled="loading || submitting" />
		<text class="label">领用人</text>
		<input class="field" v-model="borrowerName" :disabled="loading || submitting" placeholder="领用人" />
		<text class="label">部门</text>
		<input class="field" v-model="departmentName" :disabled="loading || submitting" placeholder="部门" />
		<date-field label="预计归还日期" v-model="expectedReturnDate" :disabled="loading || submitting" />
		<text class="label">备注</text>
		<input class="field" v-model="remark" :disabled="loading || submitting" placeholder="备注" />
		<action-button label="创建领用" tone="primary" :busy="submitting" :disabled="loading" @press="createBorrow" />
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<text class="section">领用记录</text>
		<text class="label">领用单搜索</text>
		<input class="field" v-model="listKeyword" :disabled="loading || submitting" placeholder="搜索领用单" />
		<action-button label="刷新" tone="secondary" :disabled="loading || submitting" @press="loadList" />
		<view v-for="(item, index) in rows" :key="index" class="list-row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<empty-state v-if="!loading && rows.length == 0 && hint == ''" title="暂无领用" :compact="true" />
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import DateField from '../../../shared/ui/date-field.uvue'
	import SheetPicker from '../../../shared/ui/sheet-picker.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import {
		DocLine,
		MOLD_ARCHIVE,
		MOLD_BORROWS,
		NamedOption,
		apiGetRows,
		apiPost,
		isDateText,
		joinParts,
		mapNamedOptions,
		putText,
		toSheetOptions,
		todayDate,
		withQuery
	} from '../http.uts'
	import { errorText, fieldText } from '../../../shared/api/fields.uts'
	import { SheetOption } from '../../../shared/ui/sheet-option.uts'
	import EmptyState from '../../../shared/ui/empty-state.uvue'

	const moldKeyword = ref('')
	const moldOptions = ref<NamedOption[]>([])
	const moldSheetOptions = computed((): SheetOption[] => toSheetOptions(moldOptions.value))
	const moldId = ref(0)
	const chosenMold = ref('')
	const borrowDate = ref('')
	const borrowerName = ref('')
	const departmentName = ref('')
	const expectedReturnDate = ref('')
	const remark = ref('')
	const listKeyword = ref('')
	const rows = ref<DocLine[]>([])
	const hint = ref('')
	const submitting = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	let moldTicket = 0
	let listOpen = false
	let moldOpen = false

	function syncLoading(): void {
		loading.value = listOpen || moldOpen
		if (!loading.value) { loadSettled.value = true }
	}

	function onMoldSearch(keyword: string): void {
		moldKeyword.value = keyword
		searchMolds()
	}

	function chooseMold(index: number): void {
		if (loading.value || submitting.value) { return }
		const options = moldOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		const row = options[index]
		moldId.value = row.id
		chosenMold.value = row.label
	}

	async function searchMolds(): Promise<void> {
		const mine = moldTicket + 1
		moldTicket = mine
		moldOpen = true
		syncLoading()
		hint.value = ''
		try {
			let query = 'limit=50'
			const keyword = moldKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const options = mapNamedOptions(await apiGetRows(withQuery(MOLD_ARCHIVE, query)))
			if (moldTicket != mine) {
				return
			}
			moldOptions.value = options
		} catch (err) {
			if (moldTicket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (moldTicket != mine) {
			return
		}
		moldOpen = false
		syncLoading()
	}

	function mapBorrow(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		const no = fieldText(item, 'document_no')
		const code = fieldText(item, 'mold_code')
		const name = fieldText(item, 'mold_name')
		line.title = no != '' ? no : code + ' ' + name
		line.detail = joinParts([
			code + ' ' + name,
			fieldText(item, 'borrower_name'),
			fieldText(item, 'borrow_date'),
			fieldText(item, 'status')
		])
		return line
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		listOpen = true
		syncLoading()
		try {
			let query = 'limit=50'
			const keyword = listKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const items = await apiGetRows(withQuery(MOLD_BORROWS, query))
			if (ticket != mine) {
				return
			}
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapBorrow(items[i]))
			}
			rows.value = lines
		} catch (err) {
			if (ticket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		listOpen = false
		syncLoading()
	}

	async function createBorrow(): Promise<void> {
		if (loading.value || submitting.value) { return }
		hint.value = ''
		if (moldId.value <= 0) {
			hint.value = '请选择模具'
			return
		}
		const dateText = borrowDate.value.trim()
		if (dateText != '' && !isDateText(dateText)) {
			hint.value = '领用日期格式为 YYYY-MM-DD'
			return
		}
		const expected = expectedReturnDate.value.trim()
		if (expected != '' && !isDateText(expected)) {
			hint.value = '预计归还日期格式为 YYYY-MM-DD'
			return
		}
		const body = new UTSJSONObject()
		body.set('mold_id', moldId.value)
		putText(body, 'borrow_date', dateText)
		putText(body, 'borrower_name', borrowerName.value)
		putText(body, 'department_name', departmentName.value)
		putText(body, 'expected_return_date', expected)
		putText(body, 'remark', remark.value)
		submitting.value = true
		try {
			const created = await apiPost(MOLD_BORROWS, body)
			const no = fieldText(created, 'document_no')
			hint.value = no == '' ? '已创建' : '已创建 ' + no
			await loadList()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			submitting.value = false
		}
	}

	onShow(() => {
		if (borrowDate.value == '') {
			borrowDate.value = todayDate()
		}
		searchMolds()
		loadList()
	})
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
