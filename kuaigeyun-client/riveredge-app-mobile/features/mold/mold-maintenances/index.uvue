<template>
	<view class="page">
		<text class="section">模具</text>
		<input class="field" v-model="moldKeyword" placeholder="编码或名称" />
		<button class="btn-secondary" @click="searchMolds">查找模具</button>
		<view v-for="(item, index) in moldOptions" :key="index" class="list-row" hover-class="pressed" @click="chooseMold(index)">
			<text class="title">{{ item.label }}</text>
		</view>
		<text v-if="chosenMold != ''" class="meta">已选 {{ chosenMold }}</text>
		<text class="section">保养方案（不选则用模具默认方案）</text>
		<view v-for="(item, index) in schemeOptions" :key="index" class="list-row" hover-class="pressed" @click="chooseScheme(index)">
			<text class="title">{{ item.label }}</text>
		</view>
		<text v-if="chosenScheme != ''" class="meta">已选方案 {{ chosenScheme }}</text>
		<input class="field" v-model="maintenanceDate" placeholder="保养日期 YYYY-MM-DD" />
		<input class="field" v-model="remark" placeholder="备注" />
		<text class="section">方案明细</text>
		<view v-for="(item, index) in previewLines" :key="index" class="list-row" hover-class="pressed" @click="toggleExecuted(index)">
			<text class="title">{{ item.label }}</text>
			<text class="meta">{{ item.executed ? '已执行' : '未执行' }}</text>
		</view>
		<text v-if="previewLines.length == 0" class="empty">无明细</text>
		<button :class="submitting ? 'btn-primary is-disabled' : 'btn-primary'" :disabled="submitting" @click="createMaintenance">创建保养</button>
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<text class="section">保养记录</text>
		<input class="field" v-model="listKeyword" placeholder="搜索保养单" />
		<button class="btn-secondary" @click="loadList">刷新</button>
		<view v-for="(item, index) in rows" :key="index" class="list-row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<text v-if="rows.length == 0" class="empty">暂无保养</text>
	</view>
</template>

<script setup lang="uts">
	import {
		DocLine,
		MOLD_ARCHIVE,
		MOLD_MAINTENANCES,
		MOLD_MAINTENANCE_SCHEMES,
		NamedOption,
		SubmitLine,
		apiGet,
		apiGetRows,
		apiPost,
		isDateText,
		joinParts,
		mapNamedOptions,
		putText,
		readPreviewLines,
		todayDate,
		toPcLines,
		withQuery
	} from '../http.uts'
	import { errorText, fieldText } from '../../../shared/api/fields.uts'

	const moldKeyword = ref('')
	const moldOptions = ref<NamedOption[]>([])
	const schemeOptions = ref<NamedOption[]>([])
	const moldId = ref(0)
	const schemeId = ref(0)
	const chosenMold = ref('')
	const chosenScheme = ref('')
	const maintenanceDate = ref('')
	const remark = ref('')
	const previewLines = ref<SubmitLine[]>([])
	const listKeyword = ref('')
	const rows = ref<DocLine[]>([])
	const hint = ref('')
	const submitting = ref(false)

	function chooseMold(index: number): void {
		const options = moldOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		moldId.value = options[index].id
		chosenMold.value = options[index].label
		loadPreview()
	}

	function chooseScheme(index: number): void {
		const options = schemeOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		schemeId.value = options[index].id
		chosenScheme.value = options[index].label
		loadPreview()
	}

	async function searchMolds(): Promise<void> {
		try {
			let query = 'limit=50'
			const keyword = moldKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			moldOptions.value = mapNamedOptions(await apiGetRows(withQuery(MOLD_ARCHIVE, query)))
		} catch (err) {
			hint.value = errorText(err)
		}
	}

	async function loadSchemes(): Promise<void> {
		try {
			schemeOptions.value = mapNamedOptions(await apiGetRows(withQuery(MOLD_MAINTENANCE_SCHEMES, 'limit=50&is_active=true')))
		} catch (err) {
			schemeOptions.value = []
		}
	}

	function mapDoc(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		const no = fieldText(item, 'document_no')
		line.title = no != '' ? no : fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name')
		line.detail = joinParts([
			fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name'),
			fieldText(item, 'maintenance_date'),
			fieldText(item, 'status')
		])
		return line
	}

	async function loadList(): Promise<void> {
		try {
			let query = 'limit=50'
			const keyword = listKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const items = await apiGetRows(withQuery(MOLD_MAINTENANCES, query))
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapDoc(items[i]))
			}
			rows.value = lines
		} catch (err) {
			hint.value = errorText(err)
		}
	}

	async function loadPreview(): Promise<void> {
		if (moldId.value <= 0) {
			previewLines.value = []
			return
		}
		let query = 'mold_id=' + moldId.value
		if (schemeId.value > 0) {
			query = query + '&scheme_id=' + schemeId.value
		}
		try {
			previewLines.value = readPreviewLines(await apiGet(withQuery(MOLD_MAINTENANCES + '/preview-lines', query)))
		} catch (err) {
			previewLines.value = []
			hint.value = errorText(err)
		}
	}

	function toggleExecuted(index: number): void {
		const current = previewLines.value
		if (index < 0 || index >= current.length) {
			return
		}
		const next: SubmitLine[] = []
		for (let i = 0; i < current.length; i++) {
			const line = current[i]
			if (i == index) {
				line.executed = !line.executed
			}
			next.push(line)
		}
		previewLines.value = next
	}

	async function createMaintenance(): Promise<void> {
		hint.value = ''
		if (moldId.value <= 0) {
			hint.value = '请选择模具'
			return
		}
		const dateText = maintenanceDate.value.trim()
		if (dateText != '' && !isDateText(dateText)) {
			hint.value = '保养日期格式为 YYYY-MM-DD'
			return
		}
		const body = new UTSJSONObject()
		body.set('mold_id', moldId.value)
		if (schemeId.value > 0) {
			body.set('scheme_id', schemeId.value)
		}
		putText(body, 'maintenance_date', dateText)
		putText(body, 'remark', remark.value)
		body.set('lines', toPcLines(previewLines.value))
		submitting.value = true
		try {
			const created = await apiPost(MOLD_MAINTENANCES, body)
			const no = fieldText(created, 'document_no')
			hint.value = no == '' ? '已创建' : '已创建 ' + no
			await loadList()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			submitting.value = false
		}
	}

	onShow(() => {
		if (maintenanceDate.value == '') {
			maintenanceDate.value = todayDate()
		}
		searchMolds()
		loadSchemes()
		loadList()
	})
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
