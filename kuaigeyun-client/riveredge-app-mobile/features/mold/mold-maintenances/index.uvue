<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<text class="section">模具</text>
		<text class="label">模具编码或名称</text>
		<input class="field" v-model="moldKeyword" :disabled="loading || submitting" placeholder="编码或名称" />
		<action-button label="查找模具" :disabled="loading || submitting" @press="searchMolds" />
		<selection-row v-for="(item, index) in moldOptions" :key="item.id" :label="item.label" :selected="item.id == moldId" :disabled="loading || submitting" @choose="chooseMold(index)" />
		<text v-if="chosenMold != ''" class="meta">已选 {{ chosenMold }}</text>
		<text class="section">保养方案（不选则用模具默认方案）</text>
		<selection-row v-for="(item, index) in schemeOptions" :key="item.id" :label="item.label" :selected="item.id == schemeId" :disabled="loading || submitting" @choose="chooseScheme(index)" />
		<text v-if="chosenScheme != ''" class="meta">已选方案 {{ chosenScheme }}</text>
		<date-field v-model="maintenanceDate" label="保养日期" :disabled="loading || submitting" />
		<text class="label">备注（可选）</text>
		<input class="field" v-model="remark" :disabled="loading || submitting" placeholder="备注" />
		<text class="section">方案明细</text>
		<selection-row v-for="(item, index) in previewLines" :key="index" :label="item.label" :selected="item.executed" selected-label="已执行" unselected-label="未执行" :disabled="loading || submitting" @choose="toggleExecuted(index)" />
		<text v-if="!loading && previewLines.length == 0" class="empty">无明细</text>
		<action-button label="创建保养" tone="primary" :busy="submitting" :disabled="loading" @press="createMaintenance" />
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<text class="section">保养记录</text>
		<text class="label">记录关键词</text>
		<input class="field" v-model="listKeyword" :disabled="loading || submitting" placeholder="搜索保养单" />
		<action-button label="查询记录" :disabled="loading || submitting" @press="loadList" />
		<view v-for="(item, index) in rows" :key="index" class="list-row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<text v-if="!loading && rows.length == 0 && hint == ''" class="empty">暂无保养</text>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import SelectionRow from '../../../shared/ui/selection-row.uvue'
	import DateField from '../../../shared/ui/date-field.uvue'
	import {
		DocLine,
		MOLD_ARCHIVE,
		MOLD_MAINTENANCES,
		MOLD_MAINTENANCE_SCHEMES,
		NamedOption,
		SubmitLine,
		apiGet,
		apiGetRows,
		apiPost,
		isDateText,
		joinParts,
		mapNamedOptions,
		putText,
		readPreviewLines,
		todayDate,
		toPcLines,
		withQuery
	} from '../http.uts'
	import { errorText, fieldText } from '../../../shared/api/fields.uts'

	const moldKeyword = ref('')
	const moldOptions = ref<NamedOption[]>([])
	const schemeOptions = ref<NamedOption[]>([])
	const moldId = ref(0)
	const schemeId = ref(0)
	const chosenMold = ref('')
	const chosenScheme = ref('')
	const maintenanceDate = ref('')
	const remark = ref('')
	const previewLines = ref<SubmitLine[]>([])
	const listKeyword = ref('')
	const rows = ref<DocLine[]>([])
	const hint = ref('')
	const submitting = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	let moldTicket = 0
	let schemeTicket = 0
	let previewTicket = 0
	let listOpen = false
	let moldOpen = false
	let schemeOpen = false
	let previewOpen = false

	function syncLoading(): void {
		loading.value = listOpen || moldOpen || schemeOpen || previewOpen
		if (!loading.value) { loadSettled.value = true }
	}

	function chooseMold(index: number): void {
		if (loading.value || submitting.value) { return }
		const options = moldOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		moldId.value = options[index].id
		chosenMold.value = options[index].label
		loadPreview()
	}

	function chooseScheme(index: number): void {
		if (loading.value || submitting.value) { return }
		const options = schemeOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		schemeId.value = options[index].id
		chosenScheme.value = options[index].label
		loadPreview()
	}

	async function searchMolds(): Promise<void> {
		const mine = moldTicket + 1
		moldTicket = mine
		moldOpen = true
		syncLoading()
		try {
			let query = 'limit=50'
			const keyword = moldKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const options = mapNamedOptions(await apiGetRows(withQuery(MOLD_ARCHIVE, query)))
			if (moldTicket != mine) {
				return
			}
			moldOptions.value = options
		} catch (err) {
			if (moldTicket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (moldTicket != mine) {
			return
		}
		moldOpen = false
		syncLoading()
	}

	async function loadSchemes(): Promise<void> {
		const mine = schemeTicket + 1
		schemeTicket = mine
		schemeOpen = true
		syncLoading()
		try {
			const options = mapNamedOptions(await apiGetRows(withQuery(MOLD_MAINTENANCE_SCHEMES, 'limit=50&is_active=true')))
			if (schemeTicket != mine) {
				return
			}
			schemeOptions.value = options
		} catch (err) {
			if (schemeTicket != mine) {
				return
			}
			schemeOptions.value = []
		}
		if (schemeTicket != mine) {
			return
		}
		schemeOpen = false
		syncLoading()
	}

	function mapDoc(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		const no = fieldText(item, 'document_no')
		line.title = no != '' ? no : fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name')
		line.detail = joinParts([
			fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name'),
			fieldText(item, 'maintenance_date'),
			fieldText(item, 'status')
		])
		return line
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		listOpen = true
		syncLoading()
		try {
			let query = 'limit=50'
			const keyword = listKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const items = await apiGetRows(withQuery(MOLD_MAINTENANCES, query))
			if (ticket != mine) {
				return
			}
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapDoc(items[i]))
			}
			rows.value = lines
		} catch (err) {
			if (ticket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		listOpen = false
		syncLoading()
	}

	async function loadPreview(): Promise<void> {
		if (moldId.value <= 0) {
			previewLines.value = []
			return
		}
		const mine = previewTicket + 1
		previewTicket = mine
		previewOpen = true
		syncLoading()
		let query = 'mold_id=' + moldId.value
		if (schemeId.value > 0) {
			query = query + '&scheme_id=' + schemeId.value
		}
		try {
			const lines = readPreviewLines(await apiGet(withQuery(MOLD_MAINTENANCES + '/preview-lines', query)))
			if (previewTicket != mine) {
				return
			}
			previewLines.value = lines
		} catch (err) {
			if (previewTicket != mine) {
				return
			}
			previewLines.value = []
			hint.value = errorText(err)
		}
		if (previewTicket != mine) {
			return
		}
		previewOpen = false
		syncLoading()
	}

	function toggleExecuted(index: number): void {
		if (loading.value || submitting.value) { return }
		const current = previewLines.value
		if (index < 0 || index >= current.length) {
			return
		}
		const next: SubmitLine[] = []
		for (let i = 0; i < current.length; i++) {
			const line = current[i]
			if (i == index) {
				line.executed = !line.executed
			}
			next.push(line)
		}
		previewLines.value = next
	}

	async function createMaintenance(): Promise<void> {
		if (loading.value || submitting.value) { return }
		hint.value = ''
		if (moldId.value <= 0) {
			hint.value = '请选择模具'
			return
		}
		const dateText = maintenanceDate.value.trim()
		if (dateText != '' && !isDateText(dateText)) {
			hint.value = '保养日期格式为 YYYY-MM-DD'
			return
		}
		const body = new UTSJSONObject()
		body.set('mold_id', moldId.value)
		if (schemeId.value > 0) {
			body.set('scheme_id', schemeId.value)
		}
		putText(body, 'maintenance_date', dateText)
		putText(body, 'remark', remark.value)
		body.set('lines', toPcLines(previewLines.value))
		submitting.value = true
		try {
			const created = await apiPost(MOLD_MAINTENANCES, body)
			const no = fieldText(created, 'document_no')
			hint.value = no == '' ? '已创建' : '已创建 ' + no
			await loadList()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			submitting.value = false
		}
	}

	onShow(() => {
		if (maintenanceDate.value == '') {
			maintenanceDate.value = todayDate()
		}
		searchMolds()
		loadSchemes()
		loadList()
	})
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
