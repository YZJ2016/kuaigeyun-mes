<template>
	<view class="page">
		<home-link />
		<button class="btn-secondary" @click="loadList">刷新</button>
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<view v-for="(item, index) in rows" :key="index" class="list-row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<text v-if="rows.length == 0 && hint == ''" class="empty">暂无保养提醒</text>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { DocLine, MOLD_REMINDERS, apiGetRows, joinParts, withQuery } from '../http.uts'
	import { errorText, fieldText } from '../../../shared/api/fields.uts'

	const rows = ref<DocLine[]>([])
	const hint = ref('')

	function reminderLabel(value: string): string {
		if (value == 'due_soon') {
			return '即将到期'
		}
		if (value == 'overdue') {
			return '已逾期'
		}
		return value
	}

	function triggerLabel(value: string): string {
		if (value == 'days') {
			return '按天'
		}
		if (value == 'usage_count') {
			return '按次数'
		}
		return value
	}

	function mapReminder(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		line.title = fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name')
		const parts: string[] = [
			reminderLabel(fieldText(item, 'reminder_type')),
			triggerLabel(fieldText(item, 'trigger_type'))
		]
		const until = item.getNumber('usages_until_due')
		if (until != null) {
			parts.push('剩余次数 ' + until)
		}
		const days = item.getNumber('days_since_maintenance')
		if (days != null) {
			parts.push('距上次保养 ' + days + ' 天')
		}
		const last = fieldText(item, 'last_maintenance_date')
		if (last != '') {
			parts.push('上次保养 ' + last)
		}
		line.detail = joinParts(parts)
		return line
	}

	async function loadList(): Promise<void> {
		hint.value = ''
		try {
			const items = await apiGetRows(withQuery(MOLD_REMINDERS, 'limit=50'))
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapReminder(items[i]))
			}
			rows.value = lines
		} catch (err) {
			hint.value = errorText(err)
		}
	}

	onShow(() => {
		loadList()
	})
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
