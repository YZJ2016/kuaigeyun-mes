<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<text class="section">未归还领用</text>
		<selection-row v-for="(item, index) in borrowOptions" :key="item.id" :label="item.label" :selected="item.id == borrowId" :disabled="loading || submitting" @choose="chooseBorrow(index)" />
		<text v-if="!loading && borrowOptions.length == 0 && hint == ''" class="empty">没有未归还的领用</text>
		<text v-if="chosenBorrow != ''" class="meta">已选 {{ chosenBorrow }}</text>
		<date-field v-model="returnDate" label="归还日期" :disabled="loading || submitting" />
		<text class="label">使用次数</text>
		<input class="field" v-model="usageCount" :disabled="loading || submitting" type="number" placeholder="使用次数" />
		<text class="label">备注（可选）</text>
		<input class="field" v-model="remark" :disabled="loading || submitting" placeholder="备注" />
		<action-button label="创建归还" tone="primary" :busy="submitting" :disabled="loading" @press="createReturn" />
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<text class="section">归还记录</text>
		<text class="label">记录关键词</text>
		<input class="field" v-model="listKeyword" :disabled="loading || submitting" placeholder="搜索归还单" />
		<action-button label="查询记录" :disabled="loading || submitting" @press="loadList" />
		<view v-for="(item, index) in rows" :key="index" class="list-row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<text v-if="!loading && rows.length == 0 && hint == ''" class="empty">暂无归还</text>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import SelectionRow from '../../../shared/ui/selection-row.uvue'
	import DateField from '../../../shared/ui/date-field.uvue'
	import {
		DocLine,
		MOLD_BORROWS_OUTSTANDING,
		MOLD_RETURNS,
		MOLD_RETURN_USAGE_PREVIEW,
		apiGet,
		apiGetRows,
		apiPost,
		isDateText,
		joinParts,
		putText,
		todayDate,
		withQuery
	} from '../http.uts'
	import { errorText, fieldNumber, fieldText } from '../../../shared/api/fields.uts'

	class BorrowPick {
		id: number = 0
		moldId: number = 0
		label: string = ''
	}

	const borrowOptions = ref<BorrowPick[]>([])
	const borrowId = ref(0)
	const moldId = ref(0)
	const chosenBorrow = ref('')
	const returnDate = ref('')
	const usageCount = ref('1')
	const remark = ref('')
	const listKeyword = ref('')
	const rows = ref<DocLine[]>([])
	const hint = ref('')
	const submitting = ref(false)
	const loading = ref(false)
	const loadSettled = ref(false)
	let ticket = 0
	let borrowTicket = 0
	let listOpen = false
	let borrowOpen = false

	function syncLoading(): void {
		loading.value = listOpen || borrowOpen
		if (!loading.value) { loadSettled.value = true }
	}

	function parseCount(raw: string): number {
		const text = raw.trim()
		if (text == '') {
			return 1
		}
		// 使用次数是整数：全串必须为数字，'1.9'、'-1' 等判无效而不是静默截断
		for (let i = 0; i < text.length; i++) {
			const ch = text.charAt(i)
			if (ch < '0' || ch > '9') {
				return 0
			}
		}
		const value = parseInt(text)
		if (isNaN(value) || value < 1) {
			return 0
		}
		return value
	}

	async function chooseBorrow(index: number): Promise<void> {
		if (loading.value || submitting.value) { return }
		const options = borrowOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		const row = options[index]
		borrowId.value = row.id
		moldId.value = row.moldId
		chosenBorrow.value = row.label
		hint.value = ''
		try {
			const preview = await apiGet(withQuery(MOLD_RETURN_USAGE_PREVIEW, 'borrow_id=' + row.id))
			if (preview != null) {
				const count = preview.getNumber('usage_count')
				if (count != null && count >= 1) {
					usageCount.value = '' + count
				}
				const previewMold = preview.getNumber('mold_id')
				if (previewMold != null && previewMold > 0) {
					moldId.value = previewMold
				}
			}
		} catch (err) {
			hint.value = errorText(err)
		}
	}

	async function loadOutstanding(): Promise<void> {
		const mine = borrowTicket + 1
		borrowTicket = mine
		borrowOpen = true
		syncLoading()
		try {
			const items = await apiGetRows(withQuery(MOLD_BORROWS_OUTSTANDING, 'limit=50'))
			if (borrowTicket != mine) {
				return
			}
			const options: BorrowPick[] = []
			for (let i = 0; i < items.length; i++) {
				const item = items[i]
				const row = new BorrowPick()
				row.id = fieldNumber(item, 'id')
				row.moldId = fieldNumber(item, 'mold_id')
				const no = fieldText(item, 'document_no')
				const name = fieldText(item, 'mold_name')
				row.label = no != '' ? no + ' - ' + name : name
				options.push(row)
			}
			borrowOptions.value = options
		} catch (err) {
			if (borrowTicket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (borrowTicket != mine) {
			return
		}
		borrowOpen = false
		syncLoading()
	}

	function mapReturn(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		const no = fieldText(item, 'document_no')
		line.title = no != '' ? no : fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name')
		line.detail = joinParts([
			fieldText(item, 'mold_code') + ' ' + fieldText(item, 'mold_name'),
			fieldText(item, 'return_date'),
			'使用 ' + fieldNumber(item, 'usage_count'),
			fieldText(item, 'status')
		])
		return line
	}

	async function loadList(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		listOpen = true
		syncLoading()
		try {
			let query = 'limit=50'
			const keyword = listKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const items = await apiGetRows(withQuery(MOLD_RETURNS, query))
			if (ticket != mine) {
				return
			}
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapReturn(items[i]))
			}
			rows.value = lines
		} catch (err) {
			if (ticket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		listOpen = false
		syncLoading()
	}

	async function createReturn(): Promise<void> {
		if (loading.value || submitting.value) { return }
		hint.value = ''
		if (borrowId.value <= 0 || moldId.value <= 0) {
			hint.value = '请选择领用单'
			return
		}
		const dateText = returnDate.value.trim()
		if (dateText != '' && !isDateText(dateText)) {
			hint.value = '归还日期格式为 YYYY-MM-DD'
			return
		}
		const count = parseCount(usageCount.value)
		if (count < 1) {
			hint.value = '使用次数至少为 1'
			return
		}
		const body = new UTSJSONObject()
		body.set('mold_id', moldId.value)
		body.set('borrow_id', borrowId.value)
		body.set('usage_count', count)
		putText(body, 'return_date', dateText)
		putText(body, 'remark', remark.value)
		submitting.value = true
		try {
			const created = await apiPost(MOLD_RETURNS, body)
			const no = fieldText(created, 'document_no')
			hint.value = no == '' ? '已创建' : '已创建 ' + no
			await loadOutstanding()
			await loadList()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			submitting.value = false
		}
	}

	onShow(() => {
		if (returnDate.value == '') {
			returnDate.value = todayDate()
		}
		loadOutstanding()
		loadList()
	})
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
