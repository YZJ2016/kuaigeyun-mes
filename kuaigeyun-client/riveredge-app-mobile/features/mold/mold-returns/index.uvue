<template>
	<view class="page">
		<text class="section">未归还领用</text>
		<view v-for="(item, index) in borrowOptions" :key="index" class="row" @click="chooseBorrow(index)">
			<text class="title">{{ item.label }}</text>
		</view>
		<text v-if="borrowOptions.length == 0" class="meta">没有未归还的领用</text>
		<text v-if="chosenBorrow != ''" class="meta">已选 {{ chosenBorrow }}</text>
		<input class="field" v-model="returnDate" placeholder="归还日期 YYYY-MM-DD" />
		<input class="field" v-model="usageCount" placeholder="使用次数" />
		<input class="field" v-model="remark" placeholder="备注" />
		<button type="primary" :disabled="submitting" @click="createReturn">创建归还</button>
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<text class="section">归还记录</text>
		<input class="field" v-model="listKeyword" placeholder="搜索归还单" />
		<button size="mini" @click="loadList">刷新</button>
		<view v-for="(item, index) in rows" :key="index" class="row">
			<text class="title">{{ item.title }}</text>
			<text class="meta">{{ item.detail }}</text>
		</view>
		<text v-if="rows.length == 0" class="meta">暂无归还</text>
	</view>
</template>

<script setup lang="uts">
	import {
		DocLine,
		MOLD_BORROWS_OUTSTANDING,
		MOLD_RETURNS,
		MOLD_RETURN_USAGE_PREVIEW,
		apiGet,
		apiPost,
		isDateText,
		joinParts,
		numberOf,
		putText,
		readError,
		readItems,
		textOf,
		todayDate,
		withQuery
	} from '../http.uts'

	class BorrowPick {
		id: number = 0
		moldId: number = 0
		label: string = ''
	}

	const borrowOptions = ref<BorrowPick[]>([])
	const borrowId = ref(0)
	const moldId = ref(0)
	const chosenBorrow = ref('')
	const returnDate = ref('')
	const usageCount = ref('1')
	const remark = ref('')
	const listKeyword = ref('')
	const rows = ref<DocLine[]>([])
	const hint = ref('')
	const submitting = ref(false)

	function parseCount(raw: string): number {
		const text = raw.trim()
		if (text == '') {
			return 1
		}
		const value = parseInt(text)
		if (isNaN(value) || value < 1) {
			return 0
		}
		return value
	}

	async function chooseBorrow(index: number): Promise<void> {
		const options = borrowOptions.value
		if (index < 0 || index >= options.length) {
			return
		}
		const row = options[index]
		borrowId.value = row.id
		moldId.value = row.moldId
		chosenBorrow.value = row.label
		hint.value = ''
		try {
			const preview = await apiGet(withQuery(MOLD_RETURN_USAGE_PREVIEW, 'borrow_id=' + row.id))
			const count = preview.getNumber('usage_count')
			if (count != null && count >= 1) {
				usageCount.value = '' + count
			}
			const previewMold = preview.getNumber('mold_id')
			if (previewMold != null && previewMold > 0) {
				moldId.value = previewMold
			}
		} catch (err) {
			hint.value = readError(err)
		}
	}

	async function loadOutstanding(): Promise<void> {
		try {
			const payload = await apiGet(withQuery(MOLD_BORROWS_OUTSTANDING, 'limit=50'))
			const items = readItems(payload)
			const options: BorrowPick[] = []
			for (let i = 0; i < items.length; i++) {
				const item = items[i]
				const row = new BorrowPick()
				row.id = numberOf(item, 'id')
				row.moldId = numberOf(item, 'mold_id')
				const no = textOf(item, 'document_no')
				const name = textOf(item, 'mold_name')
				row.label = no != '' ? no + ' - ' + name : name
				options.push(row)
			}
			borrowOptions.value = options
		} catch (err) {
			hint.value = readError(err)
		}
	}

	function mapReturn(item: UTSJSONObject): DocLine {
		const line = new DocLine()
		const no = textOf(item, 'document_no')
		line.title = no != '' ? no : textOf(item, 'mold_code') + ' ' + textOf(item, 'mold_name')
		line.detail = joinParts([
			textOf(item, 'mold_code') + ' ' + textOf(item, 'mold_name'),
			textOf(item, 'return_date'),
			'使用 ' + numberOf(item, 'usage_count'),
			textOf(item, 'status')
		])
		return line
	}

	async function loadList(): Promise<void> {
		try {
			let query = 'limit=50'
			const keyword = listKeyword.value.trim()
			if (keyword != '') {
				query = 'keyword=' + encodeURIComponent(keyword) + '&limit=50'
			}
			const payload = await apiGet(withQuery(MOLD_RETURNS, query))
			const items = readItems(payload)
			const lines: DocLine[] = []
			for (let i = 0; i < items.length; i++) {
				lines.push(mapReturn(items[i]))
			}
			rows.value = lines
		} catch (err) {
			hint.value = readError(err)
		}
	}

	async function createReturn(): Promise<void> {
		hint.value = ''
		if (borrowId.value <= 0 || moldId.value <= 0) {
			hint.value = '请选择领用单'
			return
		}
		const dateText = returnDate.value.trim()
		if (dateText != '' && !isDateText(dateText)) {
			hint.value = '归还日期格式为 YYYY-MM-DD'
			return
		}
		const count = parseCount(usageCount.value)
		if (count < 1) {
			hint.value = '使用次数至少为 1'
			return
		}
		const body = new UTSJSONObject()
		body.set('mold_id', moldId.value)
		body.set('borrow_id', borrowId.value)
		body.set('usage_count', count)
		putText(body, 'return_date', dateText)
		putText(body, 'remark', remark.value)
		submitting.value = true
		try {
			const created = await apiPost(MOLD_RETURNS, body)
			const no = textOf(created, 'document_no')
			hint.value = no == '' ? '已创建' : '已创建 ' + no
			await loadOutstanding()
			await loadList()
		} catch (err) {
			hint.value = readError(err)
		} finally {
			submitting.value = false
		}
	}

	onShow(() => {
		if (returnDate.value == '') {
			returnDate.value = todayDate()
		}
		loadOutstanding()
		loadList()
	})
</script>

<style>
	.page {
		padding: 16px;
	}

	.section {
		display: block;
		margin-top: 16px;
		margin-bottom: 8px;
		font-size: 14px;
		color: #888B9D;
	}

	.field {
		margin-top: 8px;
		padding: 8px;
		border: 1px solid #E7D9FD;
	}

	.row {
		padding: 10px 0;
		border-bottom: 1px solid #E7D9FD;
	}

	.title {
		font-size: 16px;
		color: #28113C;
	}

	.meta {
		display: block;
		margin-top: 4px;
		font-size: 13px;
		color: #888B9D;
	}

	.error {
		display: block;
		margin-top: 8px;
		font-size: 13px;
		color: #FF4942;
	}
</style>
