<template>
	<view class="page">
		<home-link />
		<button :class="loading ? 'btn-primary is-disabled' : 'btn-primary'" :disabled="loading" @click="onScan">扫码</button>
		<text v-if="scanned != ''" class="meta">扫到 {{ scanned }}</text>
		<text v-if="hint != ''" class="error">{{ hint }}</text>
		<view v-if="hasOpened" class="card">
			<text class="title">{{ openedTitle }}</text>
			<text class="meta">{{ openedDetail }}</text>
		</view>
		<view v-if="choices.length > 0">
			<text class="section">请选择模具</text>
			<view v-for="(item, index) in choices" :key="index" class="list-row" hover-class="pressed" @click="openAt(index)">
				<text class="title">{{ item.title }}</text>
				<text class="meta">{{ item.detail }}</text>
			</view>
		</view>
		<text v-if="!loading && scanned != '' && !hasOpened && choices.length == 0 && hint == ''" class="empty">未找到模具</text>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { scan } from '../../../shared/channel/index.uts'
	import { DocLine, MOLD_ARCHIVE, apiGetRows, withQuery } from '../http.uts'
	import { errorText, fieldNumber, fieldText } from '../../../shared/api/fields.uts'

	const loading = ref(false)
	const scanned = ref('')
	const hint = ref('')
	const hasOpened = ref(false)
	const openedTitle = ref('')
	const openedDetail = ref('')
	const choices = ref<DocLine[]>([])
	const choiceItems = ref<UTSJSONObject[]>([])

	function moldTitle(item: UTSJSONObject): string {
		const code = fieldText(item, 'code')
		const name = fieldText(item, 'name')
		if (code != '' && name != '') {
			return code + ' ' + name
		}
		if (name != '') {
			return name
		}
		return code
	}

	function moldDetail(item: UTSJSONObject): string {
		const parts: string[] = []
		const statusText = fieldText(item, 'status')
		if (statusText != '') {
			parts.push(statusText)
		}
		const typeText = fieldText(item, 'type')
		if (typeText != '') {
			parts.push(typeText)
		}
		const location = fieldText(item, 'storage_location')
		if (location != '') {
			parts.push(location)
		}
		parts.push('累计使用 ' + fieldNumber(item, 'total_usage_count'))
		const last = fieldText(item, 'last_maintenance_date')
		if (last != '') {
			parts.push('上次保养 ' + last)
		}
		let text = ''
		for (let i = 0; i < parts.length; i++) {
			if (text != '') {
				text = text + ' · '
			}
			text = text + parts[i]
		}
		return text
	}

	function showMold(item: UTSJSONObject): void {
		openedTitle.value = moldTitle(item)
		openedDetail.value = moldDetail(item)
		hasOpened.value = true
		choices.value = []
		choiceItems.value = []
	}

	function openAt(index: number): void {
		const items = choiceItems.value
		if (index < 0 || index >= items.length) {
			return
		}
		showMold(items[index])
	}

	function readScanCode(value: any | null): string {
		if (value == null) {
			return ''
		}
		if (typeof value == 'string') {
			return (value as string).trim()
		}
		return ''
	}

	function exactMatches(items: UTSJSONObject[], code: string): UTSJSONObject[] {
		const target = code.toLowerCase()
		const found: UTSJSONObject[] = []
		for (let i = 0; i < items.length; i++) {
			const item = items[i]
			if (fieldText(item, 'code').toLowerCase() == target) {
				found.push(item)
			}
		}
		return found
	}

	async function onScan(): Promise<void> {
		hint.value = ''
		hasOpened.value = false
		choices.value = []
		choiceItems.value = []
		loading.value = true
		try {
			const code = readScanCode(await scan())
			scanned.value = code
			if (code == '') {
				hint.value = '没有扫到内容'
				return
			}
			const items = await apiGetRows(withQuery(MOLD_ARCHIVE, 'keyword=' + encodeURIComponent(code) + '&limit=50'))
			const exact = exactMatches(items, code)
			if (exact.length == 1) {
				const hit = exact[0]
				if (hit != null) {
					showMold(hit)
					return
				}
			}
			if (exact.length == 0 && items.length == 1) {
				const hit = items[0]
				if (hit != null) {
					showMold(hit)
					return
				}
			}
			const source = exact.length > 0 ? exact : items
			const lines: DocLine[] = []
			const kept: UTSJSONObject[] = []
			for (let i = 0; i < source.length; i++) {
				const item = source[i]
				if (item == null) {
					continue
				}
				const line = new DocLine()
				line.title = moldTitle(item)
				line.detail = moldDetail(item)
				lines.push(line)
				kept.push(item)
			}
			choiceItems.value = kept
			choices.value = lines
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			loading.value = false
		}
	}
</script>

<style>
	.section {
		margin-top: 16px;
	}
</style>
