<template>
	<view class="page-shell">
		<home-link :hold-home="conducting" @home="leaveHome" />
	<scroll-view class="page" scroll-y="true" :scroll-into-view="scrollTarget">
		<view v-if="!conducting">
		<view class="toolbar">
			<button class="btn-secondary" @click="loadList">刷新</button>
		</view>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="empty">暂无检验单</text>
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ rowTitle(row) }}</text>
			<text v-if="rowLine(row).length > 0" class="meta">{{ rowLine(row) }}</text>
			<view class="btn-secondary" @click="openConduct(index)"><text class="btn-label-secondary">执行检验</text></view>
		</view>
		</view>
		<view v-if="conducting" class="card">
			<text class="title">执行检验 {{ currentTitle }}</text>
			<text class="meta">检验数量 {{ currentQty }}</text>
			<text class="hint">第 {{ activeStage + 1 }} / 3 段：{{ stageLabels[activeStage] }}</text>
			<text v-if="formError.length > 0" class="error">{{ formError }}</text>
			<view class="choices">
				<button v-for="(label, stageIndex) in stageLabels" :key="stageIndex" class="btn-secondary" :disabled="submitting || uploadingCount > 0" @click="goStage(stageIndex)">{{ activeStage == stageIndex ? '● ' : '' }}{{ label }}</button>
			</view>
			<view v-show="activeStage == 0">
			<view class="field-wrap">
				<text class="label">合格数量</text>
				<input class="field" type="digit" :value="qualifiedText" @input="onQualifiedInput" />
			</view>
			<view class="field-wrap">
				<text class="label">不合格数量</text>
				<input class="field" type="digit" :value="unqualifiedText" @input="onUnqualifiedInput" />
			</view>
			<view v-if="conductKind == 'oqc'" class="field-wrap">
				<text class="label">检验结果</text>
				<view class="choices">
					<text v-for="(label, index) in resultOptions" :key="index" :class="choiceClass(inspectionResult, label)" @click="pickResult(label)">{{ label }}</text>
				</view>
			</view>
			<view v-if="conductKind == 'oqc'" class="field-wrap">
				<text class="label">质量状态</text>
				<view class="choices">
					<text v-for="(label, index) in statusOptions" :key="index" :class="choiceClass(qualityStatus, label)" @click="pickStatus(label)">{{ label }}</text>
				</view>
			</view>
			<view v-if="conductKind == 'oqc'" class="field-wrap">
				<text class="label">放行结论</text>
				<view class="choices">
					<text v-for="(label, index) in releaseLabels" :key="index" :class="choiceClass(releaseDecision, releaseValues[index])" @click="pickRelease(index)">{{ label }}</text>
				</view>
			</view>
			<view v-if="conductKind == 'oqc'" class="field-wrap">
				<text class="label">放行说明</text>
				<input class="field" :value="releaseNote" @input="onReleaseNoteInput" />
			</view>
			<view class="field-wrap">
				<text class="label">备注</text>
				<input class="field" :value="notes" @input="onNotesInput" />
			</view>
			<view v-if="conductKind != 'oqc'" class="field-wrap">
				<text class="label">不合格原因</text>
				<input class="field" :value="nonconformanceReason" @input="onReasonInput" />
			</view>
			<view class="field-wrap">
				<text class="label">附件</text>
				<view class="link" @click="addAttachment"><text class="link-text">添加附件</text></view>
				<view v-for="(file, fileIndex) in attachments" :key="fileIndex" class="choices">
					<image v-if="fileUrl(file).length > 0" class="attachment-preview" :src="fileUrl(file)" mode="aspectFill" @click="previewFile(file)" />
					<text class="meta">{{ fileLabel(file) }}</text>
					<view class="link" @click="removeAttachment(fileIndex)"><text class="link-text">移除</text></view>
				</view>
			</view>
			</view>
			<view v-show="activeStage == 1">
			<view v-if="needsOverallJudgment" class="field-wrap">
				<text class="label">整体判定</text>
				<view class="choices">
					<text :class="choiceClass(overallJudgment, 'pass')" @click="pickOverall('pass')">合格</text>
					<text :class="choiceClass(overallJudgment, 'fail')" @click="pickOverall('fail')">不合格</text>
				</view>
			</view>
			<view v-for="(step, index) in steps" :key="step.key" :id="'quality-step-' + index" class="field-wrap">
				<text class="label">{{ step.name }}</text>
				<view v-if="step.legacy" class="choices">
					<text :class="choiceClass(step.judgment, 'pass')" @click="pickLegacy(index, 'pass')">合格</text>
					<text :class="choiceClass(step.judgment, 'fail')" @click="pickLegacy(index, 'fail')">不合格</text>
				</view>
				<view v-else-if="step.valueType == 'boolean'" class="choices">
					<text :class="choiceClass(step.value, 'true')" @click="pickBool(index, 'true')">是</text>
					<text :class="choiceClass(step.value, 'false')" @click="pickBool(index, 'false')">否</text>
				</view>
				<view v-else>
					<view v-if="step.allowNa && !step.textNeedsJudgment" class="choices">
						<text :class="choiceClass(step.judgment, 'na')" @click="toggleNa(index)">不适用</text>
					</view>
					<view v-if="step.judgment != 'na' && step.valueType == 'single_select'" class="choices">
						<text v-for="(opt, optIndex) in step.options" :key="optIndex" :class="choiceClass(step.value, opt.value)" @click="pickOption(index, optIndex)">{{ opt.label }}</text>
					</view>
					<view v-if="step.judgment != 'na' && step.valueType == 'multi_select'" class="choices">
						<text v-for="(opt, optIndex) in step.options" :key="optIndex" :class="multiChoiceClass(index, opt.value)" @click="toggleOption(index, optIndex)">{{ opt.label }}</text>
					</view>
					<input v-if="step.judgment != 'na' && step.valueType != 'single_select' && step.valueType != 'multi_select'" class="field" :value="step.value" @input="onStepInput(index, $event)" />
					<view v-if="step.textNeedsJudgment" class="choices">
						<text :class="choiceClass(step.judgment, 'pass')" @click="pickLegacy(index, 'pass')">合格</text>
						<text :class="choiceClass(step.judgment, 'fail')" @click="pickLegacy(index, 'fail')">不合格</text>
						<text v-if="step.allowNa" :class="choiceClass(step.judgment, 'na')" @click="pickLegacy(index, 'na')">不适用</text>
					</view>
				</view>
				<view v-if="stepShowsPhoto(index)" class="field-wrap">
					<text class="label">步骤照片</text>
					<view class="link" @click="addStepPhoto(index)"><text class="link-text">添加照片</text></view>
					<view v-for="(photo, photoIndex) in step.photos" :key="photoIndex" class="choices">
						<image v-if="fileUrl(photo).length > 0" class="attachment-preview" :src="fileUrl(photo)" mode="aspectFill" @click="previewFile(photo)" />
						<text class="meta">{{ fileLabel(photo) }}</text>
						<view class="link" @click="removeStepPhoto(index, photoIndex)"><text class="link-text">移除</text></view>
					</view>
				</view>
			</view>
			</view>
			<view v-show="activeStage == 2">
			<text class="meta">合格 {{ qualifiedText }} · 不合格 {{ unqualifiedText }} · 检验项 {{ steps.length }} 项</text>
			<text class="hint">核对检验结果与补充信息后提交</text>
			<view v-for="(field, index) in customFields" :key="field.code" class="field-wrap">
				<text class="label">{{ field.name }}</text>
				<input class="field" :value="field.value" @input="onCustomInput(index, $event)" />
			</view>
			</view>
			<button v-if="activeStage > 0" class="btn-secondary" :disabled="submitting || uploadingCount > 0" @click="goStage(activeStage - 1)">上一段</button>
			<button v-if="activeStage < 2" class="btn-primary" :disabled="submitting || uploadingCount > 0" @click="goStage(activeStage + 1)">下一段</button>
			<text v-if="uploadingCount > 0" class="loading">图片上传中</text>

			<view v-if="activeStage == 2" :class="submitting ? 'btn-primary is-disabled' : 'btn-primary'" @click="submitConduct">
				<text class="btn-label">{{ submitting ? '提交中' : '提交检验' }}</text>
			</view>
			<view class="link" @click="closeConduct">
				<text class="link-text">取消</text>
			</view>
		</view>
	</scroll-view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { uploadImage } from '../../../shared/api/upload.uts'
	import { asJsonObject, errorText, fieldId, fieldText, readRows } from '../../../shared/api/fields.uts'

	defineOptions({
		styleIsolation: 'app'
	})

	class StepOption {
		value : string = ''
		label : string = ''
	}

	class StepDraft {
		index : number = 0
		key : string = ''
		name : string = ''
		valueType : string = ''
		legacy : boolean = false
		textNeedsJudgment : boolean = false
		value : string = ''
		judgment : string = ''
		allowNa : boolean = false
		required : boolean = true
		wantsPhoto : boolean = false
		photos : UTSJSONObject[] = []
		options : StepOption[] = []
		multiSelected : string[] = []
	}

	class FieldDraft {
		uuid : string = ''
		code : string = ''
		name : string = ''
		fieldType : string = ''
		value : string = ''
	}

	const props = defineProps({
		backRequest: { type: Number, default: 0 },
		listPath: {
			type: String,
			default: ''
		},
		conductKind: {
			type: String,
			default: 'standard'
		},
		customTable: {
			type: String,
			default: ''
		},
		photoCategory: {
			type: String,
			default: ''
		}
	})

	const resultOptions : string[] = ['合格', '不合格', '部分合格']
	const statusOptions : string[] = ['合格', '不合格']
	const releaseValues : string[] = ['pending', 'released', 'rejected']
	const releaseLabels : string[] = ['待判定', '放行', '拒绝放行']

	const emit = defineEmits(['conduct-state'])
	const activeStage = ref(0)
	const scrollTarget = ref('')
	let firstMissingStep = -1
	const stageLabels = ['数量与结论', '检验项目', '核对与补充']
	const leavePromptOpen = ref(false)
	function goStage(index : number) {
		if (submitting.value || uploadingCount.value > 0 || index < 0 || index > 2) { return }
		activeStage.value = index
		scrollTarget.value = ''
	}
	function fileUrl(file : UTSJSONObject) : string { return file.getString('url') ?? '' }
	function previewFile(file : UTSJSONObject) {
		const url = fileUrl(file)
		if (url.length > 0) { uni.previewImage({ urls: [url], current: url }) }
	}
	function leaveHome() { askLeave(true) }
	function askLeave(toHome : boolean) {
		if (!conducting.value || leavePromptOpen.value) { return }
		if (submitting.value || uploadingCount.value > 0) { formError.value = '请等待上传或提交完成后离开'; return }
		leavePromptOpen.value = true
		uni.showModal({
			title: '离开检验', content: '当前检验尚未提交，离开会丢失已填写内容。', confirmText: '确认离开', cancelText: '继续填写',
			success: (result) => {
				leavePromptOpen.value = false
				if (!result.confirm) { return }
				conducting.value = false
				uploadSession.value += 1
				formError.value = ''
				if (toHome) { uni.reLaunch({ url: '/shell/workbench/index' }) }
			}, fail: () => { leavePromptOpen.value = false }
		})
	}
	const loading = ref(false)
	let ticket = 0
	const submitting = ref(false)
	const conducting = ref(false)
	const errorTextValue = ref('')
	const formError = ref('')
	const rows = ref<UTSJSONObject[]>([])
	const steps = ref<StepDraft[]>([])
	const attachments = ref<UTSJSONObject[]>([])
	const uploadingCount = ref(0)
	const uploadSession = ref(0)
	const customFields = ref<FieldDraft[]>([])
	const currentId = ref(0)
	const currentTitle = ref('')
	const currentQty = ref('')
	const qualifiedText = ref('0')
	const unqualifiedText = ref('0')
	const notes = ref('')
	const nonconformanceReason = ref('')
	const inspectorIdText = ref('')
	const inspectorUuid = ref('')
	const inspectionResult = ref('合格')
	const qualityStatus = ref('合格')
	const releaseDecision = ref('pending')
	const releaseNote = ref('')
	const needsOverallJudgment = ref(false)
	const overallJudgment = ref('')

	function choiceClass(current : string, value : string) : string {
		if (current == value) {
			return 'choice choice-on'
		}
		return 'choice'
	}

	function rowTitle(row : UTSJSONObject) : string {
		const code = fieldText(row, 'inspection_code')
		const name = fieldText(row, 'material_name')
		if (code.length > 0 && name.length > 0) {
			return code + ' ' + name
		}
		if (code.length > 0) {
			return code
		}
		return name
	}

	function rowLine(row : UTSJSONObject) : string {
		const parts : string[] = []
		const status = fieldText(row, 'status')
		if (status.length > 0) {
			parts.push(status)
		}
		const quality = fieldText(row, 'quality_status')
		if (quality.length > 0) {
			parts.push(quality)
		}
		const qty = fieldText(row, 'inspection_quantity')
		if (qty.length > 0) {
			parts.push('数量 ' + qty)
		}
		const supplier = fieldText(row, 'supplier_name')
		if (supplier.length > 0) {
			parts.push(supplier)
		}
		const workOrder = fieldText(row, 'work_order_code')
		if (workOrder.length > 0) {
			parts.push(workOrder)
		}
		const operation = fieldText(row, 'operation_name')
		if (operation.length > 0) {
			parts.push(operation)
		}
		const customer = fieldText(row, 'customer_name')
		if (customer.length > 0) {
			parts.push(customer)
		}
		return parts.join(' · ')
	}

	function inputValue(event : UniInputEvent) : string {
		return event.detail.value
	}

	function onQualifiedInput(event : UniInputEvent) {
		qualifiedText.value = inputValue(event)
	}

	function onUnqualifiedInput(event : UniInputEvent) {
		unqualifiedText.value = inputValue(event)
	}

	function onNotesInput(event : UniInputEvent) {
		notes.value = inputValue(event)
	}

	function onReasonInput(event : UniInputEvent) {
		nonconformanceReason.value = inputValue(event)
	}

	function onReleaseNoteInput(event : UniInputEvent) {
		releaseNote.value = inputValue(event)
	}

	function onStepInput(index : number, event : UniInputEvent) {
		const list = steps.value
		list[index].value = inputValue(event)
		steps.value = list
	}

	function onCustomInput(index : number, event : UniInputEvent) {
		const list = customFields.value
		list[index].value = inputValue(event)
		customFields.value = list
	}

	function pickResult(label : string) {
		inspectionResult.value = label
	}

	function pickStatus(label : string) {
		qualityStatus.value = label
	}

	function pickRelease(index : number) {
		releaseDecision.value = releaseValues[index]
	}

	function pickLegacy(index : number, judgment : string) {
		const list = steps.value
		list[index].judgment = judgment
		steps.value = list
	}

	function pickBool(index : number, value : string) {
		const list = steps.value
		list[index].value = value
		steps.value = list
	}

	function pickOption(index : number, optIndex : number) {
		const list = steps.value
		const step = list[index]
		if (optIndex < 0 || optIndex >= step.options.length) {
			return
		}
		// 再点已选项清除选择（对齐 PC Select allowClear）
		const value = step.options[optIndex].value
		step.value = step.value == value ? '' : value
		steps.value = list
	}

	function toggleOption(index : number, optIndex : number) {
		const list = steps.value
		const step = list[index]
		if (optIndex < 0 || optIndex >= step.options.length) {
			return
		}
		const value = step.options[optIndex].value
		const next : string[] = []
		let found = false
		for (let i = 0; i < step.multiSelected.length; i++) {
			if (step.multiSelected[i] == value) {
				found = true
				continue
			}
			next.push(step.multiSelected[i])
		}
		if (!found) {
			next.push(value)
		}
		step.multiSelected = next
		steps.value = list
	}

	function multiChoiceClass(index : number, value : string) : string {
		const list = steps.value
		if (index < 0 || index >= list.length) {
			return 'choice'
		}
		const selected = list[index].multiSelected
		for (let i = 0; i < selected.length; i++) {
			if (selected[i] == value) {
				return 'choice choice-on'
			}
		}
		return 'choice'
	}

	function pickOverall(value : string) {
		overallJudgment.value = value
	}

	function toggleNa(index : number) {
		const list = steps.value
		if (list[index].judgment == 'na') {
			list[index].judgment = ''
		} else {
			list[index].judgment = 'na'
		}
		steps.value = list
	}

	function fileLabel(file : UTSJSONObject) : string {
		const name = file.getString('name')
		if (name != null && name.length > 0) {
			return name
		}
		const uid = file.getString('uid')
		if (uid != null && uid.length > 0) {
			return uid
		}
		return '附件'
	}

	function keptFile(file : UTSJSONObject) : UTSJSONObject | null {
		const uid = file.getString('uid')
		const url = file.getString('url')
		const uidText = uid != null ? uid : ''
		const urlText = url != null ? url : ''
		if (uidText.length == 0 && urlText.length == 0) {
			return null
		}
		const status = file.getString('status')
		const name = file.getString('name')
		const out = new UTSJSONObject()
		out.set('uid', uidText)
		out.set('name', name != null ? name : '')
		out.set('url', urlText)
		out.set('status', status != null && status.length > 0 ? status : 'done')
		return out
	}

	function keptFiles(list : UTSJSONObject[]) : UTSJSONObject[] {
		const out : UTSJSONObject[] = []
		for (let i = 0; i < list.length; i++) {
			const one = keptFile(list[i])
			if (one != null) {
				out.push(one)
			}
		}
		return out
	}

	function stepShowsPhoto(index : number) : boolean {
		if (props.photoCategory.trim().length == 0) {
			return false
		}
		const list = steps.value
		if (index < 0 || index >= list.length) {
			return false
		}
		const step = list[index]
		if (step.legacy || !step.wantsPhoto) {
			return false
		}
		return step.judgment != 'na'
	}

	function removeAttachment(index : number) {
		const list = attachments.value
		const next : UTSJSONObject[] = []
		for (let i = 0; i < list.length; i++) {
			if (i != index) {
				next.push(list[i])
			}
		}
		attachments.value = next
	}

	function removeStepPhoto(stepIndex : number, photoIndex : number) {
		const list = steps.value
		const photos = list[stepIndex].photos
		const next : UTSJSONObject[] = []
		for (let i = 0; i < photos.length; i++) {
			if (i != photoIndex) {
				next.push(photos[i])
			}
		}
		list[stepIndex].photos = next
		steps.value = list
	}

	function addAttachment() {
		beginUpload(true, -1)
	}

	function addStepPhoto(index : number) {
		beginUpload(false, index)
	}

	function beginUpload(intoAttachments : boolean, stepIndex : number) {
		const category = props.photoCategory.trim()
		if (category.length == 0) {
			formError.value = '缺少附件分类'
			return
		}
		uni.chooseImage({
			count: 9,
			success: (res) => {
				const picked = res.tempFilePaths
				if (picked == null || picked.length == 0) {
					return
				}
				const paths : string[] = []
				for (let i = 0; i < picked.length; i++) {
					const one = picked[i]
					if (one != null && one.length > 0) {
						paths.push(one)
					}
				}
				if (paths.length == 0) {
					return
				}
				uploadChosen(paths, category, intoAttachments, stepIndex, uploadSession.value)
			},
			fail: () => {}
		})
	}

	async function uploadChosen(paths : string[], category : string, intoAttachments : boolean, stepIndex : number, session : number) {
		if (session != uploadSession.value) {
			return
		}
		uploadingCount.value = uploadingCount.value + paths.length
		for (let i = 0; i < paths.length; i++) {
			try {
				const file = await uploadImage(paths[i], category)
				if (session == uploadSession.value && conducting.value) {
					const normalized = keptFile(file)
					if (normalized != null) {
						if (intoAttachments) {
							const list = attachments.value
							list.push(normalized)
							attachments.value = list
						} else if (stepIndex >= 0 && stepIndex < steps.value.length) {
							const list = steps.value
							const photos = list[stepIndex].photos
							photos.push(normalized)
							list[stepIndex].photos = photos
							steps.value = list
						}
					}
				}
			} catch (err) {
				if (session == uploadSession.value) {
					formError.value = errorText(err)
				}
			}
			if (session == uploadSession.value) {
				uploadingCount.value = uploadingCount.value - 1
			}
		}
	}

	function readQty(text : string) : number {
		const num = parseFloat(text)
		if (isNaN(num)) {
			return 0
		}
		return num
	}

	function templateSource(row : UTSJSONObject) : UTSJSONObject | null {
		let src = row.getJSON('quality_characteristics')
		if (src == null) {
			src = row.getJSON('other_checks')
		}
		return src
	}

	function readTemplateItems(row : UTSJSONObject) : UTSJSONObject[] {
		const src = templateSource(row)
		if (src == null) {
			return [] as UTSJSONObject[]
		}
		const items = src.getArray('items')
		if (items == null) {
			return [] as UTSJSONObject[]
		}
		return items as UTSJSONObject[]
	}

	// 模板无 items 但需要整体判定的形态（对齐 PC InspectionTemplateConductFields 与后端校验）：
	// plan_id 存在时后端强制 item_results/conduct_step_results 非空；
	// acceptance_criteria / inspection_items 存在时 PC 同样渲染整体合格/不合格。
	function needsOverallResult(row : UTSJSONObject) : boolean {
		const src = templateSource(row)
		if (src == null) {
			return false
		}
		const items = src.getArray('items')
		if (items != null && items.length > 0) {
			return false
		}
		const planId = fieldText(src, 'plan_id')
		if (planId.length > 0 && planId != '0') {
			return true
		}
		if (fieldText(src, 'acceptance_criteria').length > 0) {
			return true
		}
		const raw = src['inspection_items']
		if (raw == null) {
			return false
		}
		if (typeof raw == 'string' && (raw as string).trim().length == 0) {
			return false
		}
		return true
	}

	function readStepOptions(spec : UTSJSONObject | null) : StepOption[] {
		const out : StepOption[] = []
		if (spec == null) {
			return out
		}
		const raw = spec.getArray('options')
		if (raw == null) {
			return out
		}
		for (let i = 0; i < raw.length; i++) {
			const obj = asJsonObject(raw[i])
			if (obj == null) {
				continue
			}
			const opt = new StepOption()
			opt.value = fieldText(obj, 'value')
			let label = fieldText(obj, 'label')
			if (label.length == 0) {
				label = opt.value
			}
			if (obj.getBoolean('defect') == true) {
				label = label + '（缺陷）'
			}
			opt.label = label
			out.push(opt)
		}
		return out
	}

	function buildSteps(row : UTSJSONObject) : StepDraft[] {
		const items = readTemplateItems(row)
		const out : StepDraft[] = []
		for (let i = 0; i < items.length; i++) {
			const item = items[i]
			const spec = item.getJSON('value_spec')
			if (spec != null && spec.getBoolean('derived') == true) {
				continue
			}
			const draft = new StepDraft()
			draft.index = i
			const stepKey = item.getString('step_key')
			draft.key = stepKey != null && stepKey.length > 0 ? stepKey : String(i)
			const name = item.getString('inspection_item')
			draft.name = name != null && name.length > 0 ? name : ('检验项 ' + String(i + 1))
			const valueType = item.getString('value_type')
			draft.photos = [] as UTSJSONObject[]
			if (valueType == null || valueType.length == 0) {
				draft.legacy = true
				draft.valueType = ''
				draft.allowNa = false
				draft.wantsPhoto = false
			} else {
				draft.valueType = valueType
				draft.legacy = false
				draft.textNeedsJudgment = valueType == 'text'
				draft.allowNa = spec != null && spec.getBoolean('allow_na') == true
				draft.wantsPhoto = spec != null && spec.getBoolean('require_photo') == true
				// 缺省必填，与后端 spec.get("required", True) 对齐
				const requiredFlag = spec != null ? spec.getBoolean('required') : null
				draft.required = requiredFlag == null || requiredFlag == true
				if (valueType == 'single_select' || valueType == 'multi_select') {
					draft.options = readStepOptions(spec)
				}
				if (valueType == 'boolean') {
					draft.value = 'true'
				}
			}
			out.push(draft)
		}
		return out
	}

	function buildStepResults() : UTSJSONObject | null {
		const obj = new UTSJSONObject()
		let count = 0
		const list = steps.value
		for (let i = 0; i < list.length; i++) {
			const step = list[i]
			if (step.legacy) {
				continue
			}
			const entry = new UTSJSONObject()
			let filled = false
			if (step.valueType == 'boolean') {
				entry.set('value', step.value == 'true')
				filled = true
			} else if (step.valueType == 'multi_select') {
				// 缺陷多选：空数组即「无缺陷」，后端按合格处理
				entry.set('value', step.multiSelected)
				filled = true
			} else if (step.valueType == 'numeric') {
				if (step.value.length > 0) {
					const num = parseFloat(step.value)
					if (isNaN(num)) {
						entry.set('value', step.value)
					} else {
						entry.set('value', num)
					}
					filled = true
				}
			} else if (step.value.length > 0) {
				entry.set('value', step.value)
				filled = true
			}
			if (step.textNeedsJudgment && step.judgment.length > 0) {
				entry.set('judgment', step.judgment)
				filled = true
			}
			if (step.judgment == 'na') {
				entry.set('judgment', 'na')
				filled = true
			}
			if (step.wantsPhoto && step.judgment != 'na') {
				const photos = keptFiles(step.photos)
				if (photos.length > 0) {
					entry.set('photos', photos)
					filled = true
				}
			}
			if (!filled) {
				continue
			}
			obj.set(step.key, entry)
			count++
		}
		if (count == 0) {
			return null
		}
		return obj
	}

	function buildItemResults() : UTSJSONObject | null {
		const obj = new UTSJSONObject()
		let count = 0
		// 无 items 模板：整体判定写入 item_results['0']（对齐 PC）
		if (needsOverallJudgment.value && (overallJudgment.value == 'pass' || overallJudgment.value == 'fail')) {
			obj.set('0', overallJudgment.value)
			count++
		}
		const list = steps.value
		for (let i = 0; i < list.length; i++) {
			const step = list[i]
			if (!step.legacy) {
				continue
			}
			if (step.judgment != 'pass' && step.judgment != 'fail') {
				continue
			}
			obj.set(step.key, step.judgment)
			count++
		}
		if (count == 0) {
			return null
		}
		return obj
	}

	function putInspector(body : UTSJSONObject, includeUuid : boolean) {
		const inspectorId = parseInt(inspectorIdText.value)
		if (!isNaN(inspectorId) && inspectorId > 0) {
			body.set('inspector_id', inspectorId)
		}
		if (includeUuid) {
			const uuid = inspectorUuid.value.trim()
			if (uuid.length > 0) {
				body.set('inspector_uuid', uuid)
			}
		}
	}

	function putStepExtras(body : UTSJSONObject) {
		const stepResults = buildStepResults()
		if (stepResults != null) {
			body.set('conduct_step_results', stepResults)
		}
		const itemResults = buildItemResults()
		if (itemResults != null) {
			body.set('item_results', itemResults)
		}
	}

	function buildStandardBody() : UTSJSONObject {
		const body = new UTSJSONObject()
		body.set('qualified_quantity', readQty(qualifiedText.value))
		body.set('unqualified_quantity', readQty(unqualifiedText.value))
		body.set('notes', notes.value)
		body.set('nonconformance_reason', nonconformanceReason.value)
		body.set('attachments', keptFiles(attachments.value))
		putInspector(body, true)
		putStepExtras(body)
		return body
	}

	function buildOqcBody() : UTSJSONObject {
		const body = new UTSJSONObject()
		body.set('inspection_result', inspectionResult.value)
		body.set('quality_status', qualityStatus.value)
		body.set('qualified_quantity', readQty(qualifiedText.value))
		body.set('unqualified_quantity', readQty(unqualifiedText.value))
		body.set('release_decision', releaseDecision.value)
		body.set('release_note', releaseNote.value)
		body.set('notes', notes.value)
		body.set('attachments', keptFiles(attachments.value))
		putInspector(body, false)
		putStepExtras(body)
		return body
	}

	async function loadCustomFields(recordId : number) {
		customFields.value = [] as FieldDraft[]
		const table = props.customTable
		if (table.length == 0 || recordId <= 0) {
			return
		}
		try {
			const payload = await request({
				path: '/api/v1/core/custom-fields/by-table/' + table + '?is_active=true',
				method: 'GET',
				data: null
			})
			const list = readRows(payload)
			const out : FieldDraft[] = []
			for (let i = 0; i < list.length; i++) {
				const row = list[i]
				const code = row.getString('code')
				const uuid = row.getString('uuid')
				if (code == null || uuid == null || code.length == 0 || uuid.length == 0) {
					continue
				}
				if (row.getBoolean('is_active') == false) {
					continue
				}
				const draft = new FieldDraft()
				draft.code = code
				draft.uuid = uuid
				const name = row.getString('name')
				draft.name = name != null && name.length > 0 ? name : code
				const fieldType = row.getString('field_type')
				draft.fieldType = fieldType == null ? 'text' : fieldType
				out.push(draft)
			}
			customFields.value = out
		} catch (err) {
			customFields.value = [] as FieldDraft[]
		}
	}

	async function saveCustomFields(recordId : number) : Promise<string> {
		const table = props.customTable
		const list = customFields.value
		if (table.length == 0 || list.length == 0) {
			return ''
		}
		const values : UTSJSONObject[] = []
		for (let i = 0; i < list.length; i++) {
			const field = list[i]
			const text = field.value.trim()
			// 对齐 PC useCustomFields：formula 空值跳过不写，其余空值提交 null 以清除旧值
			if (field.fieldType == 'formula' && text.length == 0) {
				continue
			}
			const one = new UTSJSONObject()
			one.set('field_uuid', field.uuid)
			if (text.length == 0) {
				one.set('value', null)
			} else if (field.fieldType == 'number' || field.fieldType == 'formula') {
				const num = parseFloat(text)
				if (isNaN(num)) {
					one.set('value', null)
				} else {
					one.set('value', num)
				}
			} else {
				// date/datetime 在提交前已按 YYYY-MM-DD / YYYY-MM-DD HH:mm 校验；
				// 其余 field_type（text/select/image/file/json 等）按字符串原样提交，不做额外转换
				one.set('value', text)
			}
			values.push(one)
		}
		if (values.length == 0) {
			return ''
		}
		const body = new UTSJSONObject()
		body.set('record_id', recordId)
		body.set('record_table', table)
		body.set('values', values)
		try {
			await request({
				path: '/api/v1/core/custom-fields/values',
				method: 'POST',
				data: body
			})
			return ''
		} catch (err) {
			return '自定义字段保存失败，检验结果已保存'
		}
	}

	async function loadList() {
		if (props.listPath.length == 0) {
			return
		}
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				path: props.listPath,
				method: 'GET',
				data: null
			})
			if (ticket != mine) {
				return
			}
			rows.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			rows.value = [] as UTSJSONObject[]
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function openConduct(index : number) {
		const row = rows.value[index]
		const id = fieldId(row)
		if (id <= 0) {
			formError.value = '检验单缺少 id'
			return
		}
		currentId.value = id
		currentTitle.value = rowTitle(row)
		currentQty.value = fieldText(row, 'inspection_quantity')
		qualifiedText.value = currentQty.value.length > 0 ? currentQty.value : '0'
		unqualifiedText.value = '0'
		notes.value = ''
		nonconformanceReason.value = ''
		inspectorIdText.value = ''
		inspectorUuid.value = ''
		inspectionResult.value = '合格'
		qualityStatus.value = '合格'
		releaseDecision.value = 'pending'
		releaseNote.value = ''
		formError.value = ''
		attachments.value = [] as UTSJSONObject[]
		uploadSession.value = uploadSession.value + 1
		uploadingCount.value = 0
		steps.value = buildSteps(row)
		needsOverallJudgment.value = needsOverallResult(row)
		overallJudgment.value = ''
		activeStage.value = 0
		conducting.value = true
		loadCustomFields(id)
	}

	function closeConduct() { askLeave(false) }
	watch(conducting, () => { emit('conduct-state', conducting.value) })
	watch(() : number => props.backRequest, () => { closeConduct() })

	// 对照后端 assert_inspection_quantities_balanced：合格+不合格须等于检验数量。
	// 检验数量读不到时跳过，交给后端兜底。
	function validateQuantities() : string {
		const expected = parseFloat(currentQty.value)
		if (isNaN(expected)) {
			return ''
		}
		const sum = readQty(qualifiedText.value) + readQty(unqualifiedText.value)
		if (Math.abs(sum - expected) > 0.000001) {
			return '合格数量和不合格数量之和必须等于检验数量 ' + currentQty.value
		}
		return ''
	}

	// 必填校验的最小子集（完整校验仍在后端 inspection_step_spec.py）：
	// legacy 项须选合格/不合格；typed 项按 valueType 判必填，na/非必填跳过；
	// text 项值与判定都必填；multi_select 空选视为「无缺陷」不必填。
	function validateSteps() : string {
		firstMissingStep = -1
		const missing : string[] = []
		const list = steps.value
		for (let i = 0; i < list.length; i++) {
			const step = list[i]
			if (step.legacy) {
				if (step.judgment != 'pass' && step.judgment != 'fail') {
					if (firstMissingStep < 0) { firstMissingStep = i }
					missing.push(step.name)
				}
				continue
			}
			if (step.judgment == 'na' || !step.required) {
				continue
			}
			if (step.valueType == 'boolean' || step.valueType == 'multi_select') {
				continue
			}
			if (step.valueType == 'text') {
				if (step.value.trim().length == 0 || (step.judgment != 'pass' && step.judgment != 'fail')) {
					if (firstMissingStep < 0) { firstMissingStep = i }
					missing.push(step.name)
				}
				continue
			}
			if (step.value.trim().length == 0) {
				if (firstMissingStep < 0) { firstMissingStep = i }
					missing.push(step.name)
			}
		}
		if (missing.length > 0) {
			return '请完成检验项：' + missing.join('、')
		}
		return ''
	}

	function hasFailedStep() : boolean {
		const list = steps.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].judgment == 'fail') {
				return true
			}
		}
		return false
	}

	function validateFailedStep() : string {
		if (props.conductKind == 'oqc' || !hasFailedStep()) {
			return ''
		}
		if (readQty(unqualifiedText.value) <= 0) {
			return '有不合格步骤时，不合格数量须大于 0'
		}
		if (nonconformanceReason.value.trim().length == 0) {
			return '请填写不合格原因'
		}
		return ''
	}

	function isDigitsRange(text : string, from : number, to : number) : boolean {
		for (let i = from; i < to; i++) {
			const code = text.charCodeAt(i)
			if (isNaN(code) || code < 48 || code > 57) {
				return false
			}
		}
		return true
	}

	function isDateShape(text : string) : boolean {
		if (text.length != 10) {
			return false
		}
		if (text.charAt(4) != '-' || text.charAt(7) != '-') {
			return false
		}
		return isDigitsRange(text, 0, 4) && isDigitsRange(text, 5, 7) && isDigitsRange(text, 8, 10)
	}

	function isDateTimeShape(text : string) : boolean {
		if (text.length != 16) {
			return false
		}
		if (!isDateShape(text.substring(0, 10))) {
			return false
		}
		if (text.charAt(10) != ' ' || text.charAt(13) != ':') {
			return false
		}
		return isDigitsRange(text, 11, 13) && isDigitsRange(text, 14, 16)
	}

	// date/datetime 自定义字段的提交形态校验（对齐 PC useCustomFields）
	function validateCustomFieldFormats() : string {
		const list = customFields.value
		for (let i = 0; i < list.length; i++) {
			const field = list[i]
			const text = field.value.trim()
			if (text.length == 0) {
				continue
			}
			if (field.fieldType == 'date' && !isDateShape(text)) {
				return '自定义字段「' + field.name + '」须为 YYYY-MM-DD 格式'
			}
			if (field.fieldType == 'datetime' && !isDateTimeShape(text)) {
				return '自定义字段「' + field.name + '」须为 YYYY-MM-DD HH:mm 格式'
			}
		}
		return ''
	}

	async function submitConduct() {
		if (uploadingCount.value > 0) {
			formError.value = '图片仍在上传'
			return
		}
		if (submitting.value || currentId.value <= 0) {
			return
		}
		const qtyError = validateQuantities()
		if (qtyError.length > 0) {
			activeStage.value = 0
			formError.value = qtyError
			return
		}
		const stepError = validateSteps()
		if (stepError.length > 0) {
			activeStage.value = 1
			scrollTarget.value = ''
			if (firstMissingStep >= 0) { nextTick(() => { scrollTarget.value = 'quality-step-' + firstMissingStep.toString() }) }
			formError.value = stepError
			return
		}
		const failError = validateFailedStep()
		if (failError.length > 0) {
			activeStage.value = 0
			formError.value = failError
			return
		}
		if (needsOverallJudgment.value && overallJudgment.value != 'pass' && overallJudgment.value != 'fail') {
			activeStage.value = 1
			formError.value = '请填写整体检验判定'
			return
		}
		const fieldError = validateCustomFieldFormats()
		if (fieldError.length > 0) {
			activeStage.value = 2
			formError.value = fieldError
			return
		}
		if (props.conductKind == 'oqc') {
			if (inspectionResult.value.length == 0 || qualityStatus.value.length == 0 || releaseDecision.value.length == 0) {
				activeStage.value = 0
				formError.value = '请填写检验结果、质量状态和放行结论'
				return
			}
		}
		submitting.value = true
		formError.value = ''
		const path = props.listPath + '/' + String(currentId.value) + '/conduct'
		const body = props.conductKind == 'oqc' ? buildOqcBody() : buildStandardBody()
		try {
			await request({
				path: path,
				method: 'POST',
				data: body
			})
		} catch (err) {
			formError.value = errorText(err)
			submitting.value = false
			return
		}
		const customWarning = await saveCustomFields(currentId.value)
		submitting.value = false
		conducting.value = false
		if (customWarning.length > 0) {
			uni.showToast({
				title: customWarning,
				icon: 'none',
				duration: 3000
			})
		} else {
			uni.showToast({
				title: '检验已提交',
				icon: 'success'
			})
		}
		await loadList()
	}

	onMounted(() => {
		loadList()
	})
</script>

<style>
	.attachment-preview { width: 80px; height: 80px; margin-right: 8px; border-radius: 8px; }
	.field-wrap {
		margin-top: 10px;
	}
	.choices {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 6px;
	}
</style>
