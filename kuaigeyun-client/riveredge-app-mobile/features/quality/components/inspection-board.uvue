		color: #28113C;
	}

	.meta {
		font-size: 13px;
		color: #888B9D;
		margin-top: 4px;
	}

	.action {
		margin-top: 8px;
		color: #801ED3;
		font-size: 14px;
	}

	.field {
		margin-top: 10px;
	}

	.label {
		font-size: 13px;
		color: #888B9D;
		margin-bottom: 4px;
	}

	.input {
		border-width: 1px;
		border-style: solid;
		border-color: #E7D9FD;
		border-radius: 6px;
		padding: 8px;
		font-size: 14px;
		background-color: #ffffff;
	}

	.choices {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 6px;
	}

	.choice {
		margin-right: 8px;
		margin-top: 6px;
		padding: 4px 8px;
		border-width: 1px;
		border-style: solid;
		border-color: #E7D9FD;
		border-radius: 4px;
