<template>
	<scroll-view class="page" scroll-y="true">
		<home-link />
		<view class="toolbar">
			<button class="btn-secondary" @click="loadLedger">刷新</button>
		</view>
		<text v-if="loading" class="loading">加载中</text>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<view v-if="selectedIndex < 0">
			<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="empty">暂无不合格品</text>
			<view v-for="(row, index) in rows" :key="index" class="card" hover-class="pressed" @click="openRow(index)">
				<text class="title">{{ titleOf(row) }}</text>
				<text v-if="lineOf(row).length > 0" class="meta">{{ lineOf(row) }}</text>
			</view>
		</view>
		<view v-else class="card">
			<button class="btn-secondary" @click="closeRow">返回列表</button>
			<text class="title">{{ titleOf(rows[selectedIndex]) }}</text>
			<text v-if="lineOf(rows[selectedIndex]).length > 0" class="meta">{{ lineOf(rows[selectedIndex]) }}</text>
			<view v-if="canDispose(rows[selectedIndex])">
				<text class="label">处置</text>
				<view class="kind-row">
					<text v-for="(label, index) in disposeLabels" :key="index" :class="disposeIndex == index ? 'choice choice-on' : 'choice'" @click="pickDispose(index)">{{ label }}</text>
				</view>
				<text v-if="disposeIndex == 4 || disposeIndex == 1 || disposeIndex == 2" class="hint">{{ blockedPlaceText() }}</text>
				<view v-if="disposeIndex == 5">
					<text class="meta">目标原料 {{ materialName(rows[selectedIndex]) }}</text>
					<text class="meta">入库仓库 {{ warehouseName(rows[selectedIndex]) }}</text>
				</view>
				<view v-if="disposeIndex == 6">
					<text class="label">备注</text>
					<input class="field" :value="disposeNote" @input="onDisposeNote" />
				</view>
				<button class="btn-primary" :disabled="loading" @click="submitDispose">确认处置</button>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { fieldText, fieldNumber, errorText, readRows } from '../../../shared/api/fields.uts'

	const disposeCodes : string[] = ['return', 'accept', 'quarantine', 'rework', 'scrap', 'downgrade', 'other']
	const disposeLabels : string[] = ['退货', '让步', '隔离', '返工', '报废', '降级', '其他']

	const loading = ref(false)
	const errorTextValue = ref('')
	const rows = ref<UTSJSONObject[]>([])
	const selectedIndex = ref(-1)
	const disposeIndex = ref(-1)
	const disposeNote = ref('')

	function titleOf(row : UTSJSONObject) : string {
		const code = fieldText(row, 'code')
		const name = fieldText(row, 'product_name')
		if (code.length > 0 && name.length > 0) {
			return code + ' ' + name
		}
		if (code.length > 0) {
			return code
		}
		return name.length > 0 ? name : '不合格品'
	}

	function lineOf(row : UTSJSONObject) : string {
		const parts : string[] = []
		const status = statusLabel(fieldText(row, 'status'))
		if (status.length > 0) {
			parts.push(status)
		}
		const defectType = fieldText(row, 'defect_type')
		if (defectType.length > 0) {
			parts.push(defectType)
		}
		const qty = fieldText(row, 'defect_quantity')
		if (qty.length > 0) {
			parts.push('数量 ' + qty)
		}
		const reason = fieldText(row, 'defect_reason')
		if (reason.length > 0) {
			parts.push(reason)
		}
		const disposition = fieldText(row, 'disposition')
		if (disposition.length > 0) {
			parts.push(disposition)
		}
		return parts.join(' · ')
	}

	function statusLabel(status : string) : string {
		if (status == 'draft') {
			return '待处置'
		}
		if (status == 'processed') {
			return '已处置'
		}
		if (status == 'cancelled') {
			return '已取消'
		}
		return status
	}

	function canDispose(row : UTSJSONObject) : boolean {
		return fieldText(row, 'status') == 'draft'
	}

	function materialName(row : UTSJSONObject) : string {
		const name = fieldText(row, 'downgrade_material_name')
		if (name.length > 0) {
			return name
		}
		return fieldText(row, 'downgrade_material_code')
	}

	function warehouseName(row : UTSJSONObject) : string {
		return fieldText(row, 'downgrade_warehouse_name')
	}

	function blockedPlaceText() : string {
		if (disposeIndex.value == 2) {
			return '列表没有隔离仓库，不能提交这项处置'
		}
		if (disposeIndex.value == 4) {
			return '列表没有报废仓库，不能提交这项处置'
		}
		return '列表没有放行仓库，不能提交这项处置'
	}

	function openRow(index : number) {
		selectedIndex.value = index
		disposeIndex.value = -1
		disposeNote.value = ''
		errorTextValue.value = ''
	}

	function closeRow() {
		selectedIndex.value = -1
		disposeIndex.value = -1
		disposeNote.value = ''
	}

	function pickDispose(index : number) {
		disposeIndex.value = index
		errorTextValue.value = ''
	}

	function onDisposeNote(event : UniInputEvent) {
		disposeNote.value = event.detail.value
	}

	async function submitDispose() {
		const index = selectedIndex.value
		if (loading.value || index < 0) {
			return
		}
		if (disposeIndex.value < 0) {
			errorTextValue.value = '请选择处置'
			return
		}
		const row = rows.value[index]
		const code = disposeCodes[disposeIndex.value]
		const defectId = fieldNumber(row, 'id')
		if (defectId <= 0) {
			errorTextValue.value = '记录无效'
			return
		}
		if (code == 'accept' || code == 'quarantine' || code == 'scrap') {
			errorTextValue.value = blockedPlaceText()
			return
		}
		if (code == 'return' && fieldNumber(row, 'incoming_inspection_id') <= 0) {
			errorTextValue.value = '这条记录没有来料检验，不能退货'
			return
		}
		const body = new UTSJSONObject()
		body.set('disposition', code)
		if (code == 'downgrade') {
			const materialId = fieldNumber(row, 'downgrade_material_id')
			const warehouseId = fieldNumber(row, 'downgrade_warehouse_id')
			if (materialId <= 0 || warehouseId <= 0 || materialName(row).length == 0 || warehouseName(row).length == 0) {
				errorTextValue.value = '列表没有目标原料或入库仓库，不能提交降级'
				return
			}
			body.set('downgrade_material_id', materialId)
			body.set('downgrade_warehouse_id', warehouseId)
		}
		if (code == 'other') {
			const note = disposeNote.value.trim()
			if (note.length == 0) {
				errorTextValue.value = '请填写备注'
				return
			}
			body.set('remarks', note)
		}
		loading.value = true
		errorTextValue.value = ''
		try {
			await request({
				path: '/api/v1/apps/kuaizhizao/nonconforming-ledger/' + defectId + '/disposition',
				method: 'PUT',
				data: body
			})
			closeRow()
			await loadLedger()
		} catch (err) {
			errorTextValue.value = errorText(err)
			loading.value = false
		}
	}

	onBackPress((options : OnBackPressOptions) : boolean | null => {
		if (selectedIndex.value < 0) {
			return false
		}
		if (options.from == 'backbutton' || options.from == 'navigateBack') {
			closeRow()
			return true
		}
		return false
	})

	async function loadLedger() {
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				path: '/api/v1/apps/kuaizhizao/nonconforming-ledger',
				method: 'GET',
				data: null
			})
			rows.value = readRows(payload)
		} catch (err) {
			rows.value = [] as UTSJSONObject[]
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	onShow(() => {
		loadLedger()
	})
</script>

<style>
	.kind-row {
		flex-direction: row;
		flex-wrap: wrap;
	}
</style>


