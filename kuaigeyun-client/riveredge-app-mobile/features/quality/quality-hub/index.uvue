<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" scroll-y="true">
		<view class="toolbar">
			<button class="btn-secondary" @click="loadSummary">刷新</button>
		</view>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="!loading && pendingRows.length == 0 && errorTextValue.length == 0" class="empty">汇总里没有待检项</text>
		<view v-for="(row, index) in pendingRows" :key="index" class="card" hover-class="pressed" @click="openRow(index)">
			<text class="title">{{ row.label }}</text>
			<text class="meta">待检 {{ row.countText }}</text>
		</view>
	</scroll-view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { errorText } from '../../../shared/api/fields.uts'
	import { openRegisteredRoute } from '../../../shell/registry/index.uts'
	import { featurePackage } from '../index.uts'

	class PendingRow {
		label : string = ''
		countText : string = ''
		route : string = ''
	}

	const fieldToKey : string[] = ['pending_incoming', 'pending_process', 'pending_finished', 'pending_oqc']
	const entryKeys : string[] = ['incoming', 'process-scan', 'finished', 'oqc']

	const loading = ref(false)
	const errorTextValue = ref('')
	const pendingRows = ref<PendingRow[]>([])
	let ticket = 0

	function readPending(summary : UTSJSONObject) : PendingRow[] {
		const out : PendingRow[] = []
		const entries = featurePackage.entries
		for (let i = 0; i < fieldToKey.length; i++) {
			const count = summary.getNumber(fieldToKey[i])
			if (count == null || count <= 0) {
				continue
			}
			let label = ''
			let route = ''
			for (let j = 0; j < entries.length; j++) {
				if (entries[j].key == entryKeys[i]) {
					label = entries[j].label
					route = entries[j].route
				}
			}
			if (route.length == 0) {
				continue
			}
			const row = new PendingRow()
			row.label = label
			row.countText = String(count)
			row.route = route
			out.push(row)
		}
		return out
	}

	async function loadSummary() {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				path: '/api/v1/apps/kuaizhizao/quality/inspection-center-summary',
				method: 'GET',
				data: null
			})
			if (ticket != mine) {
				return
			}
			if (payload == null || Array.isArray(payload)) {
				pendingRows.value = [] as PendingRow[]
				errorTextValue.value = '汇总响应不是对象'
			} else {
				pendingRows.value = readPending(payload as UTSJSONObject)
			}
		} catch (err) {
			if (ticket != mine) {
				return
			}
			pendingRows.value = [] as PendingRow[]
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function openRow(index : number) {
		const route = pendingRows.value[index].route
		if (route.length == 0) {
			return
		}
		if (!openRegisteredRoute(route)) {
			uni.showToast({ title: '功能尚未安装', icon: 'none' })
		}
	}

	onShow(() => {
		loadSummary()
	})
</script>


