<template>
	<view class="page-shell">
		<home-link :hold-back="needsGuard" @back="leaveBack" :hold-home="needsGuard" @home="leaveHome" />
	<scroll-view class="page" direction="vertical" :scroll-into-view="scrollTarget">
		<load-feedback :active="loading && selectedId == 0 && loadMode != 'more'" :mode="loadMode" />
		<view v-if="isQuery" class="row">
			<input class="field grow" v-model="keyword" :disabled="loading || busy" placeholder="物料编码、名称或仓库" />
			<action-button label="查询" :compact="true" @press="reload" :disabled="loading || busy" />
		</view>
		<action-button label="刷新" tone="secondary" v-if="selectedId == 0" :disabled="loading || busy" @press="reload" />
		<text v-if="hint.length > 0" class="error">{{ hint }}</text>

		<view v-if="selectedId == 0">
			<text v-if="!loading && cards.length == 0" class="empty">没有数据</text>
			<action-card v-for="(card, index) in cards" :key="index" @press="openCard(index)" :disabled="loading || busy">
				<text class="title">{{ card.title }}</text>
				<text v-if="card.status.length > 0" :class="statusClass(card.status)">{{ card.status }}</text>
				<text v-if="card.subtitle.length > 0" class="meta">{{ card.subtitle }}</text>
			</action-card>
			<load-feedback :active="loading && selectedId == 0 && loadMode == 'more'" mode="more" />
			<action-button label="加载更多" tone="secondary" v-if="cards.length < total" :disabled="loading || busy" @press="loadMore" />
		</view>

		<view v-else class="card">
			<action-button label="返回列表" tone="secondary" @press="closeDetail" />
			<text class="title">{{ detailTitle }}</text>
			<text v-if="detailStatus.length > 0" :class="statusClass(detailStatus)">{{ detailStatus }}</text>
			<text class="hint">{{ stepLabel }}</text>

			<view v-if="wizardStep == 1 && showHeader">
				<text class="meta">仓库 {{ warehouseName.length > 0 ? warehouseName : '未填写' }}</text>
				<text class="meta">{{ personLabel }} {{ personName.length > 0 ? personName : '未填写' }}</text>
				<action-button :label="editingHeader ? '收起编辑' : '编辑仓库与人员'" tone="secondary" :disabled="busy" @press="editingHeader = !editingHeader" />
				<view v-if="editingHeader">
				<text class="label">仓库名称</text>
				<input class="field" :value="warehouseName" @input="onWarehouseName" />
				<text class="label">{{ personLabel }}</text>
				<input class="field" :value="personName" @input="onPersonName" />
				</view>
				<action-button label="下一步" tone="primary" @press="goStep(2)" />
			</view>

			<view v-if="wizardStep == 2 && (showLines || isStock)">
				<text class="label">定位物料</text>
				<input class="field" :value="locateText" placeholder="物料编码或名称" @input="onLocateText" />
				<action-button label="定位" tone="secondary" @press="locateLine" />
				<text v-if="locateHint.length > 0" :class="locateMiss ? 'error' : 'hint'">{{ locateHint }}</text>
				<text v-if="showLines && !showReceipt" class="hint">单据数量只作核对，确认时不另填数量。</text>
				<view v-for="(line, index) in lines" :key="index" :id="'warehouse-line-' + index" class="line">
					<text class="title">{{ line.materialCode }} {{ line.materialName }}</text>
					<text v-if="locatedIndex == index" class="meta">当前定位</text>
					<text v-if="line.displayQty.length > 0" class="meta">单据数量 {{ line.displayQty }}</text>
					<view v-if="showLines">
						<text class="meta">仓库 {{ line.warehouseName }} · 库位 {{ line.locationCode }}</text>
						<text class="meta">批号 {{ line.batchNumber }} · 序列号 {{ serialList(line.serialText).length }} 个</text>
						<text v-if="showReceipt" class="meta">实收 {{ line.receiptQuantityText }}</text>
						<action-button :label="editingLineIndex == index ? '收起编辑' : '编辑此物料'" tone="secondary" :disabled="busy" @press="editLine(index)" />
						<view v-if="editingLineIndex == index">
						<text class="label">仓库名称</text>
						<input class="field" :value="line.warehouseName" @input="onLineInput(index, 'warehouseName', $event)" />
						<text class="label">库位编码</text>
						<input class="field" :value="line.locationCode" @input="onLineInput(index, 'locationCode', $event)" />
						<text class="label">批号</text>
						<input class="field" :value="line.batchNumber" @input="onLineInput(index, 'batchNumber', $event)" />
						<text class="label">序列号</text>
						<view v-for="(serial, serialIndex) in serialList(line.serialText)" :key="serialIndex" class="row">
							<text class="meta">{{ serial }}</text>
							<action-button label="移除" :compact="true" :disabled="busy" @press="removeSerial(index, serialIndex)" />
						</view>
						<input class="field" v-model="serialInput" :disabled="busy" placeholder="输入或粘贴序列号，支持逗号分隔" />
						<action-button label="添加序列号" tone="secondary" :disabled="busy" @press="addSerial(index)" />
						<view v-if="showReceipt">
							<text class="label">实收数量</text>
							<input class="field" :value="line.receiptQuantityText" @input="onLineInput(index, 'receiptQuantityText', $event)" />
						</view>
					</view>
					</view>
					<view v-if="isStock">
						<text class="meta">账面 {{ line.bookQuantityText }}</text>
						<text class="label">实际数量</text>
						<input class="field" :value="line.actualQuantityText" @input="onLineInput(index, 'actualQuantityText', $event)" />
						<text class="label">备注</text>
						<input class="field" :value="line.remarks" @input="onLineInput(index, 'remarks', $event)" />
						<action-button label="记录实盘" tone="primary" :busy="busy" :disabled="loading" @press="submitStock(index)" />
					</view>
				</view>
				<action-button label="上一步" tone="secondary" v-if="showHeader" @press="goStep(1)" />
				<action-button label="下一步" tone="primary" v-if="showHeader" @press="goStep(3)" />
			</view>

			<view v-if="wizardStep == 3 && isAlert">
				<text class="label">处理状态</text>
				<view class="row">
					<choice-button label="处理中" :selected="alertStatus == 'processing'" @choose="pickStatus('processing')" :disabled="busy" />
					<choice-button label="已解决" :selected="alertStatus == 'resolved'" @choose="pickStatus('resolved')" :disabled="busy" />
					<choice-button label="已忽略" :selected="alertStatus == 'ignored'" @choose="pickStatus('ignored')" :disabled="busy" />
				</view>
				<text class="label">处理备注</text>
				<input class="field" :value="alertNotes" @input="onAlertNotes" />
			</view>

			<view v-if="wizardStep == 3 && showSubmit && !isStock">
				<text v-if="showHeader" class="meta">仓库 {{ warehouseName }}</text>
				<text v-if="showHeader" class="meta">{{ personLabel }} {{ personName }}</text>
				<view v-for="(line, index) in lines" :key="index" class="line">
					<text class="title">{{ line.materialCode }} {{ line.materialName }}</text>
					<text v-if="line.displayQty.length > 0" class="meta">单据数量 {{ line.displayQty }}</text>
					<text v-if="showLines" class="meta">仓库 {{ line.warehouseName }} · 库位 {{ line.locationCode }}</text>
					<text v-if="showLines" class="meta">批号 {{ line.batchNumber }}</text>
					<text v-for="(serial, serialIndex) in serialList(line.serialText)" :key="serialIndex" class="meta">序列号 {{ serial }}</text>
					<text v-if="showReceipt && line.receiptQuantityText.length > 0" class="meta">实收 {{ line.receiptQuantityText }}</text>
				</view>
				<action-button label="返回修改" tone="secondary" v-if="showHeader" @press="goStep(2)" />
				<action-button :label="actionLabel" tone="primary" :busy="busy" :disabled="loading" @press="askSubmit" />
			</view>
		</view>
	</scroll-view>
		<load-feedback :active="loading && selectedId > 0" mode="blocking" />
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../shared/ui/action-card.uvue'
	import ChoiceButton from '../../shared/ui/choice-button.uvue'
	import ActionButton from '../../shared/ui/action-button.uvue'
	import HomeLink from '../../shared/ui/home-link.uvue'
	import { alertHandlePath, apiGet, apiPost, confirmPath, detailPath, listPath, listQuery, sendPath, stockExecutePath, transferExecutePath } from './http.uts'
	import { DocCard, LineForm } from './models.uts'
	import { buildAlertBody, buildInboundBody, buildOutboundBody, buildSalesBody, buildStockBody, serialList } from './payload.uts'
	import { errorText } from '../../shared/api/fields.uts'
	import { readCards, readDetail, readTotal } from './read.uts'

	defineOptions({
		styleIsolation: 'app'
	})

	const props = defineProps({
		kind: {
			type: String,
			default: ''
		},
		backRequest: {
			type: Number,
			default: 0
		},
		showRequest: {
			type: Number,
			default: 0
		}
	})

	const emit = defineEmits(['guard-state'])

	const cards = ref<DocCard[]>([])
	const lines = ref<LineForm[]>([])
	const keyword = ref('')
	const activeKeyword = ref('')
	const lastSize = ref(50)
	const hint = ref('')
	const loading = ref(false)
	const listLoaded = ref(false)
	const loadMode = ref('initial')
	const busy = ref(false)
	const skip = ref(0)
	const page = ref(1)
	const total = ref(0)
	const selectedId = ref(0)
	const detailTitle = ref('')
	const detailStatus = ref('')
	const warehouseIdText = ref('')
	const warehouseName = ref('')
	const personIdText = ref('')
	const personName = ref('')
	const alertStatus = ref('processing')
	const alertStatusBaseline = ref('processing')
	const alertNotes = ref('')
	const wizardStep = ref(1)
	const locateText = ref('')
	const locateHint = ref('')
	const locateMiss = ref(false)
	const locatedIndex = ref(-1)
	const editingHeader = ref(false)
	const editingLineIndex = ref(-1)
	const serialInput = ref('')
	const scrollTarget = ref('')
	const leaving = ref(false)
	const leavePromptOpen = ref(false)
	let ticket = 0
	function editLine(index : number) {
		if (busy.value) { return }
		editingLineIndex.value = editingLineIndex.value == index ? -1 : index
		serialInput.value = ''
	}
	function addSerial(index : number) {
		if (busy.value || index < 0 || index >= lines.value.length) { return }
		const incoming = serialList(serialInput.value)
		if (incoming.length == 0) { return }
		const line = lines.value[index]
		const next = serialList(line.serialText).concat(incoming)
		line.serialText = next.join(',')
		serialInput.value = ''
	}
	function removeSerial(index : number, serialIndex : number) {
		if (busy.value || index < 0 || index >= lines.value.length) { return }
		const line = lines.value[index]
		const next = serialList(line.serialText)
		if (serialIndex < 0 || serialIndex >= next.length) { return }
		next.splice(serialIndex, 1)
		line.serialText = next.join(',')
	}

	function currentKind(): string {
		const value = props.kind
		if (value == null) {
			return ''
		}
		return value as string
	}

	function pageMode(kind: string): string {
		if (kind == 'inventory-query') return 'query'
		if (kind == 'delivery-notices') return 'send'
		if (kind == 'inventory-transfer') return 'execute'
		if (kind == 'stocktaking') return 'stock'
		if (kind == 'inventory-alerts') return 'alert'
		if (kind == 'sales-deliveries') return 'sales'
		if (kind == 'pickings') return 'picking'
		if (kind == 'other-outbound') return 'deliver'
		return 'inbound'
	}

	const mode = computed((): string => {
		return pageMode(currentKind())
	})

	const isQuery = computed((): boolean => {
		return mode.value == 'query'
	})

	const isStock = computed((): boolean => {
		return mode.value == 'stock'
	})

	const isAlert = computed((): boolean => {
		return mode.value == 'alert'
	})

	const showHeader = computed((): boolean => {
		const value = mode.value
		return value == 'inbound' || value == 'picking' || value == 'deliver' || value == 'sales'
	})

	const showLines = computed((): boolean => {
		return showHeader.value
	})

	const showReceipt = computed((): boolean => {
		return currentKind() == 'purchase-receipts'
	})

	const showSubmit = computed((): boolean => {
		const value = mode.value
		return value == 'inbound' || value == 'picking' || value == 'deliver' || value == 'sales' || value == 'send' || value == 'execute' || value == 'alert'
	})

	const personLabel = computed((): string => {
		if (mode.value == 'picking') return '领料人'
		if (mode.value == 'deliver' || mode.value == 'sales') return '出库人'
		return '收货人'
	})

	const stepLabel = computed((): string => {
		if (isAlert.value) {
			return '处理'
		}
		if (isStock.value) {
			return '逐行实盘'
		}
		if (wizardStep.value == 1) {
			return '单据'
		}
		if (wizardStep.value == 2) {
			return '明细'
		}
		return '确认'
	})

	const actionLabel = computed((): string => {
		const kind = currentKind()
		if (kind == 'pickings') return '确认领料'
		if (kind == 'returns') return '确认退料'
		if (kind == 'purchase-receipts') return '确认收货'
		if (kind == 'sales-deliveries' || kind == 'other-outbound') return '确认出库'
		if (kind == 'delivery-notices') return '发送'
		if (kind == 'inventory-transfer') return '执行调拨'
		if (kind == 'inventory-alerts') return '处理'
		return '确认入库'
	})

	const needsGuard = computed((): boolean => {
		if (leaving.value) {
			return false
		}
		if (busy.value) {
			return true
		}
		if (selectedId.value <= 0) {
			return false
		}
		if (isStock.value) {
			const list = lines.value
			for (let i = 0; i < list.length; i++) {
				if (list[i].actualQuantityText.trim().length > 0 || list[i].remarks.trim().length > 0) {
					return true
				}
			}
		}
		if (isAlert.value && (alertNotes.value.trim().length > 0 || alertStatus.value != alertStatusBaseline.value)) {
			return true
		}
		return editingHeader.value || editingLineIndex.value >= 0 || serialInput.value.trim().length > 0
	})

	// 页面级返回协议：包装页经 guard-state 事件同步守卫状态，系统返回时递增
	// back-request 触发离开确认；show-request 让页面再次显示时刷新列表。
	watch(needsGuard, () => { emit('guard-state', needsGuard.value) })
	watch((): number => props.backRequest, () => { askLeave(false) })
	watch((): number => props.showRequest, () => { reload() })

	onMounted(() => {
		reload()
	})

	function reload(): void {
		void loadList(true)
	}

	function loadMore(): void {
		if (loading.value || busy.value) { return }
		void loadList(false)
	}

	async function loadList(reset: boolean): Promise<void> {
		const path = listPath(currentKind())
		if (path.length == 0) {
			hint.value = '未知页面'
			return
		}
		const mine = ticket + 1
		ticket = mine
		const inventory = currentKind() == 'inventory-query'
		const querySkip = reset ? 0 : inventory ? skip.value : skip.value + lastSize.value
		const queryPage = reset ? 1 : inventory ? page.value + 1 : page.value
		const queryKeyword = reset ? keyword.value : activeKeyword.value
		loadMode.value = !reset ? 'more' : listLoaded.value ? 'refresh' : 'initial'
		loading.value = true
		hint.value = ''
		try {
			const raw = await apiGet(path, listQuery(currentKind(), querySkip, queryPage, queryKeyword))
			if (ticket != mine) {
				return
			}
			const batch = readCards(raw)
			skip.value = querySkip
			page.value = queryPage
			lastSize.value = batch.length
			activeKeyword.value = queryKeyword
			total.value = readTotal(raw)
			listLoaded.value = true
			if (reset) {
				cards.value = batch
			} else {
				const next: DocCard[] = []
				const current = cards.value
				for (let i = 0; i < current.length; i++) {
					next.push(current[i])
				}
				for (let i = 0; i < batch.length; i++) {
					next.push(batch[i])
				}
				cards.value = next
			}
		} catch (err) {
			if (ticket != mine) {
				return
			}
			hint.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function openCard(index: number): void {
		if (mode.value == 'query') {
			return
		}
		const card = cards.value[index]
		selectedId.value = card.id
		detailTitle.value = card.title
		detailStatus.value = card.status
		void loadDetail()
	}

	function closeDetail(): void {
		selectedId.value = 0
		lines.value = []
		hint.value = ''
		wizardStep.value = 1
		clearLocate()
	}

	function clearLocate(): void {
		editingHeader.value = false
		editingLineIndex.value = -1
		serialInput.value = ''
		scrollTarget.value = ''
		locateText.value = ''
		locateHint.value = ''
		locateMiss.value = false
		locatedIndex.value = -1
	}

	function beginWizard(): void {
		const value = mode.value
		if (value == 'alert' || value == 'send' || value == 'execute') {
			wizardStep.value = 3
			return
		}
		if (value == 'stock') {
			wizardStep.value = 2
			return
		}
		wizardStep.value = 1
	}

	function goStep(step: number): void {
		wizardStep.value = step
	}

	function statusClass(status: string): string {
		if (status.indexOf('逾期') >= 0 || status.indexOf('不合格') >= 0 || status.indexOf('驳回') >= 0 || status.indexOf('严重') >= 0) {
			return 'badge badge-danger'
		}
		if (status.indexOf('完成') >= 0 || status.indexOf('合格') >= 0) {
			return 'badge badge-ok'
		}
		if (status.indexOf('进行') >= 0 || status.indexOf('生产') >= 0 || status.indexOf('维修') >= 0 || status.indexOf('盘点') >= 0 || status.indexOf('处理中') >= 0) {
			return 'badge badge-progress'
		}
		if (status.indexOf('待') == 0) {
			return 'badge badge-warning'
		}
		return 'meta'
	}

	async function loadDetail(): Promise<void> {
		const mine = ticket + 1
		ticket = mine
		const detailId = selectedId.value
		loading.value = true
		hint.value = ''
		try {
			const raw = await apiGet(detailPath(currentKind(), detailId), null)
			if (ticket != mine) {
				return
			}
			const form = readDetail(currentKind(), raw)
			warehouseIdText.value = form.warehouseIdText
			warehouseName.value = form.warehouseName
			personIdText.value = form.personIdText
			personName.value = form.personName
			lines.value = form.lines
			alertStatus.value = 'processing'
			alertStatusBaseline.value = alertStatus.value
			alertNotes.value = ''
			clearLocate()
			beginWizard()
		} catch (err) {
			if (ticket != mine) {
				return
			}
			hint.value = errorText(err)
			beginWizard()
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function onWarehouseName(e: UniInputEvent): void {
		warehouseName.value = e.detail.value
	}

	function onPersonName(e: UniInputEvent): void {
		personName.value = e.detail.value
	}

	function onAlertNotes(e: UniInputEvent): void {
		alertNotes.value = e.detail.value
	}

	function pickStatus(status: string): void {
		alertStatus.value = status
	}

	function onLocateText(e: UniInputEvent): void {
		locateText.value = e.detail.value
	}

	function locateLine(): void {
		const word = locateText.value.trim()
		locatedIndex.value = -1
		if (word.length == 0) {
			locateMiss.value = false
			locateHint.value = ''
			return
		}
		const list = lines.value
		for (let i = 0; i < list.length; i++) {
			const code = list[i].materialCode
			const name = list[i].materialName
			if (code == word || name == word || code.indexOf(word) >= 0 || name.indexOf(word) >= 0) {
				locatedIndex.value = i
				scrollTarget.value = ''
				nextTick(() => { scrollTarget.value = 'warehouse-line-' + i.toString() })
				locateMiss.value = false
				locateHint.value = '已定位到 ' + name
				return
			}
		}
		locateMiss.value = true
		locateHint.value = '这张单没有这个物料'
	}

	function onLineInput(index: number, field: string, e: UniInputEvent): void {
		const value = e.detail.value
		const next: LineForm[] = []
		const current = lines.value
		for (let i = 0; i < current.length; i++) {
			const line = current[i]
			if (i == index) {
				if (field == 'warehouseIdText') line.warehouseIdText = value
				else if (field == 'warehouseName') line.warehouseName = value
				else if (field == 'locationIdText') line.locationIdText = value
				else if (field == 'locationCode') line.locationCode = value
				else if (field == 'batchNumber') line.batchNumber = value
				else if (field == 'serialText') line.serialText = value
				else if (field == 'receiptQuantityText') line.receiptQuantityText = value
				else if (field == 'actualQuantityText') line.actualQuantityText = value
				else if (field == 'remarks') line.remarks = value
			}
			next.push(line)
		}
		lines.value = next
	}

	function qtyOf(text: string): number {
		const value = parseFloat(text.trim())
		if (isNaN(value)) {
			return -1
		}
		return value
	}

	function receiptDiff(): boolean {
		if (!showReceipt.value) {
			return false
		}
		const list = lines.value
		for (let i = 0; i < list.length; i++) {
			const expected = qtyOf(list[i].displayQty)
			const actual = qtyOf(list[i].receiptQuantityText)
			if (expected >= 0 && actual >= 0 && expected != actual) {
				return true
			}
		}
		return false
	}

	function askSubmit(): void {
		if (busy.value) {
			return
		}
		if (isAlert.value && alertStatus.value == 'ignored') {
			uni.showModal({
				title: '忽略这条预警',
				content: '忽略后不再作为待处理。',
				confirmText: '确认忽略',
				cancelText: '返回',
				success: (res) => {
					if (res.confirm) {
						void submitMain()
					}
				}
			})
			return
		}
		if (receiptDiff()) {
			uni.showModal({
				title: '实收与单据数量不一致',
				content: '可以返回修改，或仍然提交当前实收数量。',
				confirmText: '仍然提交',
				cancelText: '返回修改',
				success: (res) => {
					if (res.confirm) {
						void submitMain()
					}
				}
			})
			return
		}
		void submitMain()
	}

	async function submitMain(): Promise<void> {
		if (busy.value || selectedId.value <= 0) {
			return
		}
		const kind = currentKind()
		const value = mode.value
		hint.value = ''
		if (value == 'send') {
			await postEmpty(sendPath(selectedId.value))
			return
		}
		if (value == 'execute') {
			await postEmpty(transferExecutePath(selectedId.value))
			return
		}
		let body: UTSJSONObject | null = null
		if (value == 'alert') {
			body = buildAlertBody(alertStatus.value, alertNotes.value)
		} else if (value == 'sales') {
			body = buildSalesBody(warehouseIdText.value, warehouseName.value, personIdText.value, personName.value, lines.value)
		} else if (value == 'picking') {
			body = buildOutboundBody('picker', warehouseIdText.value, warehouseName.value, personIdText.value, personName.value, lines.value)
		} else if (value == 'deliver') {
			body = buildOutboundBody('deliverer', warehouseIdText.value, warehouseName.value, personIdText.value, personName.value, lines.value)
		} else if (value == 'inbound') {
			body = buildInboundBody(warehouseIdText.value, warehouseName.value, personIdText.value, personName.value, lines.value, currentKind() == 'purchase-receipts')
		}
		if (body == null) {
			hint.value = '没有可提交的确认内容'
			return
		}
		await postBody(value == 'alert' ? alertHandlePath(selectedId.value) : confirmPath(kind, selectedId.value), body)
	}

	async function submitStock(index: number): Promise<void> {
		if (busy.value) {
			return
		}
		const line = lines.value[index]
		const body = buildStockBody(line.actualQuantityText, line.remarks)
		if (body == null) {
			hint.value = '请填写实际数量'
			return
		}
		await postBody(stockExecutePath(selectedId.value, line.itemId), body)
	}

	async function postEmpty(path: string): Promise<void> {
		busy.value = true
		hint.value = ''
		try {
			await apiPost(path, null)
			uni.showToast({ title: '已提交', icon: 'none' })
			closeDetail()
			reload()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			busy.value = false
		}
	}

	async function postBody(path: string, body: UTSJSONObject): Promise<void> {
		busy.value = true
		hint.value = ''
		try {
			await apiPost(path, body)
			uni.showToast({ title: '已提交', icon: 'none' })
			closeDetail()
			reload()
		} catch (err) {
			hint.value = errorText(err)
		} finally {
			busy.value = false
		}
	}

	function leaveHome(): void { askLeave(true) }

	function leaveBack(): void { askLeave(false) }

	function askLeave(toHome: boolean): void {
		if (!needsGuard.value || leavePromptOpen.value) {
			return
		}
		if (busy.value) {
			hint.value = '提交或读取进行中，请等待完成后再离开'
			return
		}
		leavePromptOpen.value = true
		uni.showModal({
			title: '离开确认',
			content: '当前内容尚未提交，离开后已填写的内容将丢失。',
			confirmText: '确认离开',
			cancelText: '继续填写',
			success: (result) => {
				leavePromptOpen.value = false
				if (!result.confirm) {
					return
				}
				leaving.value = true
				// 同步解除包装页守卫，避免随后的 navigateBack 被页面级 onBackPress 再次拦截。
				emit('guard-state', false)
				if (toHome) {
					uni.reLaunch({
						url: '/shell/workbench/index',
						fail: () => { leaving.value = false; leavePromptOpen.value = false }
					})
				} else {
					uni.navigateBack({
						fail: () => { leaving.value = false; leavePromptOpen.value = false }
					})
				}
			},
			fail: () => { leavePromptOpen.value = false }
		})
	}

	// 组件内的 onBackPress 不会被 uni-app x 派发（仅页面生命周期），系统返回由包装页
	// 经 back-request 驱动；此处保留作为看板被直接当页使用时的兜底，重复触发由 leavePromptOpen 去重。
	if (typeof onBackPress == 'function') {
		onBackPress((options : OnBackPressOptions) : boolean | null => {
			if (!needsGuard.value) {
				return false
			}
			if (options.from == 'backbutton' || options.from == 'navigateBack') {
				leaveBack()
				return true
			}
			return false
		})
	}
</script>

<style>
	.row {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}
	.grow {
		flex: 1;
		margin-right: 8px;
	}
	.line {
		margin-top: 12px;
		padding-top: 12px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E2E8F0;
	}
</style>
