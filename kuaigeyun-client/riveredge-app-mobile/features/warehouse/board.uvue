	.row {
		flex-direction: row;
		align-items: center;
		margin-top: 8px;
	}
	.grow {
		flex: 1;
		margin-right: 8px;
	}
	.line {
		margin-top: 12px;
		padding-top: 12px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #E2E8F0;
	}
</style>
