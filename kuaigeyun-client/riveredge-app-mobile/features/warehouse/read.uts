import { DetailForm, DocCard, LineForm } from './models.uts'
import { asJsonObject, fieldId, fieldNumber, fieldText, firstText, readRows } from '../../shared/api/fields.uts'

export function unwrap(raw: any | null): any | null {
	const obj = asJsonObject(raw)
	if (obj == null) {
		return raw
	}
	if (obj.getBoolean('success') == true) {
		const data = obj.getJSON('data')
		if (data != null) {
			return data
		}
		const dataAny = obj.get('data')
		if (dataAny != null) {
			return dataAny
		}
	}
	return obj
}

function idText(value: number): string {
	if (value > 0) {
		return Math.floor(value).toString()
	}
	return ''
}

export function readTotal(raw: any | null): number {
	const obj = asJsonObject(unwrap(raw))
	if (obj == null) {
		return 0
	}
	return Math.floor(fieldNumber(obj, 'total'))
}

export function readCards(raw: any | null): DocCard[] {
	const rows = readRows(raw)
	const cards: DocCard[] = []
	for (let i = 0; i < rows.length; i++) {
		cards.push(readCard(rows[i]))
	}
	return cards
}

function readCard(row: UTSJSONObject): DocCard {
	const card = new DocCard()
	card.id = fieldId(row)
	card.status = fieldText(row, 'status')
	card.title = firstText(row, ['picking_code', 'return_code', 'receipt_code', 'delivery_code', 'notice_code', 'inbound_code', 'outbound_code', 'code', 'material_code'])
	if (card.title.length == 0) {
		card.title = '#' + card.id.toString()
	}
	const fromWh = fieldText(row, 'from_warehouse_name')
	const toWh = fieldText(row, 'to_warehouse_name')
	if (fromWh.length > 0 || toWh.length > 0) {
		card.subtitle = fromWh + ' → ' + toWh
	} else {
		card.subtitle = firstText(row, ['warehouse_name', 'customer_name', 'material_name', 'alert_message'])
	}
	if (row.get('quantity') != null) {
		const unit = fieldText(row, 'material_unit')
		const qty = fieldNumber(row, 'quantity').toString()
		card.subtitle = (card.subtitle + ' ' + qty + unit).trim()
	}
	if (row.get('current_quantity') != null) {
		card.subtitle = (card.subtitle + ' 当前 ' + fieldNumber(row, 'current_quantity').toString()).trim()
	}
	return card
}

function joinSerials(item: UTSJSONObject): string {
	const arr = item.getArray('serial_numbers')
	if (arr == null) {
		return fieldText(item, 'serial_numbers')
	}
	const parts: string[] = []
	for (let i = 0; i < arr.length; i++) {
		const one = arr[i]
		if (typeof one == 'string' && (one as string).length > 0) {
			parts.push(one as string)
		}
	}
	return parts.join(',')
}

function lineFrom(kind: string, item: UTSJSONObject, headerWh: string, headerWhName: string): LineForm {
	const line = new LineForm()
	line.itemId = fieldId(item)
	line.materialCode = fieldText(item, 'material_code')
	line.materialName = fieldText(item, 'material_name')
	line.warehouseIdText = idText(fieldNumber(item, 'warehouse_id'))
	line.warehouseName = fieldText(item, 'warehouse_name')
	line.locationIdText = idText(fieldNumber(item, 'location_id'))
	line.locationCode = fieldText(item, 'location_code')
	line.batchNumber = fieldText(item, 'batch_number')
	if (line.batchNumber.length == 0) {
		line.batchNumber = fieldText(item, 'batch_no')
	}
	line.serialText = joinSerials(item)
	line.deliveryQuantity = fieldNumber(item, 'delivery_quantity')
	line.displayQty = ''
	if (kind == 'pickings') {
		line.displayQty = fieldNumber(item, 'required_quantity').toString()
	} else if (kind == 'sales-deliveries') {
		line.displayQty = line.deliveryQuantity.toString()
	} else if (kind == 'other-outbound') {
		line.displayQty = fieldNumber(item, 'outbound_quantity').toString()
	} else if (kind == 'other-inbound') {
		line.displayQty = fieldNumber(item, 'inbound_quantity').toString()
	} else if (kind == 'returns') {
		line.displayQty = fieldNumber(item, 'return_quantity').toString()
	} else if (kind == 'fg-receipts' || kind == 'purchase-receipts') {
		line.displayQty = fieldNumber(item, 'receipt_quantity').toString()
	} else if (kind == 'stocktaking') {
		line.bookQuantityText = fieldNumber(item, 'book_quantity').toString()
		if (item.get('actual_quantity') != null) {
			line.actualQuantityText = fieldNumber(item, 'actual_quantity').toString()
		}
		line.remarks = fieldText(item, 'remarks')
	}
	if (kind == 'returns') {
		const receipt = fieldNumber(item, 'receipt_quantity')
		const back = fieldNumber(item, 'return_quantity')
		const qty = receipt > 0 ? receipt : back
		if (qty > 0) {
			line.receiptQuantityText = qty.toString()
		}
	} else if (kind == 'purchase-receipts' || kind == 'fg-receipts') {
		const qty = fieldNumber(item, 'receipt_quantity')
		if (qty > 0) {
			line.receiptQuantityText = qty.toString()
		}
	} else if (kind == 'other-inbound') {
		const receipt = fieldNumber(item, 'receipt_quantity')
		if (receipt > 0) {
			line.receiptQuantityText = receipt.toString()
		} else {
			const inbound = fieldNumber(item, 'inbound_quantity')
			if (inbound > 0) {
				line.receiptQuantityText = inbound.toString()
			}
		}
	}
	if (line.warehouseIdText.length == 0) {
		line.warehouseIdText = headerWh
		if (line.warehouseName.length == 0) {
			line.warehouseName = headerWhName
		}
	}
	return line
}

function fillPerson(kind: string, obj: UTSJSONObject, form: DetailForm): void {
	if (kind == 'pickings') {
		form.personIdText = idText(fieldNumber(obj, 'picker_id'))
		form.personName = fieldText(obj, 'picker_name')
		return
	}
	if (kind == 'other-outbound' || kind == 'sales-deliveries') {
		form.personIdText = idText(fieldNumber(obj, 'deliverer_id'))
		form.personName = fieldText(obj, 'deliverer_name')
		return
	}
	let personId = fieldNumber(obj, 'receiver_id')
	if (personId <= 0) {
		personId = fieldNumber(obj, 'returner_id')
	}
	if (personId <= 0) {
		personId = fieldNumber(obj, 'received_by')
	}
	form.personIdText = idText(personId)
	form.personName = firstText(obj, ['receiver_name', 'returner_name', 'received_by_name'])
}

export function readDetail(kind: string, raw: any | null): DetailForm {
	const form = new DetailForm()
	const obj = asJsonObject(unwrap(raw))
	if (obj == null) {
		return form
	}
	form.warehouseIdText = idText(fieldNumber(obj, 'warehouse_id'))
	form.warehouseName = fieldText(obj, 'warehouse_name')
	fillPerson(kind, obj, form)
	const rows = readRows(obj)
	const lines: LineForm[] = []
	for (let i = 0; i < rows.length; i++) {
		const line = lineFrom(kind, rows[i], form.warehouseIdText, form.warehouseName)
		if (line.itemId > 0) {
			lines.push(line)
		}
	}
	if (kind == 'pickings' && form.warehouseIdText.length == 0 && lines.length > 0) {
		form.warehouseIdText = lines[0].warehouseIdText
		form.warehouseName = lines[0].warehouseName
	}
	form.lines = lines
	return form
}
