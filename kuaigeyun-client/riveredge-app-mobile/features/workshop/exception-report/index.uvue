<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading && !submitting" :mode="loadSettled ? 'refresh' : 'initial'" />
		<view class="modes">
			<choice-button label="缺料" :selected="kind == 'material-shortage'" @choose="switchKind('material-shortage')" :disabled="loading || submitting" />
			<choice-button label="交期" :selected="kind == 'delivery-delay'" @choose="switchKind('delivery-delay')" :disabled="loading || submitting" />
			<choice-button label="质量" :selected="kind == 'quality'" @choose="switchKind('quality')" :disabled="loading || submitting" />
		</view>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text class="section">工单</text>
		<action-card v-for="(row, index) in orders" :key="index" @press="pickOrder(index)" :disabled="loading || submitting">
			<text class="title">{{ orderTitle(row) }}</text>
			<text class="sub">{{ selectedOrderIndex == index ? '已选' : textOfStatus(row) }}</text>
		</action-card>
		<view v-if="kind == 'material-shortage'">
			<input :disabled="loading || submitting" class="field" v-model="materialKeyword" placeholder="物料名称或编码" />
			<action-button label="查找物料" tone="secondary" @press="searchMaterials" :disabled="loading || submitting" />
			<action-card v-for="(row, index) in materials" :key="index" @press="pickMaterial(index)" :disabled="loading || submitting">
				<text class="title">{{ materialTitle(row) }}</text>
				<text class="sub">{{ selectedMaterialIndex == index ? '已选' : '点选' }}</text>
			</action-card>
			<input :disabled="loading || submitting" class="field" v-model="shortageQuantity" placeholder="缺料数量" />
		</view>
		<view v-if="kind == 'delivery-delay'">
			<input :disabled="loading || submitting" class="field" v-model="delayReason" placeholder="延期原因" />
			<input :disabled="loading || submitting" class="field" v-model="delayDays" placeholder="延期天数（可空）" />
		</view>
		<view v-if="kind == 'quality'">
			<input :disabled="loading || submitting" class="field" v-model="problemDescription" placeholder="问题描述" />
		</view>
		<input :disabled="loading || submitting" class="field" v-model="remarks" placeholder="备注（可空）" />
		<action-button label="提交" tone="primary" :busy="submitting" busy-label="提交中" @press="submitReport" :disabled="loading || submitting" />
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../../shared/ui/action-card.uvue'
	import ChoiceButton from '../../../shared/ui/choice-button.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, fieldNumber, errorText, firstText } from '../../../shared/api/fields.uts'
	import { toast } from '../json.uts'

	const kind = ref('material-shortage')
	const orders = ref<any[]>([])
	const materials = ref<any[]>([])
	const selectedOrderIndex = ref(-1)
	const selectedMaterialIndex = ref(-1)
	const materialKeyword = ref('')
	const shortageQuantity = ref('')
	const delayReason = ref('')
	const delayDays = ref('')
	const problemDescription = ref('')
	const remarks = ref('')
	const errorTextValue = ref('')
	const loading = ref(false)
	const loadSettled = ref(false)
	const submitting = ref(false)
	let ticket = 0
	let materialTicket = 0
	let ordersOpen = false
	let materialsOpen = false

	function syncLoading(): void {
		loading.value = ordersOpen || materialsOpen
		if (!loading.value) { loadSettled.value = true }
	}

	function orderTitle(row : any) : string {
		return fieldText(row, 'code') + ' ' + fieldText(row, 'name')
	}

	function textOfStatus(row : any) : string {
		return fieldText(row, 'status')
	}

	function materialTitle(row : any) : string {
		return firstText(row, ['main_code', 'mainCode', 'code']) + ' ' + fieldText(row, 'name')
	}

	async function loadOrders() {
		if (submitting.value) { return }
		const mine = ticket + 1
		ticket = mine
		ordersOpen = true
		syncLoading()
		errorTextValue.value = ''
		try {
			const query = new UTSJSONObject()
			query.set('limit', 50)
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders',
				query: query,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			orders.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		ordersOpen = false
		syncLoading()
	}

	async function searchMaterials() {
		if (loading.value || submitting.value) { return }
		selectedMaterialIndex.value = -1
		const mine = materialTicket + 1
		materialTicket = mine
		materialsOpen = true
		syncLoading()
		const query = new UTSJSONObject()
		query.set('limit', 30)
		const keyword = materialKeyword.value.trim()
		if (keyword.length > 0) {
			query.set('keyword', keyword)
		}
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/master-data/materials',
				query: query,
				body: null,
			})
			if (materialTicket != mine) {
				return
			}
			materials.value = readRows(payload)
		} catch (err) {
			if (materialTicket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (materialTicket != mine) {
			return
		}
		materialsOpen = false
		syncLoading()
	}

	function pickOrder(index : number) {
		if (loading.value || submitting.value) { return }
		selectedOrderIndex.value = index
	}

	function pickMaterial(index : number) {
		if (loading.value || submitting.value) { return }
		selectedMaterialIndex.value = index
	}

	function switchKind(next : string) {
		if (loading.value || submitting.value) { return }
		kind.value = next
		selectedOrderIndex.value = -1
		selectedMaterialIndex.value = -1
		materials.value = []
		errorTextValue.value = ''
	}

	function isNonNegativeIntText(text : string) : boolean {
		if (text.length == 0) {
			return false
		}
		for (let i = 0; i < text.length; i++) {
			const ch = text.charAt(i)
			if (ch < '0' || ch > '9') {
				return false
			}
		}
		return true
	}

	function selectedWorkOrderId() : number {
		if (selectedOrderIndex.value < 0) {
			return 0
		}
		return fieldNumber(orders.value[selectedOrderIndex.value], 'id')
	}

	async function submitReport() {
		if (loading.value || submitting.value) { return }
		const body = new UTSJSONObject()
		const note = remarks.value.trim()
		if (note.length > 0) {
			body.set('remarks', note)
		}
		let path = ''
		if (kind.value == 'material-shortage') {
			const workOrderId = selectedWorkOrderId()
			if (workOrderId <= 0 || selectedMaterialIndex.value < 0) {
				toast('请选择工单和物料')
				return
			}
			const shortage = parseFloat(shortageQuantity.value.trim())
			if (isNaN(shortage) || shortage <= 0) {
				toast('请填写缺料数量')
				return
			}
			body.set('work_order_id', workOrderId)
			body.set('material_id', fieldNumber(materials.value[selectedMaterialIndex.value], 'id'))
			body.set('shortage_quantity', shortage)
			path = '/api/v1/apps/kuaizhizao/exceptions/material-shortage'
		} else if (kind.value == 'delivery-delay') {
			const workOrderId = selectedWorkOrderId()
			const reason = delayReason.value.trim()
			if (workOrderId <= 0 || reason.length == 0) {
				toast('请选择工单并填写延期原因')
				return
			}
			body.set('work_order_id', workOrderId)
			body.set('delay_reason', reason)
			const daysText = delayDays.value.trim()
			if (daysText.length > 0) {
				if (!isNonNegativeIntText(daysText)) {
					toast('延期天数需为非负整数')
					return
				}
				body.set('delay_days', parseInt(daysText))
			}
			path = '/api/v1/apps/kuaizhizao/exceptions/delivery-delay'
		} else {
			const description = problemDescription.value.trim()
			if (description.length == 0) {
				toast('请填写问题描述')
				return
			}
			body.set('problem_description', description)
			const workOrderId = selectedWorkOrderId()
			if (workOrderId > 0) {
				body.set('work_order_id', workOrderId)
			}
			path = '/api/v1/apps/kuaizhizao/exceptions/quality'
		}
		submitting.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: path,
				query: null,
				body: body,
			})
			toast('已提交')
		} catch (err) {
			errorTextValue.value = errorText(err)
		} finally {
			submitting.value = false
		}
	}

	onLoad(() => {
		loadOrders()
	})
</script>

<style>
	.modes {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.section {
		margin-top: 12px;
	}
</style>
