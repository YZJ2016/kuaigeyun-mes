<template>
	<view class="page">
		<view class="modes">
			<button class="action" @click="switchKind('material-shortage')">缺料</button>
			<button class="action" @click="switchKind('delivery-delay')">交期</button>
			<button class="action" @click="switchKind('quality')">质量</button>
		</view>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text class="section">工单</text>
		<view v-for="(row, index) in orders" :key="index" class="card" @click="pickOrder(index)">
			<text class="title">{{ orderTitle(row) }}</text>
			<text class="sub">{{ selectedOrderIndex == index ? '已选' : textOfStatus(row) }}</text>
		</view>
		<view v-if="kind == 'material-shortage'">
			<input class="field" v-model="materialKeyword" placeholder="物料名称或编码" />
			<button class="action" @click="searchMaterials">查找物料</button>
			<view v-for="(row, index) in materials" :key="index" class="card" @click="pickMaterial(index)">
				<text class="title">{{ materialTitle(row) }}</text>
				<text class="sub">{{ selectedMaterialIndex == index ? '已选' : '点选' }}</text>
			</view>
			<input class="field" v-model="shortageQuantity" placeholder="缺料数量" />
		</view>
		<view v-if="kind == 'delivery-delay'">
			<input class="field" v-model="delayReason" placeholder="延期原因" />
			<input class="field" v-model="delayDays" placeholder="延期天数（可空）" />
		</view>
		<view v-if="kind == 'quality'">
			<input class="field" v-model="problemDescription" placeholder="问题描述" />
		</view>
		<input class="field" v-model="remarks" placeholder="备注（可空）" />
		<button class="action" @click="submitReport">提交</button>
	</view>
</template>

<script setup lang="uts">
	import { request } from '../../../shared/api/index.uts'
	import { readRows, textOf, fieldNumber, errorText, toast, firstText } from '../json.uts'

	const kind = ref('material-shortage')
	const orders = ref<any[]>([])
	const materials = ref<any[]>([])
	const selectedOrderIndex = ref(-1)
	const selectedMaterialIndex = ref(-1)
	const materialKeyword = ref('')
	const shortageQuantity = ref('')
	const delayReason = ref('')
	const delayDays = ref('')
	const problemDescription = ref('')
	const remarks = ref('')
	const errorTextValue = ref('')

	function orderTitle(row : any) : string {
		return textOf(row, 'code') + ' ' + textOf(row, 'name')
	}

	function textOfStatus(row : any) : string {
		return textOf(row, 'status')
	}

	function materialTitle(row : any) : string {
		return firstText(row, ['main_code', 'mainCode', 'code']) + ' ' + textOf(row, 'name')
	}

	async function loadOrders() {
		errorTextValue.value = ''
		try {
			const query = new UTSJSONObject()
			query.set('limit', 50)
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders',
				query: query,
				body: null,
			})
			orders.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
	}

	async function searchMaterials() {
		selectedMaterialIndex.value = -1
		const query = new UTSJSONObject()
		query.set('limit', 30)
		const keyword = materialKeyword.value.trim()
		if (keyword.length > 0) {
			query.set('keyword', keyword)
		}
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/master-data/materials',
				query: query,
				body: null,
			})
			materials.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
	}

	function pickOrder(index : number) {
		selectedOrderIndex.value = index
	}

	function pickMaterial(index : number) {
		selectedMaterialIndex.value = index
	}

	function switchKind(next : string) {
		kind.value = next
		selectedOrderIndex.value = -1
		selectedMaterialIndex.value = -1
	}

	function selectedWorkOrderId() : number {
		if (selectedOrderIndex.value < 0) {
			return 0
		}
		return fieldNumber(orders.value[selectedOrderIndex.value], 'id')
	}

	async function submitReport() {
		const body = new UTSJSONObject()
		const note = remarks.value.trim()
		if (note.length > 0) {
			body.set('remarks', note)
		}
		let path = ''
		if (kind.value == 'material-shortage') {
			const workOrderId = selectedWorkOrderId()
			if (workOrderId <= 0 || selectedMaterialIndex.value < 0) {
				toast('请选择工单和物料')
				return
			}
			const shortage = parseFloat(shortageQuantity.value.trim())
			if (isNaN(shortage) || shortage <= 0) {
				toast('请填写缺料数量')
				return
			}
			body.set('work_order_id', workOrderId)
			body.set('material_id', fieldNumber(materials.value[selectedMaterialIndex.value], 'id'))
			body.set('shortage_quantity', shortage)
			path = '/api/v1/apps/kuaizhizao/exceptions/material-shortage'
		} else if (kind.value == 'delivery-delay') {
			const workOrderId = selectedWorkOrderId()
			const reason = delayReason.value.trim()
			if (workOrderId <= 0 || reason.length == 0) {
				toast('请选择工单并填写延期原因')
				return
			}
			body.set('work_order_id', workOrderId)
			body.set('delay_reason', reason)
			const daysText = delayDays.value.trim()
			if (daysText.length > 0) {
				const days = parseInt(daysText)
				if (isNaN(days)) {
					toast('延期天数不是数字')
					return
				}
				if (days < 0) {
					toast('延期天数不能小于 0')
					return
				}
				body.set('delay_days', days)
			}
			path = '/api/v1/apps/kuaizhizao/exceptions/delivery-delay'
		} else {
			const description = problemDescription.value.trim()
			if (description.length == 0) {
				toast('请填写问题描述')
				return
			}
			body.set('problem_description', description)
			const workOrderId = selectedWorkOrderId()
			if (workOrderId > 0) {
				body.set('work_order_id', workOrderId)
			}
			path = '/api/v1/apps/kuaizhizao/exceptions/quality'
		}
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: path,
				query: null,
				body: body,
			})
			toast('已提交')
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
	}

	onLoad(() => {
		loadOrders()
	})
</script>

<style>
	.page {
		flex-direction: column;
		padding: 12px;
	}

	.modes {
		flex-direction: row;
		margin-bottom: 8px;
	}

	.section {
		font-size: 16px;
		margin-bottom: 8px;
	}

	.error {
		font-size: 14px;
		color: #FF4942;
		margin-bottom: 8px;
	}

	.card {
		flex-direction: column;
		padding: 12px;
		margin-bottom: 8px;
		background-color: #ffffff;
		border-radius: 16px;
	}

	.title {
		font-size: 16px;
	}

	.sub {
		font-size: 13px;
		color: #888B9D;
		margin-top: 4px;
	}

	.field {
		margin-top: 8px;
		padding: 8px;
		background-color: #ffffff;
	}

	.action {
		margin-top: 8px;
		margin-right: 8px;
		margin-bottom: 8px;
	}
</style>
