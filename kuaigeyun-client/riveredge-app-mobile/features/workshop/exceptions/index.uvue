<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading" :mode="loadSettled ? 'refresh' : 'initial'" />
		<view class="modes">
			<choice-button label="缺料" :selected="kind == 'material-shortage'" @choose="switchKind('material-shortage')" :disabled="loading" />
			<choice-button label="交期" :selected="kind == 'delivery-delay'" @choose="switchKind('delivery-delay')" :disabled="loading" />
			<choice-button label="质量" :selected="kind == 'quality'" @choose="switchKind('quality')" :disabled="loading" />
		</view>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<empty-state v-if="!loading && rows.length == 0 && errorTextValue.length == 0" title="暂无异常" />
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ChoiceButton from '../../../shared/ui/choice-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, errorText } from '../../../shared/api/fields.uts'
	import EmptyState from '../../../shared/ui/empty-state.uvue'

	const kind = ref('material-shortage')
	const rows = ref<any[]>([])
	const loading = ref(false)
	const loadSettled = ref(false)
	const errorTextValue = ref('')
	let ticket = 0

	function lineTitle(row : any) : string {
		if (kind.value == 'quality') {
			return fieldText(row, 'problem_description')
		}
		if (kind.value == 'delivery-delay') {
			return fieldText(row, 'work_order_code') + ' ' + fieldText(row, 'delay_reason')
		}
		return fieldText(row, 'work_order_code') + ' ' + fieldText(row, 'material_name')
	}

	function lineSub(row : any) : string {
		if (kind.value == 'quality') {
			return fieldText(row, 'work_order_code') + '  ' + fieldText(row, 'severity') + '  ' + fieldText(row, 'status')
		}
		if (kind.value == 'delivery-delay') {
			return '延期 ' + fieldText(row, 'delay_days') + ' 天  ' + fieldText(row, 'status')
		}
		return '缺料 ' + fieldText(row, 'shortage_quantity') + '  ' + fieldText(row, 'status')
	}

	async function load() {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/exceptions/' + kind.value,
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			rows.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	function switchKind(next : string) {
		if (loading.value || kind.value == next) { return }
		rows.value = []
		loadSettled.value = false
		kind.value = next
		load()
	}

	onLoad(() => {
		load()
	})
</script>

<style>
	.modes {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.section {
		margin-top: 12px;
	}
</style>
