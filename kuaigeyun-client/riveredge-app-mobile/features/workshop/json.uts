import { readRows } from '../../shared/api/fields.uts'

/**
 * 扫码工单定位接口返回 {work_orders:[..], message:..}，属 kuaizhizao 领域形状，
 * shared readRows 不覆盖；其余形状委托 shared readRows 解包。
 */
export function readWorkOrderRows(payload : any | null) : Array<UTSJSONObject> {
	if (payload != null && typeof payload == 'object' && !Array.isArray(payload)) {
		const orders = (payload as UTSJSONObject).getArray('work_orders')
		if (orders != null) {
			const list = orders as Array<any>
			const rows : Array<UTSJSONObject> = []
			for (let i = 0; i < list.length; i++) {
				const item = list[i]
				if (item instanceof UTSJSONObject) {
					rows.push(item as UTSJSONObject)
				}
			}
			return rows
		}
	}
	return readRows(payload)
}

export function scanRaw(value : any | null) : string {
	if (value == null) {
		return ''
	}
	if (typeof value == 'string') {
		return (value as string).trim()
	}
	const obj = value as UTSJSONObject
	const result = obj.getString('result')
	if (result != null) {
		return result.trim()
	}
	return ''
}

export function nowIso() : string {
	return new Date().toISOString()
}

export function currentPeriod() : string {
	const now = new Date()
	const month = now.getMonth() + 1
	const monthText = month < 10 ? '0' + month : '' + month
	return now.getFullYear() + '-' + monthText
}

export function toast(title : string) {
	uni.showToast({
		title: title,
		icon: 'none',
	})
}
