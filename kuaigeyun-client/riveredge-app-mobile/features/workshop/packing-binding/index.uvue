<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading && !submitting" :mode="loadSettled ? 'refresh' : 'initial'" />
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<view v-if="detail == null && !packOpen">
			<empty-state v-if="!loading && rows.length == 0 && errorTextValue.length == 0" title="暂无绑定" />
			<action-card v-for="(row, index) in rows" :key="index" @press="openBinding(index)" :disabled="loading || submitting">
				<text class="title">{{ lineTitle(row) }}</text>
				<text class="sub">{{ lineSub(row) }}</text>
			</action-card>
			<action-button label="绑定新箱" tone="primary" @press="openPack" :disabled="loading || submitting" />
		</view>
		<view v-else-if="packOpen">
			<action-button label="返回列表" tone="secondary" @press="closePack" :disabled="loading || submitting" />
			<text class="hint">先选来源单据，再选该单上的产品。箱号可空。</text>
			<text class="label">来源单据</text>
			<view class="kind-row">
				<choice-button label="成品入库单" :selected="sourceKind == 'fg'" @choose="chooseKind(0)" :disabled="loading || submitting" />
				<choice-button label="销售出库单" :selected="sourceKind == 'sales'" @choose="chooseKind(1)" :disabled="loading || submitting" />
			</view>
			<empty-state v-if="sourceKind.length > 0 && sources.length == 0 && !loading" title="没有可选单据" :compact="true" />
			<action-card v-for="(doc, index) in sources" :key="doc.uid" @press="pickSource(index)" :disabled="loading || submitting">
				<text class="title">{{ doc.title }}</text>
				<text class="sub">{{ sourceIndex == index ? '已选' : '点选' }}</text>
			</action-card>
			<view v-if="sourceIndex >= 0">
				<text class="label">产品</text>
				<empty-state v-if="products.length == 0 && !loading" title="这张单没有可绑定的产品" :compact="true" />
				<action-card v-for="(product, index) in products" :key="product.uid" @press="pickProduct(index)" :disabled="loading || submitting">
					<text class="title">{{ product.label }}</text>
					<text class="sub">{{ productIndex == index ? '已选' : '点选' }}</text>
				</action-card>
			</view>
			<text class="label">装箱数量</text>
			<input :disabled="loading || submitting" class="field" :value="packQty" placeholder="必填" @input="onPackQty" />
			<text class="label">箱号（可选）</text>
			<input :disabled="loading || submitting" class="field" :value="boxNo" placeholder="可空" @input="onBoxNo" />
			<action-button label="确认绑定" tone="primary" :busy="submitting" busy-label="绑定中" :disabled="loading || submitting" @press="submitPack" />
		</view>
		<view v-else>
			<action-button label="返回列表" tone="secondary" @press="closeDetail" :disabled="loading || submitting" />
			<text class="title">{{ detailLine('product_code') }} {{ detailLine('product_name') }}</text>
			<text class="sub">箱号 {{ detailLine('box_no') }}</text>
			<text class="sub">数量 {{ detailLine('packing_quantity') }}</text>
			<text class="sub">方式 {{ detailLine('binding_method') }}</text>
			<text class="sub">绑定人 {{ detailLine('bound_by_name') }}</text>
			<text class="sub">绑定时间 {{ detailLine('bound_at') }}</text>
			<text class="sub">备注 {{ detailLine('remarks') }}</text>
		</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../../shared/ui/action-card.uvue'
	import ChoiceButton from '../../../shared/ui/choice-button.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, fieldNumber, firstText, errorText } from '../../../shared/api/fields.uts'
	import { toast } from '../json.uts'
	import EmptyState from '../../../shared/ui/empty-state.uvue'

	type SourceDoc = {
		uid : string
		id : number
		title : string
	}

	type SourceProduct = {
		uid : string
		lineId : number
		materialId : number
		code : string
		name : string
		label : string
	}

	const rows = ref<any[]>([])
	const detail = ref<any | null>(null)
	const loading = ref(false)
	const loadSettled = ref(false)
	const submitting = ref(false)
	const errorTextValue = ref('')
	const packOpen = ref(false)
	const sourceKind = ref('')
	const sources = ref<Array<SourceDoc>>([])
	const sourceIndex = ref(-1)
	const products = ref<Array<SourceProduct>>([])
	const productIndex = ref(-1)
	const packQty = ref('')
	const boxNo = ref('')
	let ticket = 0

	function lineTitle(row : any) : string {
		return fieldText(row, 'product_code') + ' ' + fieldText(row, 'product_name')
	}

	function lineSub(row : any) : string {
		return '箱号 ' + fieldText(row, 'box_no') + '  数量 ' + fieldText(row, 'packing_quantity')
	}

	function detailLine(key : string) : string {
		return fieldText(detail.value, key)
	}

	async function load() {
		if (submitting.value) { return }
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/packing-bindings',
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			rows.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	async function openBinding(index : number) {
		if (loading.value || submitting.value) { return }
		const bindingId = fieldNumber(rows.value[index], 'id')
		if (bindingId <= 0) {
			toast('绑定无效')
			return
		}
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/packing-bindings/' + bindingId,
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			detail.value = payload
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	function closeDetail() {
		if (loading.value || submitting.value) { return }
		detail.value = null
	}

	function listQuery() : UTSJSONObject {
		const query = new UTSJSONObject()
		query.set('skip', '0')
		query.set('limit', '50')
		return query
	}

	function sourcePath() : string {
		if (sourceKind.value == 'sales') {
			return '/api/v1/apps/kuaizhizao/sales-deliveries'
		}
		return '/api/v1/apps/kuaizhizao/finished-goods-receipts'
	}

	function resetProducts() {
		sourceIndex.value = -1
		products.value = []
		productIndex.value = -1
	}

	function openPack() {
		if (loading.value || submitting.value) { return }
		packOpen.value = true
		errorTextValue.value = ''
		sourceKind.value = ''
		sources.value = []
		packQty.value = ''
		boxNo.value = ''
		resetProducts()
	}

	function closePack() {
		if (loading.value || submitting.value) { return }
		packOpen.value = false
	}

	async function chooseKind(index : number) {
		if (loading.value || submitting.value) { return }
		sourceKind.value = index == 0 ? 'fg' : 'sales'
		resetProducts()
		errorTextValue.value = ''
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		try {
			const payload = await request({
				method: 'GET',
				path: sourcePath(),
				query: listQuery(),
				body: null,
			})
			if (ticket != mine) {
				return
			}
			const list = readRows(payload)
			const next : Array<SourceDoc> = []
			for (let i = 0; i < list.length; i++) {
				const row = list[i]
				const id = fieldNumber(row, 'id')
				if (id <= 0) {
					continue
				}
				const title = firstText(row, ['receipt_code', 'delivery_code', 'code'])
				next.push({
					uid: id.toString(),
					id: id,
					title: title.length > 0 ? title : '单据'
				} as SourceDoc)
			}
			sources.value = next
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	async function pickSource(index : number) {
		if (loading.value || submitting.value) { return }
		sourceIndex.value = index
		productIndex.value = -1
		errorTextValue.value = ''
		const doc = sources.value[index]
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		try {
			const payload = await request({
				method: 'GET',
				path: sourcePath() + '/' + doc.id,
				query: null,
				body: null,
			})
			const list = readRows(payload)
			const next : Array<SourceProduct> = []
			for (let i = 0; i < list.length; i++) {
				const row = list[i]
				const materialId = fieldNumber(row, 'material_id')
				if (materialId <= 0) {
					continue
				}
				const code = fieldText(row, 'material_code')
				const name = fieldText(row, 'material_name')
				let label = code
				if (name.length > 0) {
					label = code.length > 0 ? code + ' ' + name : name
				}
				next.push({
					uid: materialId.toString() + '-' + i.toString(),
					lineId: fieldNumber(row, 'id'),
					materialId: materialId,
					code: code,
					name: name,
					label: label.length > 0 ? label : '产品'
				} as SourceProduct)
			}
			if (ticket != mine) {
				return
			}
			products.value = next
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	function pickProduct(index : number) {
		if (loading.value || submitting.value) { return }
		productIndex.value = index
	}

	function onPackQty(event : UniInputEvent) {
		if (loading.value || submitting.value) { return }
		packQty.value = event.detail.value
	}

	function onBoxNo(event : UniInputEvent) {
		if (loading.value || submitting.value) { return }
		boxNo.value = event.detail.value
	}

	async function submitPack() {
		if (loading.value || submitting.value) { return }
		if (loading.value) {
			return
		}
		if (sourceIndex.value < 0) {
			errorTextValue.value = '请选择来源单据'
			return
		}
		if (productIndex.value < 0) {
			errorTextValue.value = '请选择产品'
			return
		}
		const qty = parseFloat(packQty.value.trim())
		if (isNaN(qty) || qty <= 0) {
			errorTextValue.value = '请填写装箱数量'
			return
		}
		const doc = sources.value[sourceIndex.value]
		const product = products.value[productIndex.value]
		if (product.materialId <= 0) {
			errorTextValue.value = '这行没有产品，不能绑定'
			return
		}
		const body = new UTSJSONObject()
		body.set('product_id', product.materialId)
		if (product.code.length > 0) {
			body.set('product_code', product.code)
		}
		if (product.name.length > 0) {
			body.set('product_name', product.name)
		}
		if (product.lineId > 0) {
			body.set('source_line_id', product.lineId)
		}
		body.set('packing_quantity', qty)
		const box = boxNo.value.trim()
		if (box.length > 0) {
			body.set('box_no', box)
		}
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		submitting.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: sourcePath() + '/' + doc.id + '/packing-binding',
				query: null,
				body: body,
			})
			if (ticket != mine) {
				return
			}
			toast('已绑定')
			submitting.value = false
			loading.value = false
			closePack()
			await load()
			return
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		submitting.value = false
		loading.value = false
		loadSettled.value = true
	}

	onBackPress((options : OnBackPressOptions) : boolean | null => {
		if (options.from != 'backbutton' && options.from != 'navigateBack') {
			return false
		}
		if (packOpen.value) {
			closePack()
			return true
		}
		if (detail.value != null) {
			closeDetail()
			return true
		}
		return false
	})

	onLoad(() => {
		load()
	})
</script>

<style>
	.kind-row {
		flex-direction: row;
		flex-wrap: wrap;
	}
</style>


