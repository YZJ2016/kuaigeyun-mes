<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading && loadMode != 'more'" :mode="loadMode" />
		<date-field label="绩效月份" v-model="pickedDate" :disabled="loading" />
		<text class="hint">{{ period.length > 0 ? '周期 ' + period + '（所选日期所在月，可清除查看全部）' : '周期 全部月份' }}</text>
		<action-button label="刷新" tone="secondary" :disabled="loading" @press="refreshList" />
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<action-button label="重试" tone="secondary" v-if="errorTextValue.length > 0" :disabled="loading" @press="retry" />
		<empty-state v-if="!loading && rows.length == 0 && errorTextValue.length == 0" title="暂无绩效" />
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
		</view>
		<load-feedback :active="loading && loadMode == 'more'" mode="more" />
		<text v-if="total > 0" class="list-count">已显示 {{ rows.length }} / 共 {{ total }} 条</text>
		<action-button label="加载更多" tone="secondary" v-if="rows.length < total" :disabled="loading" @press="loadMore" />
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import DateField from '../../../shared/ui/date-field.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, fieldNumber, errorText } from '../../../shared/api/fields.uts'
	import { currentPeriod } from '../json.uts'
	import { readCurrentUser } from '../session.uts'
	import EmptyState from '../../../shared/ui/empty-state.uvue'

	const pageSize = 20
	const period = ref('')
	const pickedDate = ref('')
	const rows = ref<any[]>([])
	const loading = ref(false)
	const listLoaded = ref(false)
	const loadMode = ref('initial')
	const errorTextValue = ref('')
	const total = ref(0)
	let ticket = 0

	function lineTitle(row : any) : string {
		return fieldText(row, 'employee_name') + ' ' + fieldText(row, 'period')
	}

	function lineSub(row : any) : string {
		return '工时 ' + fieldText(row, 'total_hours') + '  件数 ' + fieldText(row, 'total_pieces') + '  金额 ' + fieldText(row, 'total_amount') + '  ' + fieldText(row, 'status')
	}

	watch((): string => pickedDate.value, (value : string) => {
		const next = value.length >= 7 ? value.substring(0, 7) : ''
		if (next == period.value) {
			return
		}
		period.value = next
		load()
	})

	async function load(append : boolean = false) {
		const user = readCurrentUser()
		if (user == null || user.id <= 0) {
			errorTextValue.value = '未获取到当前用户'
			return
		}
		const mine = ticket + 1
		ticket = mine
		loadMode.value = append ? 'more' : listLoaded.value ? 'refresh' : 'initial'
		loading.value = true
		errorTextValue.value = ''
		const query = new UTSJSONObject()
		if (period.value.length > 0) {
			query.set('period', period.value)
		}
		query.set('employee_id', user.id)
		query.set('skip', append ? rows.value.length : 0)
		query.set('limit', pageSize)
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/master-data/performance/summaries',
				query: query,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			const incoming = readRows(payload)
			if (append) {
				rows.value = rows.value.concat(incoming)
			} else {
				rows.value = incoming
			}
			total.value = fieldNumber(payload, 'total')
			listLoaded.value = true
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	async function refreshList() { await load(false) }

	async function loadMore() {
		if (loading.value || rows.value.length >= total.value) { return }
		await load(true)
	}

	// 追加失败不提交位置，重试仍请求同一页
	function retry() {
		load(loadMode.value == 'more')
	}

	onLoad(() => {
		period.value = currentPeriod()
		pickedDate.value = period.value + '-01'
		load()
	})
</script>

