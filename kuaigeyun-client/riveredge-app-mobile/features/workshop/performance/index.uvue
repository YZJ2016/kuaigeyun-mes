<template>
	<view class="page">
		<home-link />
		<text class="hint">周期 {{ period }}</text>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="loading" class="loading">加载中</text>
		<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="empty">暂无绩效</text>
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, errorText } from '../../../shared/api/fields.uts'
	import { currentPeriod } from '../json.uts'
	import { readCurrentUser } from '../session.uts'

	const period = ref('')
	const rows = ref<any[]>([])
	const loading = ref(false)
	const errorTextValue = ref('')

	function lineTitle(row : any) : string {
		return fieldText(row, 'employee_name') + ' ' + fieldText(row, 'period')
	}

	function lineSub(row : any) : string {
		return '工时 ' + fieldText(row, 'total_hours') + '  件数 ' + fieldText(row, 'total_pieces') + '  金额 ' + fieldText(row, 'total_amount') + '  ' + fieldText(row, 'status')
	}

	async function load() {
		loading.value = true
		errorTextValue.value = ''
		const user = readCurrentUser()
		if (user == null || user.id <= 0) {
			errorTextValue.value = '未获取到当前用户'
			loading.value = false
			return
		}
		const query = new UTSJSONObject()
		query.set('period', period.value)
		query.set('employee_id', user.id)
		query.set('skip', 0)
		query.set('limit', 100)
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/master-data/performance/summaries',
				query: query,
				body: null,
			})
			rows.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	onLoad(() => {
		period.value = currentPeriod()
		load()
	})
</script>


