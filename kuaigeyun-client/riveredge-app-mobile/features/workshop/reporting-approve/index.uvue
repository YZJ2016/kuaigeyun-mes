<template>
	<view class="page">
		<home-link />
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="loading" class="loading">加载中</text>
		<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="empty">暂无报工</text>
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
			<button class="btn-primary" @click="approve(index)">审核</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, fieldNumber, errorText } from '../../../shared/api/fields.uts'
	import { toast } from '../json.uts'

	const rows = ref<any[]>([])
	const loading = ref(false)
	const errorTextValue = ref('')

	function lineTitle(row : any) : string {
		return fieldText(row, 'work_order_code') + ' ' + fieldText(row, 'operation_name')
	}

	function lineSub(row : any) : string {
		return fieldText(row, 'worker_name') + '  数量 ' + fieldText(row, 'reported_quantity') + '  ' + fieldText(row, 'status')
	}

	async function load() {
		loading.value = true
		errorTextValue.value = ''
		const query = new UTSJSONObject()
		query.set('status', 'pending')
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/reporting',
				query: query,
				body: null,
			})
			rows.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	async function approve(index : number) {
		const recordId = fieldNumber(rows.value[index], 'id')
		if (recordId <= 0) {
			toast('报工记录无效')
			return
		}
		loading.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/reporting/' + recordId + '/approve',
				query: null,
				body: null,
			})
			toast('已审核')
			await load()
		} catch (err) {
			errorTextValue.value = errorText(err)
			loading.value = false
		}
	}

	onLoad(() => {
		load()
	})
</script>


