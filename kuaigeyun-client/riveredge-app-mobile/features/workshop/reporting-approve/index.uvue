<template>
	<view class="page">
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="loading" class="hint">加载中</text>
		<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="hint">暂无报工</text>
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
			<button class="action" @click="approve(index)">审核</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { request } from '../../../shared/api/index.uts'
	import { readRows, textOf, fieldNumber, errorText, toast } from '../json.uts'

	const rows = ref<any[]>([])
	const loading = ref(false)
	const errorTextValue = ref('')

	function lineTitle(row : any) : string {
		return textOf(row, 'work_order_code') + ' ' + textOf(row, 'operation_name')
	}

	function lineSub(row : any) : string {
		return textOf(row, 'worker_name') + '  数量 ' + textOf(row, 'reported_quantity') + '  ' + textOf(row, 'status')
	}

	async function load() {
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/reporting',
				query: null,
				body: null,
			})
			rows.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	async function approve(index : number) {
		const recordId = fieldNumber(rows.value[index], 'id')
		if (recordId <= 0) {
			toast('报工记录无效')
			return
		}
		loading.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/reporting/' + recordId + '/approve',
				query: null,
				body: null,
			})
			toast('已审核')
			await load()
		} catch (err) {
			errorTextValue.value = errorText(err)
			loading.value = false
		}
	}

	onLoad(() => {
		load()
	})
</script>

<style>
	.page {
		flex-direction: column;
		padding: 12px;
	}

	.hint {
		font-size: 14px;
		color: #888B9D;
		margin-bottom: 8px;
	}

	.error {
		font-size: 14px;
		color: #FF4942;
		margin-bottom: 8px;
	}

	.card {
		flex-direction: column;
		padding: 12px;
		margin-bottom: 8px;
		background-color: #ffffff;
		border-radius: 16px;
	}

	.title {
		font-size: 16px;
	}

	.sub {
		font-size: 13px;
		color: #888B9D;
		margin-top: 4px;
	}

	.action {
		margin-top: 8px;
	}
</style>
