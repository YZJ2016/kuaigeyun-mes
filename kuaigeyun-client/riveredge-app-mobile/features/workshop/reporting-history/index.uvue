<template>
	<view class="page-shell">
		<home-link />
	<view class="page">
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="!loading && rows.length == 0 && errorTextValue.length == 0" class="empty">暂无报工</text>
		<view v-for="(row, index) in rows" :key="index" class="card">
			<text class="title">{{ lineTitle(row) }}</text>
			<text class="sub">{{ lineSub(row) }}</text>
		</view>
	</view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, errorText } from '../../../shared/api/fields.uts'
	import { readCurrentUser } from '../session.uts'

	const rows = ref<any[]>([])
	const loading = ref(false)
	const errorTextValue = ref('')
	let ticket = 0

	function lineTitle(row : any) : string {
		return fieldText(row, 'work_order_code') + ' ' + fieldText(row, 'operation_name')
	}

	function lineSub(row : any) : string {
		return '数量 ' + fieldText(row, 'reported_quantity') + '  ' + fieldText(row, 'status')
	}

	async function load() {
		const user = readCurrentUser()
		if (user == null) {
			errorTextValue.value = '未找到当前用户'
			return
		}
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		const query = new UTSJSONObject()
		query.set('worker_id', user.id)
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/reporting',
				query: query,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			rows.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	onLoad(() => {
		load()
	})
</script>


