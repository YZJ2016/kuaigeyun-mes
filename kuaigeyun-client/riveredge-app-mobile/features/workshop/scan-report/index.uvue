<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<load-feedback :active="loading && !submitting" mode="refresh" label="正在读取工单与工序" />
		<text class="hint">报工人员 {{ workerName }}</text>
		<action-button label="扫码工单" tone="primary" :disabled="loading || submitting" @press="onScan" />
		<text class="hint">扫码不可用时，可输入或粘贴工单编码。</text>
		<text class="label">工单编码或扫码内容</text>
		<input class="field" v-model="manualCode" :disabled="loading || submitting" placeholder="输入或粘贴编码" />
		<action-button label="查询工单" tone="secondary" :disabled="loading || submitting" @press="resolveManual" />
		<view v-if="successText.length > 0" class="card">
			<text class="title">报工已提交</text><text class="sub">{{ successText }}</text>
			<action-button label="查看我的报工" tone="secondary" :disabled="loading || submitting" @press="openHistory" />
		</view>
		<text v-if="codeText.length > 0" class="hint">扫码内容 {{ codeText }}</text>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<action-card v-for="(row, index) in orders" :key="index" @press="pickOrder(index)" :disabled="loading || submitting">
			<text class="title">{{ orderTitle(row) }}</text>
			<text class="sub">{{ orderSub(row) }}</text>
		</action-card>
		<view v-if="selectedOrder != null">
			<text class="section">选择工序</text>
			<action-card v-for="(row, index) in operations" :key="index" @press="pickOperation(index)" :disabled="loading || submitting">
				<text class="title">{{ operationTitle(row) }}</text>
				<text class="sub">{{ selectedOperationIndex == index ? '已选' : '点选' }}</text>
			</action-card>
			<text class="label">报工数量</text><input class="field" type="digit" v-model="reportedQuantity" :disabled="loading || submitting" /><text v-if="reportedError.length > 0" class="error">{{ reportedError }}</text>
			<text class="label">不合格数量</text><input class="field" type="digit" v-model="unqualifiedQuantity" :disabled="loading || submitting" /><text v-if="unqualifiedError.length > 0" class="error">{{ unqualifiedError }}</text>
			<text class="hint">合格数量 {{ qualifiedPreview.length > 0 ? qualifiedPreview : '自动计算' }}</text>
			<text class="label">工时（小时）</text><input class="field" type="digit" v-model="workHours" :disabled="loading || submitting" /><text v-if="hoursError.length > 0" class="error">{{ hoursError }}</text>
			<action-button label="提交报工" tone="primary" :busy="submitting" busy-label="提交中" :disabled="loading || submitting" @press="submitReport" />
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../../shared/ui/load-feedback.uvue'
	import ActionCard from '../../../shared/ui/action-card.uvue'
	import ActionButton from '../../../shared/ui/action-button.uvue'
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { scan } from '../../../shared/channel/index.uts'
	import { readRows, fieldText, fieldNumber, errorText, firstText } from '../../../shared/api/fields.uts'
	import { scanRaw, nowIso, toast, readWorkOrderRows } from '../json.uts'
	import { readCurrentUser } from '../session.uts'

	const workerName = ref('')
	const codeText = ref('')
	const errorTextValue = ref('')
	const loading = ref(false)
	const loadSettled = ref(false)
	const orders = ref<any[]>([])
	const operations = ref<any[]>([])
	const selectedOrder = ref<any | null>(null)
	const selectedOperationIndex = ref(-1)
	const reportedQuantity = ref('')
	const unqualifiedQuantity = ref('')
	const workHours = ref('')
	const submitting = ref(false)
	const manualCode = ref('')
	const successText = ref('')
	const reportedError = ref('')
	const unqualifiedError = ref('')
	const hoursError = ref('')
	let ticket = 0

	function clearQuantities() {
		reportedQuantity.value = ''
		unqualifiedQuantity.value = ''
		workHours.value = ''
		reportedError.value = ''
		unqualifiedError.value = ''
		hoursError.value = ''
	}
	function openHistory() {
		if (loading.value || submitting.value) { return }
		uni.navigateTo({ url: '/features/workshop/reporting-history/index' })
	}
	async function resolveManual() {
		if (loading.value || submitting.value) { return }
		await resolveCode(manualCode.value.trim())
	}

	function orderTitle(row : any) : string {
		return firstText(row, ['code', 'name'])
	}

	function orderSub(row : any) : string {
		return firstText(row, ['name', 'product_name', 'status'])
	}

	function operationTitle(row : any) : string {
		const name = fieldText(row, 'operation_name')
		const code = fieldText(row, 'operation_code')
		if (code.length > 0) {
			return code + ' ' + name
		}
		return name
	}

	async function onScan() {
		if (loading.value || submitting.value) return
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		try {
			const raw = scanRaw(await scan())
			if (ticket != mine) {
				return
			}
			await resolveCode(raw)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = '扫码未完成，请重试或输入工单编码'
			loading.value = false
		}
	}
	async function resolveCode(raw : string) {
		if (submitting.value) return
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		if (raw.trim().length == 0) {
			errorTextValue.value = '请输入工单编码或扫码内容'
			if (ticket != mine) {
				return
			}
			loading.value = false
			return
		}
		errorTextValue.value = ''
		successText.value = ''
		selectedOrder.value = null
		operations.value = []
		orders.value = []
		selectedOperationIndex.value = -1
		clearQuantities()
		try {
			const body = new UTSJSONObject()
			body.set('raw', raw.trim())
			const payload = await request({ method: 'POST', path: '/api/v1/apps/kuaizhizao/work-orders/resolve-by-scan', query: null, body: body })
			if (ticket != mine) {
				return
			}
			codeText.value = raw.trim()
			orders.value = readWorkOrderRows(payload)
			if (orders.value.length == 0) errorTextValue.value = '没有找到可报工的工单，请核对编码'
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	async function pickOrder(index : number) {
		if (submitting.value || index < 0 || index >= orders.value.length) return
		const row = orders.value[index]
		clearQuantities()
		selectedOrder.value = row
		selectedOperationIndex.value = -1
		operations.value = []
		errorTextValue.value = ''
		const workOrderId = fieldNumber(row, 'id')
		if (workOrderId <= 0) {
			toast('工单无效')
			return
		}
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders/' + workOrderId + '/operations',
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			operations.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
		loadSettled.value = true
	}

	function pickOperation(index : number) {
		if (loading.value || submitting.value) return
		selectedOperationIndex.value = index
	}

	function quantityValue(raw : string) : number {
		const text = raw.trim()
		if (!/^(?:\d+(?:\.\d*)?|\.\d+)$/.test(text)) return -1
		const value = Number(text)
		return isFinite(value) && value >= 0 ? value : -1
	}

	const qualifiedPreview = computed((): string => {
		const reported = quantityValue(reportedQuantity.value)
		const unqualified = quantityValue(unqualifiedQuantity.value)
		if (reported < 0 || unqualified < 0 || unqualified > reported) {
			return ''
		}
		return '' + (reported - unqualified)
	})

	function requiredNumber(raw : string, label : string) : number | null {
		const value = quantityValue(raw)
		const message = value < 0 ? '请填写有效的非负' + label : ''
		if (label == '报工数量') reportedError.value = message
		if (label == '不合格数量') unqualifiedError.value = message
		if (label == '工时') hoursError.value = message
		return value < 0 ? null : value
	}

	async function submitReport() {
		if (submitting.value || loading.value) {
			return
		}
		const user = readCurrentUser()
		if (user == null) {
			toast('未找到当前用户')
			return
		}
		const order = selectedOrder.value
		if (order == null || selectedOperationIndex.value < 0) {
			toast('请选择工单和工序')
			return
		}
		const operation = operations.value[selectedOperationIndex.value]
		if (fieldNumber(operation, 'operation_id') <= 0) {
			toast('工序无效')
			return
		}
		const reported = requiredNumber(reportedQuantity.value, '报工数量')
		const unqualified = requiredNumber(unqualifiedQuantity.value, '不合格数量')
		const hours = requiredNumber(workHours.value, '工时')
		if (reported == null || unqualified == null || hours == null) {
			return
		}
		if (unqualified > reported) {
			unqualifiedError.value = '不合格数量不能大于报工数量'
			return
		}
		const qualified = reported - unqualified
		const body = new UTSJSONObject()
		body.set('work_order_id', fieldNumber(order, 'id'))
		body.set('work_order_code', fieldText(order, 'code'))
		body.set('work_order_name', fieldText(order, 'name'))
		body.set('operation_id', fieldNumber(operation, 'operation_id'))
		body.set('operation_code', fieldText(operation, 'operation_code'))
		body.set('operation_name', fieldText(operation, 'operation_name'))
		body.set('worker_id', user.id)
		body.set('worker_name', user.name)
		body.set('reported_quantity', reported)
		body.set('qualified_quantity', qualified)
		body.set('unqualified_quantity', unqualified)
		body.set('work_hours', hours)
		body.set('reported_at', nowIso())
		loading.value = true
		submitting.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/reporting/quick',
				query: null,
				body: body,
			})
			successText.value = fieldText(order, 'code') + ' · ' + operationTitle(operation) + ' · 合格 ' + qualified + ' · 不合格 ' + unqualified + ' · 工时 ' + hours + ' 小时'
			toast('报工已提交')
			selectedOrder.value = null
			operations.value = []
			selectedOperationIndex.value = -1
			reportedQuantity.value = ''
			unqualifiedQuantity.value = ''
			workHours.value = ''
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		submitting.value = false
		loading.value = false
		loadSettled.value = true
	}

	async function openById(workOrderId : number) {
		const mine = ticket + 1
		ticket = mine
		errorTextValue.value = ''
		loading.value = true
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders/' + workOrderId,
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			if (fieldNumber(payload, 'id') <= 0) {
				errorTextValue.value = '没有这张工单'
				loading.value = false
				return
			}
			const list : any[] = []
			list.push(payload)
			orders.value = list
			await pickOrder(0)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			loading.value = false
			errorTextValue.value = errorText(err)
		}
	}

	onLoad((options : OnLoadOptions) => {
		const user = readCurrentUser()
		if (user == null) {
			workerName.value = '未找到当前用户'
		} else {
			workerName.value = user.name
		}
		const raw = options['workOrderId']
		if (raw == null) {
			return
		}
		const workOrderId = parseInt(('' + raw).trim())
		if (isNaN(workOrderId) || workOrderId <= 0) {
			return
		}
		void openById(workOrderId)
	})
</script>

<style>
	.section {
		margin-top: 12px;
	}
</style>
