<template>
	<view class="page">
		<text class="hint">报工人员 {{ workerName }}</text>
		<button class="action" @click="onScan">扫码</button>
		<text v-if="codeText.length > 0" class="hint">扫码内容 {{ codeText }}</text>
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<text v-if="loading" class="hint">加载中</text>
		<view v-for="(row, index) in orders" :key="index" class="card" @click="pickOrder(index)">
			<text class="title">{{ orderTitle(row) }}</text>
			<text class="sub">{{ orderSub(row) }}</text>
		</view>
		<view v-if="selectedOrder != null">
			<text class="section">选择工序</text>
			<view v-for="(row, index) in operations" :key="index" class="card" @click="pickOperation(index)">
				<text class="title">{{ operationTitle(row) }}</text>
				<text class="sub">{{ selectedOperationIndex == index ? '已选' : '点选' }}</text>
			</view>
			<input class="field" v-model="reportedQuantity" placeholder="报工数量" />
			<input class="field" v-model="qualifiedQuantity" placeholder="合格数量" />
			<input class="field" v-model="unqualifiedQuantity" placeholder="不合格数量" />
			<input class="field" v-model="workHours" placeholder="工时（小时）" />
			<button class="action" @click="submitReport">提交报工</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { request } from '../../../shared/api/index.uts'
	import { scan } from '../../../shared/channel/index.uts'
	import { readRows, textOf, fieldNumber, errorText, scanRaw, nowIso, toast, firstText } from '../json.uts'
	import { readCurrentUser } from '../session.uts'

	const workerName = ref('')
	const codeText = ref('')
	const errorTextValue = ref('')
	const loading = ref(false)
	const orders = ref<any[]>([])
	const operations = ref<any[]>([])
	const selectedOrder = ref<any | null>(null)
	const selectedOperationIndex = ref(-1)
	const reportedQuantity = ref('')
	const qualifiedQuantity = ref('')
	const unqualifiedQuantity = ref('')
	const workHours = ref('')

	function orderTitle(row : any) : string {
		return firstText(row, ['code', 'name'])
	}

	function orderSub(row : any) : string {
		return firstText(row, ['name', 'product_name', 'status'])
	}

	function operationTitle(row : any) : string {
		const name = textOf(row, 'operation_name')
		const code = textOf(row, 'operation_code')
		if (code.length > 0) {
			return code + ' ' + name
		}
		return name
	}

	async function onScan() {
		errorTextValue.value = ''
		selectedOrder.value = null
		operations.value = []
		selectedOperationIndex.value = -1
		try {
			const raw = scanRaw(await scan())
			if (raw.length == 0) {
				toast('没有扫到内容')
				return
			}
			codeText.value = raw
			loading.value = true
			const body = new UTSJSONObject()
			body.set('raw', raw)
			const payload = await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/work-orders/resolve-by-scan',
				query: null,
				body: body,
			})
			orders.value = readRows(payload)
			if (!(payload instanceof Array)) {
				const message = (payload as UTSJSONObject).getString('message')
				if (orders.value.length == 0 && message != null && message.length > 0) {
					errorTextValue.value = message
				}
			}
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	async function pickOrder(index : number) {
		const row = orders.value[index]
		selectedOrder.value = row
		selectedOperationIndex.value = -1
		operations.value = []
		errorTextValue.value = ''
		const workOrderId = fieldNumber(row, 'id')
		if (workOrderId <= 0) {
			toast('工单无效')
			return
		}
		loading.value = true
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders/' + workOrderId + '/operations',
				query: null,
				body: null,
			})
			operations.value = readRows(payload)
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	function pickOperation(index : number) {
		selectedOperationIndex.value = index
	}

	function requiredNumber(raw : string, label : string) : number | null {
		const text = raw.trim()
		if (text.length == 0) {
			toast('请填写' + label)
			return null
		}
		const value = parseFloat(text)
		if (isNaN(value)) {
			toast(label + '不是数字')
			return null
		}
		return value
	}

	async function submitReport() {
		const user = readCurrentUser()
		if (user == null) {
			toast('未找到当前用户')
			return
		}
		const order = selectedOrder.value
		if (order == null || selectedOperationIndex.value < 0) {
			toast('请选择工单和工序')
			return
		}
		const operation = operations.value[selectedOperationIndex.value]
		if (fieldNumber(operation, 'operation_id') <= 0) {
			toast('工序无效')
			return
		}
		const reported = requiredNumber(reportedQuantity.value, '报工数量')
		const qualified = requiredNumber(qualifiedQuantity.value, '合格数量')
		const unqualified = requiredNumber(unqualifiedQuantity.value, '不合格数量')
		const hours = requiredNumber(workHours.value, '工时')
		if (reported == null || qualified == null || unqualified == null || hours == null) {
			return
		}
		const body = new UTSJSONObject()
		body.set('work_order_id', fieldNumber(order, 'id'))
		body.set('work_order_code', textOf(order, 'code'))
		body.set('work_order_name', textOf(order, 'name'))
		body.set('operation_id', fieldNumber(operation, 'operation_id'))
		body.set('operation_code', textOf(operation, 'operation_code'))
		body.set('operation_name', textOf(operation, 'operation_name'))
		body.set('worker_id', user.id)
		body.set('worker_name', user.name)
		body.set('reported_quantity', reported)
		body.set('qualified_quantity', qualified)
		body.set('unqualified_quantity', unqualified)
		body.set('work_hours', hours)
		body.set('reported_at', nowIso())
		loading.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/reporting/quick',
				query: null,
				body: body,
			})
			toast('报工已提交')
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	onLoad(() => {
		const user = readCurrentUser()
		if (user == null) {
			workerName.value = '未找到当前用户'
			return
		}
		workerName.value = user.name
	})
</script>

<style>
	.page {
		flex-direction: column;
		padding: 12px;
	}

	.hint {
		font-size: 14px;
		color: #888B9D;
		margin-bottom: 8px;
	}

	.error {
		font-size: 14px;
		color: #FF4942;
		margin-bottom: 8px;
	}

	.section {
		font-size: 16px;
		margin-top: 12px;
		margin-bottom: 8px;
	}

	.card {
		flex-direction: column;
		padding: 12px;
		margin-bottom: 8px;
		background-color: #ffffff;
		border-radius: 16px;
	}

	.title {
		font-size: 16px;
	}

	.sub {
		font-size: 13px;
		color: #888B9D;
		margin-top: 4px;
	}

	.field {
		margin-top: 8px;
		padding: 8px;
		background-color: #ffffff;
	}

	.action {
		margin-top: 8px;
		margin-bottom: 8px;
	}
</style>
