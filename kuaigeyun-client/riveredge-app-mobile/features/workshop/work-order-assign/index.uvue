<template>
	<view class="page-shell">
		<home-link />
	<view class="page">
		<text v-if="errorTextValue.length > 0" class="error">{{ errorTextValue }}</text>
		<view v-if="selectedOrder == null">
			<text class="section">选择工单</text>
			<view v-for="(row, index) in orders" :key="index" class="card" hover-class="pressed" @click="pickOrder(index)">
				<text class="title">{{ orderTitle(row) }}</text>
				<text class="sub">{{ orderStatus(row) }}</text>
			</view>
		</view>
		<view v-if="selectedOrder != null && selectedOperation == null">
			<button class="btn-secondary" @click="clearOrder">返回工单</button>
			<text class="section">选择工序</text>
			<view v-for="(row, index) in operations" :key="index" class="card" hover-class="pressed" @click="pickOperation(index)">
				<text class="title">{{ operationTitle(row) }}</text>
			</view>
		</view>
		<view v-if="selectedOperation != null">
			<button class="btn-secondary" @click="clearOperation">返回工序</button>
			<view class="modes">
				<button class="btn-chip" @click="setMode('worker')">指派给人员</button>
				<button class="btn-chip" @click="setMode('team')">指派给小组</button>
			</view>
			<view v-if="mode == 'worker'">
				<view v-for="(row, index) in workers" :key="index" class="card" hover-class="pressed" @click="toggleWorker(index)">
					<text class="title">{{ workerTitle(row) }}</text>
					<text class="sub">{{ workerMarked(row) }}</text>
				</view>
			</view>
			<view v-else>
				<view v-for="(row, index) in teams" :key="index" class="card" hover-class="pressed" @click="pickTeam(index)">
					<text class="title">{{ fieldText(row, 'name') }}</text>
					<text class="sub">{{ selectedTeamIndex == index ? '已选' : '点选' }}</text>
				</view>
			</view>
			<input class="field" v-model="remarks" placeholder="备注（可空）" />
			<button class="btn-primary" @click="submitDispatch">指派</button>
		</view>
	</view>
		<view v-if="loading" class="loading-mask">
			<view class="loading-card">
				<text class="loading">加载中</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../../shared/ui/home-link.uvue'
	import { request } from '../../../shared/api/index.uts'
	import { readRows, fieldText, fieldNumber, errorText, firstText } from '../../../shared/api/fields.uts'
	import { toast } from '../json.uts'

	const orders = ref<any[]>([])
	const operations = ref<any[]>([])
	const workers = ref<any[]>([])
	const teams = ref<any[]>([])
	const selectedOrder = ref<any | null>(null)
	const selectedOperation = ref<any | null>(null)
	const selectedWorkerIds = ref<number[]>([])
	const selectedTeamIndex = ref(-1)
	const mode = ref('worker')
	const remarks = ref('')
	const loading = ref(false)
	const errorTextValue = ref('')
	let ticket = 0

	function orderTitle(row : any) : string {
		return fieldText(row, 'code') + ' ' + fieldText(row, 'name')
	}

	function orderStatus(row : any) : string {
		return fieldText(row, 'status')
	}

	function operationTitle(row : any) : string {
		return fieldText(row, 'operation_code') + ' ' + fieldText(row, 'operation_name')
	}

	function workerTitle(row : any) : string {
		return firstText(row, ['full_name', 'username', 'label'])
	}

	function workerMarked(row : any) : string {
		if (containsId(selectedWorkerIds.value, fieldNumber(row, 'id'))) {
			return '已选'
		}
		return '点选'
	}

	function containsId(ids : number[], id : number) : boolean {
		for (let i = 0; i < ids.length; i++) {
			if (ids[i] == id) {
				return true
			}
		}
		return false
	}

	async function loadOrders() {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders',
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			orders.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	async function pickOrder(index : number) {
		const row = orders.value[index]
		const workOrderId = fieldNumber(row, 'id')
		if (workOrderId <= 0) {
			toast('工单无效')
			return
		}
		selectedOrder.value = row
		selectedOperation.value = null
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/work-orders/' + workOrderId + '/operations',
				query: null,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			operations.value = readRows(payload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	async function pickOperation(index : number) {
		selectedOperation.value = operations.value[index]
		selectedWorkerIds.value = []
		selectedTeamIndex.value = -1
		await loadAssignees()
	}

	function clearOrder() {
		selectedOrder.value = null
		selectedOperation.value = null
		operations.value = []
	}

	function clearOperation() {
		selectedOperation.value = null
	}

	function setMode(next : string) {
		mode.value = next
	}

	async function loadAssignees() {
		const mine = ticket + 1
		ticket = mine
		loading.value = true
		errorTextValue.value = ''
		try {
			const userQuery = new UTSJSONObject()
			userQuery.set('is_active', true)
			userQuery.set('page_size', 200)
			const teamQuery = new UTSJSONObject()
			teamQuery.set('is_active', true)
			teamQuery.set('limit', 200)
			const userPayload = await request({
				method: 'GET',
				path: '/api/v1/core/users/display-search',
				query: userQuery,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			const teamPayload = await request({
				method: 'GET',
				path: '/api/v1/apps/master-data/factory/work-groups',
				query: teamQuery,
				body: null,
			})
			if (ticket != mine) {
				return
			}
			workers.value = readRows(userPayload)
			teams.value = readRows(teamPayload)
		} catch (err) {
			if (ticket != mine) {
				return
			}
			errorTextValue.value = errorText(err)
		}
		if (ticket != mine) {
			return
		}
		loading.value = false
	}

	function toggleWorker(index : number) {
		const id = fieldNumber(workers.value[index], 'id')
		if (id <= 0) {
			return
		}
		const next : number[] = []
		let found = false
		const current = selectedWorkerIds.value
		for (let i = 0; i < current.length; i++) {
			if (current[i] == id) {
				found = true
			} else {
				next.push(current[i])
			}
		}
		if (!found) {
			next.push(id)
		}
		selectedWorkerIds.value = next
	}

	function pickTeam(index : number) {
		selectedTeamIndex.value = index
	}

	function workerNames(ids : number[]) : string {
		const names : string[] = []
		for (let i = 0; i < ids.length; i++) {
			for (let j = 0; j < workers.value.length; j++) {
				if (fieldNumber(workers.value[j], 'id') == ids[i]) {
					const name = firstText(workers.value[j], ['full_name', 'username'])
					if (name.length > 0) {
						names.push(name)
					}
				}
			}
		}
		return names.join('、')
	}

	async function submitDispatch() {
		const order = selectedOrder.value
		const operation = selectedOperation.value
		if (order == null || operation == null) {
			toast('请选择工单和工序')
			return
		}
		const workOrderId = fieldNumber(order, 'id')
		const operationRowId = fieldNumber(operation, 'id')
		if (workOrderId <= 0 || operationRowId <= 0) {
			toast('工序无效')
			return
		}
		const body = new UTSJSONObject()
		if (mode.value == 'team') {
			if (selectedTeamIndex.value < 0) {
				toast('请选择小组')
				return
			}
			const team = teams.value[selectedTeamIndex.value]
			body.set('assigned_team_id', fieldNumber(team, 'id'))
			body.set('assigned_team_name', fieldText(team, 'name'))
		} else {
			const ids = selectedWorkerIds.value
			if (ids.length == 0) {
				toast('请选择人员')
				return
			}
			body.set('assigned_worker_ids', ids)
			body.set('assigned_worker_id', ids[0])
			body.set('assigned_worker_name', workerNames(ids))
		}
		const note = remarks.value.trim()
		if (note.length > 0) {
			body.set('remarks', note)
		}
		loading.value = true
		errorTextValue.value = ''
		try {
			await request({
				method: 'POST',
				path: '/api/v1/apps/kuaizhizao/work-orders/' + workOrderId + '/operations/' + operationRowId + '/dispatch',
				query: null,
				body: body,
			})
			toast('已指派')
		} catch (err) {
			errorTextValue.value = errorText(err)
		}
		loading.value = false
	}

	onLoad(() => {
		loadOrders()
	})
</script>

<style>
	.modes {
		flex-direction: row;
		flex-wrap: wrap;
	}
	.section {
		margin-top: 12px;
	}
</style>
