import { API_ORIGIN } from './origin.uts'
import { getTenantId, getToken, clearToken } from './session.uts'
import { clientChannel, createIdempotencyKey } from '../channel/headers.uts'
// #ifdef APP
import { readAppEntryOrigin } from './app-entry.uts'
// #endif

export type QueryPair = {
	key : string
	value : string
}

/**
 * 请求失败分类。resultUnknown=true 表示请求可能已到达服务端但结果丢失
 * （超时、断网、2xx 响应体损坏），不能盲目重发；false 表示服务端明确拒绝，
 * 操作确定未执行，可安全重试。status 为 HTTP 状态码，0 表示未收到服务端响应。
 * 仍是 Error 子类，页面原有 instanceof Error / errorText 取消息不受影响。
 */
export class ApiRequestError extends Error {
	status : number = 0
	resultUnknown : boolean = false
}

/** 判断一次失败是否为“结果未知”，需要用户核对原操作后再决定。 */
export function apiResultUnknown(err : any | null) : boolean {
	return err != null && err instanceof ApiRequestError && (err as ApiRequestError).resultUnknown
}

/**
 * apiRequestWithOperationKey 的结果：data 与原契约一致，replayed 为后端幂等重放标记。
 * bodyPresent 表示 2xx 响应是否带有非空响应体；为 false 时（2xx 但 body 丢失/为空）
 * 可恢复提交路径须按结果未知处理，普通读取调用方不受影响。
 */
export type ApiOutcome = {
	data : any | null
	replayed : boolean
	status : number
	bodyPresent : boolean
}

function newFailure(message : string, status : number, resultUnknown : boolean) : ApiRequestError {
	const err = new ApiRequestError(message)
	err.status = status
	err.resultUnknown = resultUnknown
	return err
}

function trimSlash(value : string) : string {
	let text = value.trim()
	while (text.length > 0 && text.charAt(text.length - 1) == '/') {
		text = text.substring(0, text.length - 1)
	}
	return text
}

export function apiBase() : string {
	let origin = ''
	// #ifdef APP
	origin = trimSlash(readAppEntryOrigin())
	// #endif
	if (origin.length == 0) {
		origin = trimSlash(API_ORIGIN)
	}
	if (origin.length > 0) {
		return origin + '/api/v1'
	}
	return '/api/v1'
}

function isPublicPath(path : string) : boolean {
	if (path == '/auth/login' || path.indexOf('/auth/login?') == 0) {
		return true
	}
	if (path == '/auth/guest-login' || path.indexOf('/auth/guest-login?') == 0) {
		return true
	}
	if (path == '/login' || path.indexOf('/login?') == 0) {
		return true
	}
	if (path == '/infra/login' || path.indexOf('/infra/login?') == 0) {
		return true
	}
	if (path == '/auth/register' || path.indexOf('/auth/register?') == 0) {
		return true
	}
	if (path == '/register' || path.indexOf('/register?') == 0) {
		return true
	}
	if (path.indexOf('/tenants/search') == 0) {
		return true
	}
	if (path.indexOf('/tenants/check-domain') == 0) {
		return true
	}
	return false
}

function isWriteMethod(method : string) : boolean {
	return method == 'POST' || method == 'PUT' || method == 'PATCH' || method == 'DELETE'
}

function buildUrl(base : string, path : string, query : Array<QueryPair> | null) : string {
	let url = base + path
	if (query == null || query.length == 0) {
		return url
	}
	const parts : Array<string> = []
	for (let i = 0; i < query.length; i++) {
		const pair = query[i]
		if (pair.value.length == 0) {
			continue
		}
		parts.push(encodeURIComponent(pair.key) + '=' + encodeURIComponent(pair.value))
	}
	if (parts.length == 0) {
		return url
	}
	const joiner = url.indexOf('?') >= 0 ? '&' : '?'
	return url + joiner + parts.join('&')
}

function buildHeaders(method : string, path : string, operationKey : string | null) : UTSJSONObject {
	const header = new UTSJSONObject()
	header['Content-Type'] = 'application/json'
	const channel = clientChannel()
	if (channel.length > 0) {
		header['X-Client-Channel'] = channel
	}
	const isPublic = isPublicPath(path)
	// 写方法且非公开接口时使用 Idempotency-Key。恢复提交传入持久化 operationKey
	// （mob-op- 前缀）复用原键，否则每次生成新键，对齐 api.ts。
	const provided = operationKey ?? ''
	if (isWriteMethod(method) && !isPublic) {
		header['Idempotency-Key'] = provided.length > 0 ? provided : createIdempotencyKey()
	}
	if (!isPublic) {
		const token = getToken()
		if (token.length > 0) {
			header['Authorization'] = 'Bearer ' + token
		}
		const tenantId = getTenantId()
		if (tenantId.length > 0) {
			header['X-Tenant-ID'] = tenantId
		}
	}
	return header
}

function readStringField(obj : any | null, key : string) : string {
	if (obj == null) {
		return ''
	}
	const record = obj as UTSJSONObject
	const value = record[key]
	if (value == null) {
		return ''
	}
	if (typeof value == 'string') {
		return value as string
	}
	return ''
}

function errorText(payload : any | null, status : number) : string {
	const detailRaw = payload == null ? null : (payload as UTSJSONObject)['detail']
	if (typeof detailRaw == 'string' && (detailRaw as string).length > 0) {
		return detailRaw as string
	}
	// detail 也可能是对象：HTTPException(detail={"message":..., "trace_id":...})
	if (detailRaw != null && typeof detailRaw == 'object' && !Array.isArray(detailRaw)) {
		const detailMessage = readStringField(detailRaw, 'message')
		if (detailMessage.length > 0) {
			return detailMessage
		}
	}
	const message = readStringField(payload, 'message')
	if (message.length > 0) {
		return message
	}
	const error = payload == null ? null : (payload as UTSJSONObject)['error']
	const errorMessage = readStringField(error, 'message')
	if (errorMessage.length > 0) {
		return errorMessage
	}
	if (typeof error == 'string' && (error as string).length > 0) {
		return error as string
	}
	return '请求失败（' + status.toString() + '）'
}

function unwrap(payload : any | null) : any | null {
	if (payload == null) {
		return null
	}
	if (Array.isArray(payload)) {
		return payload
	}
	if (typeof payload != 'object') {
		return payload
	}
	const obj = payload as UTSJSONObject
	const success = obj['success']
	if (success == true && obj['data'] != null && obj['total'] != null) {
		return obj
	}
	if (success == true && obj['data'] != null) {
		const inner = obj['data']
		if (inner != null && typeof inner == 'object' && !Array.isArray(inner)) {
			const innerObj = inner as UTSJSONObject
			if (innerObj['failed_count'] != null || innerObj['success_count'] != null) {
				return obj
			}
		}
		return inner
	}
	if (success == false) {
		throw new Error(errorText(payload, 200))
	}
	if (obj['code'] != null && obj['data'] != null) {
		const code = obj['code']
		if (code == 200) {
			return obj['data']
		}
		throw new Error(errorText(payload, 200))
	}
	return payload
}

function isReplayed(res : any) : boolean {
	const headers = res.header
	if (headers == null || typeof headers != 'object') {
		return false
	}
	const obj = headers as UTSJSONObject
	const upper = obj['X-Idempotency-Replay']
	if (upper != null && String(upper) == '1') {
		return true
	}
	const lower = obj['x-idempotency-replay']
	return lower != null && String(lower) == '1'
}

function handleResponse(res : any, resolve : (value : ApiOutcome) => void, reject : (reason : any) => void) : void {
	const status = res.statusCode as number
	const rawBody : any | null = res.data
	// 2xx 但 body 缺失（null）或为空串：可恢复提交按结果未知处理。
	const bodyPresent = rawBody != null && !(typeof rawBody == 'string' && (rawBody as string).trim().length == 0)
	let payload : any | null = rawBody
	let parseFailed = false
	if (typeof payload == 'string' && (payload as string).length > 0) {
		try {
			payload = JSON.parse(payload as string)
		} catch (_err) {
			parseFailed = true
			payload = null
		}
	}
	if (status == 401) {
		clearToken()
	}
	if (status == 0) {
		// 部分平台传输被截断/中止时仍回调 statusCode:0 的"成功"响应，
		// 不能证明服务端已拒绝，一律按结果未知处理。
		reject(newFailure('未获得有效的服务器响应，操作结果未知', 0, true))
		return
	}
	if (parseFailed) {
		if (status < 200 || status >= 300) {
			reject(newFailure(errorText(null, status), status, false))
			return
		}
		// 2xx 但响应体丢失/损坏：服务端可能已执行，结果未知，保留原快照核对。
		reject(newFailure('服务器响应无法读取，操作结果未知', status, true))
		return
	}
	if (status < 200 || status >= 300) {
		reject(newFailure(errorText(payload, status), status, false))
		return
	}
	try {
		resolve({ data: unwrap(payload), replayed: isReplayed(res), status: status, bodyPresent: bodyPresent } as ApiOutcome)
	} catch (err) {
		const message = err instanceof Error ? (err as Error).message : '请求失败'
		reject(newFailure(message, status, false))
	}
}

function apiRequestOutcomeOn(base : string, method : string, path : string, query : Array<QueryPair> | null, body : UTSJSONObject | null, operationKey : string | null) : Promise<ApiOutcome> {
	const verb = method.toUpperCase()
	const header = buildHeaders(verb, path, operationKey)
	const url = buildUrl(base, path, query)
	return new Promise((resolve, reject) => {
		const fail = (_err : any) => {
			// 超时/断网不能证明服务端未执行，结果按未知处理。
			reject(newFailure('网络连接失败', 0, true))
		}
		const success = (res : any) => {
			handleResponse(res, resolve, reject)
		}
		if (verb == 'POST') {
			uni.request({
				url: url,
				method: 'POST',
				data: body,
				header: header,
				timeout: 15000,
				success: success,
				fail: fail
			})
			return
		}
		if (verb == 'PUT') {
			uni.request({
				url: url,
				method: 'PUT',
				data: body,
				header: header,
				timeout: 15000,
				success: success,
				fail: fail
			})
			return
		}
		if (verb == 'PATCH') {
			uni.request({
				url: url,
				method: 'PATCH',
				data: body,
				header: header,
				timeout: 15000,
				success: success,
				fail: fail
			})
			return
		}
		if (verb == 'DELETE') {
			uni.request({
				url: url,
				method: 'DELETE',
				data: body,
				header: header,
				timeout: 15000,
				success: success,
				fail: fail
			})
			return
		}
		uni.request({
			url: url,
			method: 'GET',
			header: header,
			timeout: 15000,
			success: success,
			fail: fail
		})
	})
}

function apiRequestOn(base : string, method : string, path : string, query : Array<QueryPair> | null, body : UTSJSONObject | null) : Promise<any | null> {
	return apiRequestOutcomeOn(base, method, path, query, body, null).then((outcome : ApiOutcome) => {
		return outcome.data
	})
}

export function apiRequest(method : string, path : string, query : Array<QueryPair> | null, body : UTSJSONObject | null) : Promise<any | null> {
	return apiRequestOn(apiBase(), method, path, query, body)
}

/**
 * 可恢复提交入口。operationKey 为持久化快照的原操作键（mob-op- 前缀），
 * 作为既有 Idempotency-Key 头发送；恢复时同键同快照重发，replayed 标记重放。
 */
export function apiRequestWithOperationKey(method : string, path : string, query : Array<QueryPair> | null, body : UTSJSONObject | null, operationKey : string) : Promise<ApiOutcome> {
	return apiRequestOutcomeOn(apiBase(), method, path, query, body, operationKey)
}

export function apiGetFromOrigin(origin : string, path : string) : Promise<any | null> {
	const host = trimSlash(origin)
	if (host.length == 0) {
		return Promise.reject(newFailure('网络连接失败', 0, true))
	}
	return apiRequestOn(host + '/api/v1', 'GET', path, null, null)
}

export function apiGet(path : string, query : Array<QueryPair> | null) : Promise<any | null> {
	return apiRequest('GET', path, query, null)
}

export function apiPost(path : string, body : UTSJSONObject | null) : Promise<any | null> {
	return apiRequest('POST', path, null, body)
}
