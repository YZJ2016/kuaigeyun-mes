<template>
	<view class="picker-wrap">
		<text v-if="label.length > 0" class="label">{{ label }}</text>
		<button class="picker-field" hover-class="pressed" :disabled="disabled" @click="toggle">
			<text :class="selectionText.length > 0 ? 'picker-value' : 'picker-placeholder'">{{ selectionText.length > 0 ? selectionText : '请选择' + title }}</text>
			<text class="picker-chevron">{{ expanded ? '收起' : '›' }}</text>
		</button>
		<button v-if="expanded" class="picker-mask" :disabled="false" @click="close"></button>
		<view v-if="expanded" class="picker-sheet">
			<view class="sheet-head">
				<text class="sheet-title">选择{{ title }}</text>
				<button class="sheet-close" :disabled="false" @click="close">关闭</button>
			</view>
			<view v-if="searchable" class="sheet-tools">
				<input class="field sheet-search" v-model="keyword" :disabled="disabled || loading" :placeholder="searchHint" @confirm="onSearch" />
				<action-button label="查询" :compact="true" :disabled="disabled" :busy="loading" @press="onSearch" />
			</view>
			<text v-if="error.length > 0" class="error">{{ error }}</text>
			<load-feedback :active="loading && !appending" mode="refresh" />
			<scroll-view class="sheet-list" direction="vertical">
				<selection-row v-for="(item, index) in options" :key="item.id" :label="item.label" :description="item.description" :selected="item.id == selectedId" :disabled="disabled || loading" @choose="choose(index)" />
				<empty-state v-if="!loading && options.length == 0" :title="emptyTitle" :compact="true" />
				<text v-if="total > 0" class="list-count">已显示 {{ options.length }} / 共 {{ total }} 条</text>
				<load-feedback :active="appending" mode="more" />
				<action-button v-if="options.length < total" label="加载更多" tone="secondary" :disabled="disabled || loading" @press="onMore" />
			</scroll-view>
		</view>
	</view>
</template>
<script setup lang="uts">
	import LoadFeedback from './load-feedback.uvue'
	import SelectionRow from './selection-row.uvue'
	import ActionButton from './action-button.uvue'
	import EmptyState from './empty-state.uvue'
	import { SheetOption } from './sheet-option.uts'
	const props = defineProps({
		title: { type: String, default: '记录' }, label: { type: String, default: '' },
		options: { type: Array as PropType<SheetOption[]>, default: (): SheetOption[] => [] },
		selectedId: { type: Number, default: 0 }, selectionText: { type: String, default: '' },
		disabled: { type: Boolean, default: false }, loading: { type: Boolean, default: false },
		appending: { type: Boolean, default: false }, total: { type: Number, default: 0 },
		searchable: { type: Boolean, default: true }, searchHint: { type: String, default: '输入编码或名称' },
		emptyTitle: { type: String, default: '没有可选记录' }, error: { type: String, default: '' }
	})
	const emit = defineEmits(['search', 'choose', 'more', 'open'])
	const expanded = ref(false)
	const keyword = ref('')
	function toggle() {
		if (props.disabled) { return }
		expanded.value = !expanded.value
		if (expanded.value) { emit('open') }
	}
	function close() {
		expanded.value = false
	}
	function onSearch() {
		if (props.disabled) { return }
		emit('search', keyword.value.trim())
	}
	function choose(index: number) {
		if (props.disabled || props.loading) { return }
		if (index < 0 || index >= props.options.length) { return }
		emit('choose', index)
		expanded.value = false
	}
	function onMore() {
		if (props.disabled || props.loading || props.appending) { return }
		emit('more')
	}
</script>
<style>
	.picker-field { width: 100%; min-height: 48px; flex-direction: row; align-items: center; justify-content: space-between; background-color: #FFFFFF; border-width: 1px; border-style: solid; border-color: #64748B; border-radius: 8px; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; }
	.picker-value { font-size: 15px; color: #28113C; }
	.picker-placeholder { font-size: 15px; color: #94A3B8; }
	.picker-chevron { font-size: 15px; color: #94A3B8; margin-left: 8px; }
	.picker-mask { position: fixed; top: 0px; bottom: 0px; left: 0px; right: 0px; width: 100%; height: 100%; min-height: 0px; padding: 0px; margin: 0px; border-width: 0px; border-radius: 0px; background-color: rgba(15, 23, 42, 0.45); z-index: 98; }
	.picker-sheet { position: fixed; bottom: 0px; left: 0px; right: 0px; height: 72%; z-index: 99; background-color: #F8FAFC; border-top-left-radius: 16px; border-top-right-radius: 16px; padding-top: 14px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; flex-direction: column; }
	.sheet-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
	.sheet-title { font-size: 16px; font-weight: 700; color: #28113C; }
	.sheet-close { width: auto; min-height: 0px; height: auto; margin: 0px; padding-top: 6px; padding-right: 4px; padding-bottom: 6px; padding-left: 8px; border-width: 0px; background-color: transparent; font-size: 15px; line-height: 21px; color: #9730E3; }
	.sheet-tools { flex-direction: row; align-items: center; flex-wrap: wrap; }
	.sheet-search { flex: 1; margin-right: 8px; }
	.sheet-list { flex: 1; margin-top: 4px; }
</style>
