<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page" direction="vertical">
		<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		<text class="label">当前密码</text>
		<input class="field" :password="true" v-model="currentPassword" />
		<text class="label">新密码</text>
		<input class="field" :password="true" v-model="nextPassword" />
		<text class="label">再输入一次新密码</text>
		<input class="field" :password="true" v-model="againPassword" />
		<view :class="busy ? 'btn-primary is-disabled' : 'btn-primary'" hover-class="pressed" @click="onSave">
			<text class="btn-label">保存密码</text>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import HomeLink from '../../shared/ui/home-link.uvue'
	import { apiPost } from '../../shared/api/http.uts'
	import { getToken } from '../../shared/api/session.uts'
	import { passwordBody } from './profile.uts'

	const currentPassword = ref('')
	const nextPassword = ref('')
	const againPassword = ref('')
	const errorText = ref('')
	const busy = ref(false)

	function leave() {
		uni.reLaunch({ url: '/shell/login/index' })
	}

	function failText(err : any) : string {
		if (err instanceof Error) {
			return err.message
		}
		return '网络连接失败'
	}

	async function onSave() {
		if (busy.value) {
			return
		}
		const current = currentPassword.value
		const next = nextPassword.value
		const again = againPassword.value
		if (current.length == 0 || next.length == 0 || again.length == 0) {
			errorText.value = '请输入当前密码和新密码'
			return
		}
		if (next.length < 8) {
			errorText.value = '新密码至少 8 个字符'
			return
		}
		if (next != again) {
			errorText.value = '两次新密码不一致'
			return
		}
		busy.value = true
		errorText.value = ''
		try {
			await apiPost('/personal/user-profile/change-password', passwordBody(current, next))
			currentPassword.value = ''
			nextPassword.value = ''
			againPassword.value = ''
			uni.showToast({ title: '密码修改成功', icon: 'none' })
		} catch (err) {
			errorText.value = failText(err)
			if (getToken().length == 0) {
				leave()
			}
		}
		busy.value = false
	}

	onShow(() => {
		if (getToken().length == 0) {
			leave()
		}
	})
</script>
