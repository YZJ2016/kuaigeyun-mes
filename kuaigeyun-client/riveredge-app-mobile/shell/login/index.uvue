<template>
	<view class="login-page">
		<view class="login-hero">
			<view class="login-mark">
				<text class="login-mark-text">星</text>
			</view>
			<text class="brand-name">星制造</text>
			<text class="brand-desc">用账号进入生产现场</text>
		</view>
		<view v-if="!ready" class="card login-card">
			<text class="loading">正在加载</text>
		</view>
		<view v-else>
			<view class="card login-card">
				<text class="login-label login-label-first">组织</text>
				<text v-if="tenantName.length > 0" class="org-current">{{ tenantName }}</text>
				<text v-else-if="tenantId.length > 0" class="org-current">已选择组织</text>
				<input class="field login-field" v-model="keyword" placeholder="组织名称或域名" placeholder-class="login-ph" />
				<button :class="searching || wecomBusy ? 'btn-secondary is-disabled' : 'btn-secondary'" :disabled="searching || wecomBusy" @click="onSearch">{{ searching ? '搜索中' : '搜索组织' }}</button>
				<text v-if="isOrgMessage()" class="error login-error">{{ message }}</text>
				<view v-for="(item, index) in tenants" :key="item.tenantId" class="list-row" hover-class="pressed" @click="onChoose(index)">
					<text class="title">{{ item.tenantName }}</text>
					<text class="muted">{{ item.tenantDomain }}</text>
				</view>
				<text class="login-label">用户名</text>
				<input class="field login-field" v-model="username" placeholder="请输入用户名" placeholder-class="login-ph" />
				<text class="login-label">密码</text>
				<input class="field login-field" :password="true" v-model="passwordText" placeholder="请输入密码" placeholder-class="login-ph" />
				<text v-for="(line, index) in fieldErrors" :key="index" class="error login-error">{{ line }}</text>
				<text v-if="message.length > 0 && !isOrgMessage()" class="error login-error">{{ message }}</text>
				<button :class="loggingIn || wecomBusy ? 'btn-primary login-submit is-disabled' : 'btn-primary login-submit'" :disabled="loggingIn || wecomBusy" @click="onPasswordLogin">{{ loggingIn ? '登录中' : '登录' }}</button>
			</view>
			<button :class="wecomBusy || searching || loggingIn ? 'btn-secondary login-wecom is-disabled' : 'btn-secondary login-wecom'" :disabled="wecomBusy || searching || loggingIn" @click="onWecom">企业微信登录</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getTenantName, setTenantName } from '../../shared/api/session.uts'
	import { bootLogin, chooseTenant, loginWithPassword, searchTenants, startWecomLogin } from './flow.uts'
	import type { TenantChoice } from './flow.uts'

	const ready = ref(false)
	const message = ref('')
	const fieldErrors = ref<Array<string>>([])
	const tenantId = ref('')
	const tenantName = ref('')
	const keyword = ref('')
	const username = ref('')
	const passwordText = ref('')
	const tenants = ref<Array<TenantChoice>>([])
	const searching = ref(false)
	const loggingIn = ref(false)
	const wecomBusy = ref(false)

	function isOrgMessage() : boolean {
		const text = message.value
		if (text == '没有匹配的组织') {
			return true
		}
		if (text == '请搜索并选择组织' || text == '请先确定组织') {
			return true
		}
		return false
	}

	async function refresh(options : any | null) {
		const state = await bootLogin(options)
		message.value = state.message
		tenantId.value = state.tenantId
		tenantName.value = getTenantName()
		ready.value = true
		if (state.enterWorkbench) {
			uni.reLaunch({ url: '/shell/workbench/index' })
		}
	}

	onLoad((options : any) => {
		refresh(options).catch((err) => {
			message.value = err instanceof Error ? err.message : '登录初始化失败'
			ready.value = true
		})
	})

	async function onSearch() {
		if (searching.value || wecomBusy.value) {
			return
		}
		searching.value = true
		try {
			tenants.value = await searchTenants(keyword.value)
			if (tenants.value.length == 0) {
				message.value = '没有匹配的组织'
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '组织搜索失败'
		}
		searching.value = false
	}

	function onChoose(index : number) {
		const item = tenants.value[index]
		chooseTenant(item.tenantId)
		setTenantName(item.tenantName)
		tenantId.value = item.tenantId
		tenantName.value = item.tenantName
		message.value = ''
	}

	async function onPasswordLogin() {
		if (loggingIn.value || wecomBusy.value) {
			return
		}
		const name = username.value.trim()
		const missing : Array<string> = []
		if (name.length == 0) {
			missing.push('请输入用户名')
		}
		if (passwordText.value.length == 0) {
			missing.push('请输入密码')
		}
		fieldErrors.value = missing
		if (missing.length > 0) {
			return
		}
		loggingIn.value = true
		message.value = ''
		try {
			const text = await loginWithPassword(name, passwordText.value)
			if (text.length > 0) {
				message.value = text
			} else {
				uni.reLaunch({ url: '/shell/workbench/index' })
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '登录失败'
		}
		loggingIn.value = false
	}

	async function onWecom() {
		if (wecomBusy.value || searching.value || loggingIn.value) {
			return
		}
		wecomBusy.value = true
		try {
			const text = await startWecomLogin()
			if (text.length > 0) {
				message.value = text
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '登录失败'
		}
		wecomBusy.value = false
	}
</script>

<style>
	.login-page {
		flex: 1;
		flex-direction: column;
		background-color: #F8FAFC;
		padding-top: 20px;
		padding-right: 20px;
		padding-bottom: 28px;
		padding-left: 20px;
	}

	.login-hero {
		flex-direction: column;
		margin-bottom: 24px;
	}

	.login-mark {
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background-color: #9730E3;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-bottom: 16px;
	}

	.login-mark-text {
		color: #FFFFFF;
		font-size: 20px;
		font-weight: 700;
	}

	.brand-name {
		font-size: 28px;
		color: #28113C;
		font-weight: 700;
	}

	.brand-desc {
		margin-top: 8px;
		font-size: 14px;
		color: #475569;
	}

	.card.login-card {
		padding-top: 20px;
		padding-right: 20px;
		padding-bottom: 20px;
		padding-left: 20px;
		border-radius: 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E8F0;
		margin-bottom: 0;
	}

	.login-label {
		font-size: 13px;
		color: #475569;
		margin-top: 16px;
	}

	.login-label-first {
		margin-top: 0;
	}

	.field.login-field {
		background-color: #FFFFFF;
		border-color: #64748B;
		margin-top: 8px;
		margin-bottom: 0;
	}

	.login-ph {
		color: #475569;
		font-size: 16px;
	}

	.error.login-error {
		margin-top: 12px;
		margin-bottom: 0;
		color: #991B1B;
	}

	.btn-primary.login-submit {
		height: 48px;
		border-radius: 8px;
		margin-top: 20px;
		margin-bottom: 0;
	}

	.btn-secondary.login-wecom {
		margin-top: 16px;
		margin-bottom: 0;
	}

	.org-current {
		font-size: 16px;
		color: #28113C;
		margin-top: 8px;
	}
</style>
