<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="login-page" direction="vertical">
		<load-feedback :active="!ready" mode="initial" />
		<view class="login-hero">
			<view class="login-mark">
				<text class="login-mark-text">星</text>
			</view>
			<text class="brand-name">星制造</text>
			<text class="brand-desc">用账号进入生产现场</text>
		</view>
		<view v-if="ready">
			<view class="card login-card">
				<text class="login-label login-label-first">用户名</text>
				<input class="field login-field" name="username" v-model="username" :disabled="loggingIn || wecomBusy" placeholder="请输入用户名" placeholder-class="login-ph" confirm-type="next" @confirm="focusPassword" />
				<text class="login-label">密码</text>
				<input class="field login-field" name="password" :password="true" v-model="passwordText" :disabled="loggingIn || wecomBusy" placeholder="请输入密码" placeholder-class="login-ph" :focus="passwordFocus" confirm-type="go" @confirm="onPasswordLogin" @blur="clearPasswordFocus" />
				<text v-for="(line, index) in fieldErrors" :key="index" class="error login-error">{{ line }}</text>
				<view v-if="!hideOrg">
					<text class="login-label">组织</text>
					<text v-if="tenantName.length > 0" class="org-current">{{ tenantName }}</text>
					<text v-else-if="tenantId.length > 0 && !tenantLocked" class="org-current">已选择组织</text>
					<action-button v-if="showAppAddressSettings()" label="设置" accessibility-label="设置服务器地址" :disabled="searching || loggingIn || wecomBusy" @press="openAddressSettings" />
					<view v-if="!tenantLocked">
						<input class="field login-field" name="tenant-keyword" v-model="keyword" :disabled="searching || loggingIn || wecomBusy" placeholder="组织名称或域名" placeholder-class="login-ph" confirm-type="search" @confirm="onSearch" />
						<action-button label="搜索组织" :busy="searching" busy-label="搜索中" :disabled="loggingIn || wecomBusy" @press="onSearch" />
						<selection-row v-for="(item, index) in tenants" :key="item.tenantId" :label="item.tenantName" :description="item.tenantDomain" :selected="tenantId == item.tenantId" :disabled="tenantLocked || searching || loggingIn || wecomBusy" @choose="onChoose(index)" />
					</view>
					<text v-if="isOrgMessage()" :class="isOrgHint() ? 'hint login-hint' : 'error login-error'">{{ message }}</text>
				</view>
				<text v-if="message.length > 0 && !isOrgMessage()" class="error login-error">{{ message }}</text>
				<view class="login-submit"><action-button label="登录" tone="primary" :busy="loggingIn" busy-label="登录中" :disabled="searching || wecomBusy" @press="onPasswordLogin" /></view>
			</view>
			<view class="login-wecom"><action-button label="企业微信登录" :busy="wecomBusy" :disabled="searching || loggingIn" @press="onWecom" /></view>
		</view>
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../shared/ui/load-feedback.uvue'
	import ActionButton from '../../shared/ui/action-button.uvue'
	import SelectionRow from '../../shared/ui/selection-row.uvue'
	import HomeLink from '../../shared/ui/home-link.uvue'
	import { getTenantName, setTenantName } from '../../shared/api/session.uts'
	import { bootLogin, chooseTenant, loginWithPassword, searchTenants, startWecomLogin } from './flow.uts'
	import type { TenantChoice } from './flow.uts'
	import { navigateToPage } from '../../shared/ui/navigate.uts'

	const ready = ref(false)
	const message = ref('')
	const fieldErrors = ref<Array<string>>([])
	const tenantId = ref('')
	const tenantName = ref('')
	const tenantLocked = ref(false)
	const hideOrg = ref(false)
	const keyword = ref('')
	const username = ref('')
	const passwordText = ref('')
	const tenants = ref<Array<TenantChoice>>([])
	const searching = ref(false)
	const loggingIn = ref(false)
	const wecomBusy = ref(false)
	const passwordFocus = ref(false)

	function isOrgMessage() : boolean {
		const text = message.value
		if (text == '没有匹配的组织') {
			return true
		}
		if (text == '请搜索并选择组织' || text == '请先确定组织' || text == '输入关键词搜索组织') {
			return true
		}
		if (text == '没有找到组织' || text == '组织地址暂时无法确认') {
			return true
		}
		return false
	}

	function isOrgHint() : boolean {
		const text = message.value
		return text == '请搜索并选择组织' || text == '输入关键词搜索组织'
	}

	function focusPassword() {
		passwordFocus.value = true
	}

	function clearPasswordFocus() {
		passwordFocus.value = false
	}

	function showAppAddressSettings() : boolean {
		if (!tenantLocked.value) {
			return false
		}
		let app = false
		// #ifdef APP
		app = true
		// #endif
		return app
	}

	function openAddressSettings() {
		navigateToPage('/shell/tenant/index?mode=settings')
	}

	async function refresh(options : any | null) {
		const state = await bootLogin(options)
		if (state.needsAddress) {
			uni.reLaunch({ url: '/shell/tenant/index' })
			return
		}
		message.value = state.message
		tenantId.value = state.tenantId
		tenantName.value = getTenantName()
		tenantLocked.value = state.tenantLocked
		hideOrg.value = state.hideOrg
		ready.value = true
		if (state.enterWorkbench) {
			uni.reLaunch({ url: '/shell/workbench/index' })
		}
	}

	onLoad((options : any) => {
		refresh(options).catch((err) => {
			message.value = err instanceof Error ? err.message : '登录初始化失败'
			ready.value = true
		})
	})

	async function onSearch() {
		if (tenantLocked.value || searching.value || loggingIn.value || wecomBusy.value) {
			return
		}
		searching.value = true
		try {
			tenants.value = await searchTenants(keyword.value)
			if (tenants.value.length == 0) {
				message.value = keyword.value.trim().length == 0 ? '输入关键词搜索组织' : '没有匹配的组织'
			} else if (isOrgMessage()) {
				message.value = ''
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '组织搜索失败'
		}
		searching.value = false
	}

	function onChoose(index : number) {
		if (tenantLocked.value || searching.value || loggingIn.value || wecomBusy.value) {
			return
		}
		if (index < 0 || index >= tenants.value.length) { return }
		const item = tenants.value[index]
		chooseTenant(item.tenantId)
		setTenantName(item.tenantName)
		tenantId.value = item.tenantId
		tenantName.value = item.tenantName
		message.value = ''
	}

	async function onPasswordLogin() {
		if (searching.value || loggingIn.value || wecomBusy.value) {
			return
		}
		const name = username.value.trim()
		const missing : Array<string> = []
		if (name.length == 0) {
			missing.push('请输入用户名')
		}
		if (passwordText.value.length == 0) {
			missing.push('请输入密码')
		}
		if (tenantLocked.value && tenantId.value.length == 0) {
			message.value = message.value.length > 0 ? message.value : '没有找到组织'
			return
		}
		fieldErrors.value = missing
		if (missing.length > 0) {
			return
		}
		loggingIn.value = true
		message.value = ''
		try {
			const text = await loginWithPassword(name, passwordText.value)
			if (text.length > 0) {
				message.value = text
			} else {
				uni.reLaunch({ url: '/shell/workbench/index' })
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '登录失败'
		}
		loggingIn.value = false
	}

	async function onWecom() {
		if (wecomBusy.value || searching.value || loggingIn.value) {
			return
		}
		wecomBusy.value = true
		try {
			const text = await startWecomLogin()
			if (text.length > 0) {
				message.value = text
			}
		} catch (err) {
			message.value = err instanceof Error ? err.message : '登录失败'
		}
		wecomBusy.value = false
	}
</script>

<style>
	.login-page {
		flex: 1;
		flex-direction: column;
		background-color: #F8FAFC;
		padding-top: 20px;
		padding-right: 20px;
		padding-bottom: 28px;
		padding-left: 20px;
	}

	.login-hero {
		flex-direction: column;
		margin-bottom: 24px;
	}

	.login-mark {
		width: 44px;
		height: 44px;
		border-radius: 14px;
		background-color: #9730E3;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-bottom: 16px;
	}

	.login-mark-text {
		color: #FFFFFF;
		font-size: 20px;
		font-weight: 700;
	}

	.brand-name {
		font-size: 28px;
		color: #28113C;
		font-weight: 700;
	}

	.brand-desc {
		margin-top: 8px;
		font-size: 14px;
		color: #475569;
	}

	.card.login-card {
		padding-top: 20px;
		padding-right: 20px;
		padding-bottom: 20px;
		padding-left: 20px;
		border-radius: 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E8F0;
		margin-bottom: 0;
	}

	.login-label {
		font-size: 13px;
		color: #475569;
		margin-top: 16px;
	}

	.login-label-first {
		margin-top: 0;
	}

	.field.login-field {
		background-color: #FFFFFF;
		border-color: #64748B;
		margin-top: 8px;
		margin-bottom: 0;
	}

	.login-ph {
		color: #475569;
		font-size: 16px;
	}

	.error.login-error {
		margin-top: 12px;
		margin-bottom: 0;
		color: #991B1B;
	}

	.hint.login-hint {
		margin-top: 12px;
		margin-bottom: 0;
	}

	.login-submit {
		margin-top: 20px;
		margin-bottom: 0;
	}

	.login-wecom {
		margin-top: 16px;
		margin-bottom: 0;
	}

	.org-current {
		font-size: 16px;
		color: #28113C;
		margin-top: 8px;
	}
</style>
