<template>
	<view class="page-shell">
		<home-link />
	<scroll-view class="page home-page" direction="vertical">
		<button v-if="!loading || homeLoaded" class="who" :disabled="false" hover-class="pressed" @click="openAccount">
			<view class="who-copy">
				<text class="who-name">{{ displayName }}</text>
				<text v-if="orgName.length > 0" class="who-meta">{{ orgName }}</text>
			</view>
			<view class="who-trail">
				<text class="who-account">账号</text>
				<text class="who-chevron">›</text>
			</view>
		</button>
		<load-feedback :active="loading || refreshing" :mode="homeLoaded ? 'refresh' : 'initial'" />
		<text v-if="errorText.length > 0" class="error">{{ errorText }}</text>
		<view v-if="!loading && (errorText.length > 0 || homeWarnings.length > 0)">
			<text v-for="(warning, index) in homeWarnings" :key="index" class="error">{{ warning }}</text>
			<action-button label="重新加载" :busy="loading || refreshing" @press="refresh" />
		</view>
		<button v-if="hasScan" class="btn-primary btn-scan" :disabled="loading" hover-class="pressed" @click="onScan">
			<view class="scan-mark">
				<view class="scan-row">
					<view class="scan-corner scan-tl"></view>
					<view class="scan-corner scan-tr"></view>
				</view>
				<view class="scan-row">
					<view class="scan-core"></view>
				</view>
				<view class="scan-row">
					<view class="scan-corner scan-bl"></view>
					<view class="scan-corner scan-br"></view>
				</view>
			</view>
			<text class="btn-scan-label">扫码报工</text>
		</button>
		<text v-if="hasScan" class="home-hint">扫描工单进入报工；也可手动输入编码</text>
		<text v-if="(!loading || homeLoaded) && errorText.length == 0" class="home-label">检索功能</text>
		<input v-if="(!loading || homeLoaded) && errorText.length == 0" class="field home-field" :value="featureQuery" placeholder="例如盘点、领料" @input="onFeatureQuery" />
		<view v-if="(!loading || homeLoaded) && errorText.length == 0 && !searching">
			<text class="home-section">今日待办</text>
			<view v-if="todoEmptyText.length > 0" class="home-empty">
				<text class="home-empty-title">{{ todoEmptyText }}</text>
			</view>
			<button v-for="(todo, index) in todos" :key="todo.uid" class="home-todo" :disabled="loading || todo.missing" hover-class="pressed" @click="onTodo(index)">
				<view class="todo-copy">
					<text class="todo-title">{{ todo.title }}</text>
					<text v-if="todo.subtitle.length > 0" class="todo-sub">{{ todo.subtitle }}</text>
				</view>
				<status-badge :value="todo.countText" :tone="todo.tone" />
			</button>
			<text v-if="frequent.length > 0" class="home-section">常用</text>
			<view v-if="frequent.length > 0" class="home-grid">
				<view v-for="(cell, index) in frequent" :key="cell.uid" class="home-cell-slot">
					<button class="home-cell" :disabled="loading || cell.missing" hover-class="pressed" @click="onFrequent(index)">
						<view class="icon-tile icon-workshop home-tile">
							<image v-if="iconAsset(cell.icon, cell.iconGroup, 'workshop').length > 0" class="tile-icon" :src="iconAsset(cell.icon, cell.iconGroup, 'workshop')" mode="aspectFit"></image>
							<text v-else class="tile-mark mark-workshop">{{ iconMark(cell.icon, cell.iconGroup, cell.label) }}</text>
						</view>
						<text class="cell-label">{{ cell.label }}</text>
					</button>
				</view>
			</view>
			<action-button  label="全部功能" :disabled="loading" @press="openApps" />
			<action-button v-if="appSettingsEnabled()"  label="设置" :disabled="loading" @press="openAppSettings" />
		</view>
		<view v-if="searching">
			<view v-if="hits.length == 0" class="home-empty">
				<text class="home-empty-title">没有这个功能</text>
				<text class="home-hint">换个名称，或从全部分组里找。</text>
				<action-button  label="去全部分组" :disabled="loading" @press="openApps" />
			</view>
			<button v-for="(hit, index) in hits" :key="hit.uid" class="hit" :disabled="loading || hit.missing" hover-class="pressed" @click="onHit(index)">
				<view class="hit-tile" :class="tileClass(hit.scope)">
					<image v-if="iconAsset(hit.icon, hit.iconGroup, hit.scope).length > 0" class="tile-icon" :src="iconAsset(hit.icon, hit.iconGroup, hit.scope)" mode="aspectFit"></image>
					<text v-else :class="markClass(hit.scope)">{{ iconMark(hit.icon, hit.iconGroup, hit.label) }}</text>
				</view>
				<view class="hit-copy">
					<text class="hit-title">{{ hit.label }}</text>
					<text class="hit-meta">{{ scopeTitle(hit.scope) }}</text>
				</view>
			</button>
			<action-button v-if="appSettingsEnabled()"  label="设置" :disabled="loading" @press="openAppSettings" />
		</view>
		<action-button v-if="appSettingsEnabled() && !searching && (loading || errorText.length > 0)" label="设置" @press="openAppSettings" />
	</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import LoadFeedback from '../../shared/ui/load-feedback.uvue'
	import HomeLink from '../../shared/ui/home-link.uvue'
	import ActionButton from '../../shared/ui/action-button.uvue'
	import StatusBadge from '../../shared/ui/status-badge.uvue'
	import { request } from '../../shared/api/index.uts'
	import { getTenantName, getToken, readSessionName, takePendingEntry } from '../../shared/api/session.uts'
	import { openRegisteredRoute } from '../registry/index.uts'
	import { iconAsset, iconMark, markClass, scopeTitle, tileClass } from './icons.uts'
	import { loadWorkbench } from './load.uts'
	import { readRecentRoutes } from './recent.uts'
	import { navigateToPage } from '../../shared/ui/navigate.uts'
	import type { WorkCell, WorkScope } from './load.uts'

	type HomeTodo = {
		uid : string
		title : string
		subtitle : string
		countText : string
		tone : string
		route : string
		missing : boolean
	}

	type MeasuredTodo = {
		key : string
		count : number
		failed : boolean
	}

	type FeatureHit = {
		uid : string
		label : string
		scope : string
		route : string
		missing : boolean
		icon : string
		iconGroup : string
	}

	const FREQUENT_KEYS = ['my-work-orders', 'exception-report', 'packing-binding', 'reporting-history']

	const loading = ref(false)
	const refreshing = ref(false)
	const homeLoaded = ref(false)
	const errorText = ref('')
	const displayName = ref('已登录')
	const orgName = ref('')
	const hasScan = ref(false)
	const scanRoute = ref('')
	const scanMissing = ref(false)
	const todos = ref<Array<HomeTodo>>([])
	const frequent = ref<Array<WorkCell>>([])
	const featureQuery = ref('')
	const hits = ref<Array<FeatureHit>>([])
	const loadedBlocks = ref<Array<WorkScope>>([])
	const homeWarnings = ref<Array<string>>([])
	const todoStatsAvailable = ref(false)
	let openedDeepLink = false
	const todoEmptyText = computed((): string => {
		if (loading.value || errorText.value.length > 0 || homeWarnings.value.length > 0 || todos.value.length > 0) {
			return ''
		}
		return todoStatsAvailable.value ? '当前故障与保养提醒均无待处理项' : '当前没有可显示的待办统计'
	})

	const searching = computed((): boolean => {
		return featureQuery.value.trim().length > 0
	})

	function leaveToLogin() {
		uni.reLaunch({ url: '/shell/login/index' })
	}

	function findCell(blocks : Array<WorkScope>, key : string) : WorkCell | null {
		for (let i = 0; i < blocks.length; i++) {
			const sections = blocks[i].sections
			for (let s = 0; s < sections.length; s++) {
				const cells = sections[s].cells
				for (let c = 0; c < cells.length; c++) {
					if (cells[c].key == key) {
						return cells[c]
					}
				}
			}
		}
		return null
	}

	function findScoped(block : WorkScope, key : string) : WorkCell | null {
		const sections = block.sections
		for (let s = 0; s < sections.length; s++) {
			const cells = sections[s].cells
			for (let c = 0; c < cells.length; c++) {
				if (cells[c].key == key) {
					return cells[c]
				}
			}
		}
		return null
	}

	function readMeasuredCount(payload : any | null, key : string) : number | null {
		if (payload == null || Array.isArray(payload)) {
			return null
		}
		const raw = (payload as UTSJSONObject)[key]
		if (raw == null) {
			return null
		}
		const count = Number(raw)
		if (count != count) {
			return null
		}
		return count
	}

	function measuredFor(measured : Array<MeasuredTodo> | null, key : string) : MeasuredTodo | null {
		if (measured == null) {
			return null
		}
		for (let i = 0; i < measured.length; i++) {
			if (measured[i].key == key) {
				return measured[i]
			}
		}
		return null
	}

	function blockScope(blocks : Array<WorkScope>, key : string) : string {
		for (let i = 0; i < blocks.length; i++) {
			if (findScoped(blocks[i], key) != null) {
				return blocks[i].scope
			}
		}
		return ''
	}

	function linkedCell(blocks : Array<WorkScope>, key : string) : WorkCell | null {
		const cell = findCell(blocks, key)
		if (cell == null || cell.missing || cell.route.length == 0) {
			return null
		}
		return cell
	}

	function noteMeasureFailure(warnings : Array<string>, blocks : Array<WorkScope>, measured : Array<MeasuredTodo> | null, key : string) {
		if (linkedCell(blocks, key) == null) {
			return
		}
		const row = measuredFor(measured, key)
		if (row != null && row.failed) {
			warnings.push(scopeTitle(blockScope(blocks, key)) + '待处理数量未能读取，请重试')
		}
	}


	function countTone(count : number) : string {
		if (count <= 0) { return 'neutral' }
		if (count <= 5) { return 'success' }
		if (count <= 10) { return 'warning' }
		return 'danger'
	}

	function pushLinkedTodo(nextTodos : Array<HomeTodo>, blocks : Array<WorkScope>, measured : Array<MeasuredTodo> | null, key : string, title : string) {
		const cell = linkedCell(blocks, key)
		const row = measuredFor(measured, key)
		if (cell == null || row == null || row.failed) {
			return
		}
		nextTodos.push({
			uid: 'todo-' + key,
			title: title,
			subtitle: cell.label,
			countText: String(row.count),
			tone: countTone(row.count),
			route: cell.route,
			missing: cell.missing
		} as HomeTodo)
	}

	async function measureReporting() : Promise<MeasuredTodo> {
		const query = new UTSJSONObject()
		query.set('status', 'pending')
		query.set('limit', '1')
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/reporting',
				query: query,
				body: null
			})
			const total = readMeasuredCount(payload, 'total')
			if (total == null) {
				return { key: 'reporting-approve', count: 0, failed: true } as MeasuredTodo
			}
			return { key: 'reporting-approve', count: total, failed: false } as MeasuredTodo
		} catch (_err) {
			return { key: 'reporting-approve', count: 0, failed: true } as MeasuredTodo
		}
	}

	async function measureInspection() : Promise<MeasuredTodo> {
		try {
			const payload = await request({
				method: 'GET',
				path: '/api/v1/apps/kuaizhizao/quality/inspection-center-summary',
				query: null,
				body: null
			})
			if (payload == null || Array.isArray(payload)) {
				return { key: 'quality-hub', count: 0, failed: true } as MeasuredTodo
			}
			const keys = ['pending_incoming', 'pending_process', 'pending_finished', 'pending_oqc']
			let seen = false
			let sum = 0
			for (let i = 0; i < keys.length; i++) {
				const count = readMeasuredCount(payload, keys[i])
				if (count == null) {
					continue
				}
				seen = true
				if (count > 0) {
					sum += count
				}
			}
			if (!seen) {
				return { key: 'quality-hub', count: 0, failed: true } as MeasuredTodo
			}
			return { key: 'quality-hub', count: sum, failed: false } as MeasuredTodo
		} catch (_err) {
			return { key: 'quality-hub', count: 0, failed: true } as MeasuredTodo
		}
	}

	async function measureHomeTodos(blocks : Array<WorkScope>) : Promise<Array<MeasuredTodo>> {
		const jobs : Array<Promise<MeasuredTodo>> = []
		if (linkedCell(blocks, 'reporting-approve') != null) {
			jobs.push(measureReporting())
		}
		if (linkedCell(blocks, 'quality-hub') != null) {
			jobs.push(measureInspection())
		}
		if (jobs.length == 0) {
			return [] as Array<MeasuredTodo>
		}
		return await Promise.all(jobs)
	}

	function applyHome(blocks : Array<WorkScope>, measured : Array<MeasuredTodo> | null) {
		const warnings : Array<string> = []
		let statsAvailable = false
		for (let i = 0; i < blocks.length; i++) {
			const block = blocks[i]
			if (block.errorText.length > 0) {
				warnings.push(scopeTitle(block.scope) + '入口未能加载，请重试')
			} else if (block.badgeNote.length > 0) {
				warnings.push(scopeTitle(block.scope) + '待处理数量未能读取，请重试')
			} else if (block.showBadge) {
				statsAvailable = true
			} else if (findScoped(block, 'faults') != null || findScoped(block, 'maintenance-reminders') != null) {
				warnings.push(scopeTitle(block.scope) + '待处理数量暂不可用，请重试')
			}
		}
		noteMeasureFailure(warnings, blocks, measured, 'reporting-approve')
		noteMeasureFailure(warnings, blocks, measured, 'quality-hub')
		homeWarnings.value = warnings
		todoStatsAvailable.value = statsAvailable
		const name = readSessionName()
		displayName.value = name.length > 0 ? name : '已登录'
		orgName.value = getTenantName()
		const scan = findCell(blocks, 'scan-report')
		hasScan.value = scan != null
		scanRoute.value = scan == null ? '' : scan.route
		scanMissing.value = scan != null && scan.missing
		const nextFrequent : Array<WorkCell> = []
		const available : Array<WorkCell> = []
		for (let i = 0; i < blocks.length; i++) {
			for (let j = 0; j < blocks[i].sections.length; j++) {
				const cells = blocks[i].sections[j].cells
				for (let c = 0; c < cells.length; c++) {
					if (!cells[c].missing && cells[c].route.length > 0) { available.push(cells[c]) }
				}
			}
		}
		const recent = readRecentRoutes()
		for (let i = 0; i < recent.length && nextFrequent.length < 4; i++) {
			for (let c = 0; c < available.length; c++) {
				if (available[c].route == recent[i]) { nextFrequent.push(available[c]); break }
			}
		}
		for (let i = 0; i < FREQUENT_KEYS.length && nextFrequent.length < 4; i++) {
			const cell = findCell(blocks, FREQUENT_KEYS[i])
			if (cell != null && !cell.missing && !nextFrequent.some((item : WorkCell) : boolean => item.route == cell.route)) { nextFrequent.push(cell) }
		}
		for (let c = 0; c < available.length && nextFrequent.length < 4; c++) {
			const cell = available[c]
			if (!nextFrequent.some((item : WorkCell) : boolean => item.route == cell.route)) { nextFrequent.push(cell) }
		}
		frequent.value = nextFrequent
		const nextTodos : Array<HomeTodo> = []
		pushLinkedTodo(nextTodos, blocks, measured, 'reporting-approve', '待审报工')
		pushLinkedTodo(nextTodos, blocks, measured, 'quality-hub', '待检验')
		for (let i = 0; i < blocks.length; i++) {
			const block = blocks[i]
			if (block.pendingText.length > 0) {
				const cell = findScoped(block, 'faults')
				if (cell != null && !cell.missing) {
					nextTodos.push({
						uid: 'todo-faults',
						title: '待处理故障',
						subtitle: cell.label,
						countText: block.pendingText,
						tone: countTone(block.pendingCount),
						route: cell.route,
						missing: cell.missing
					} as HomeTodo)
				}
			}
			if (block.overdueText.length > 0) {
				const cell = findScoped(block, 'maintenance-reminders')
				if (cell != null && !cell.missing) {
					nextTodos.push({
						uid: 'todo-overdue',
						title: '逾期保养',
						subtitle: cell.label,
						countText: block.overdueText,
						tone: countTone(block.overdueCount),
						route: cell.route,
						missing: cell.missing
					} as HomeTodo)
				}
			}
		}
		todos.value = nextTodos
		loadedBlocks.value = blocks
		refreshHits()
	}

	function onFeatureQuery(event : UniInputEvent) {
		featureQuery.value = event.detail.value
		refreshHits()
	}

	function refreshHits() {
		const word = featureQuery.value.trim().toLowerCase()
		const next : Array<FeatureHit> = []
		if (word.length == 0) {
			hits.value = next
			return
		}
		const blocks = loadedBlocks.value
		for (let i = 0; i < blocks.length; i++) {
			const block = blocks[i]
			const sections = block.sections
			for (let s = 0; s < sections.length; s++) {
				const cells = sections[s].cells
				for (let c = 0; c < cells.length; c++) {
					const cell = cells[c]
					if (cell.label.toLowerCase().indexOf(word) < 0) {
						continue
					}
					next.push({
						uid: cell.uid,
						label: cell.label,
						scope: block.scope,
						route: cell.route,
						missing: cell.missing,
						icon: cell.icon,
						iconGroup: cell.iconGroup
					} as FeatureHit)
				}
			}
		}
		hits.value = next
	}

	function openCell(route : string, missing : boolean) {
		if (missing || route.length == 0) {
			uni.showToast({ title: '功能尚未安装', icon: 'none' })
			return
		}
		openRegisteredRoute(route)
	}

	function paintSession() {
		const name = readSessionName()
		displayName.value = name.length > 0 ? name : '已登录'
		orgName.value = getTenantName()
	}

	function openAccount() {
		navigateToPage('/shell/account/index')
	}

	async function refresh() {
		if (loading.value || refreshing.value) {
			return
		}
		paintSession()
		if (getToken().length == 0) {
			leaveToLogin()
			return
		}
		if (homeLoaded.value) {
			refreshing.value = true
		} else {
			loading.value = true
		}
		errorText.value = ''
		try {
			const blocks = await loadWorkbench()
			const measured = await measureHomeTodos(blocks)
			applyHome(blocks, measured)
			homeLoaded.value = true
		} catch (err) {
			if (homeLoaded.value) {
				homeWarnings.value = ['数据刷新失败，显示的是上一次结果']
			} else {
				homeLoaded.value = false
				todos.value = []
				frequent.value = []
				loadedBlocks.value = []
				hits.value = []
				hasScan.value = false
				homeWarnings.value = []
				todoStatsAvailable.value = false
				errorText.value = '工作台未能加载，请重试'
			}
		}
		loading.value = false
		refreshing.value = false
		if (!openedDeepLink) {
			openedDeepLink = true
			const pending = takePendingEntry()
			if (pending.length > 0) {
				openRegisteredRoute(pending)
			}
		}
	}

	function onScan() {
		openCell(scanRoute.value, scanMissing.value)
	}

	function onTodo(index : number) {
		const todo = todos.value[index]
		openCell(todo.route, todo.missing)
	}

	function onFrequent(index : number) {
		const cell = frequent.value[index]
		openCell(cell.route, cell.missing)
	}

	function onHit(index : number) {
		const hit = hits.value[index]
		openCell(hit.route, hit.missing)
	}

	function openApps() {
		navigateToPage('/shell/apps/index')
	}

	function appSettingsEnabled() : boolean {
		let enabled = false
		// #ifdef APP
		enabled = true
		// #endif
		return enabled
	}

	function openAppSettings() {
		navigateToPage('/shell/tenant/index?mode=settings')
	}

	onShow(() => {
		refresh()
	})
</script>

<style>
	.who, .home-todo, .home-cell, .hit { height: auto; min-height: 48px; line-height: 24px; text-align: left; }
	.home-cell { margin: 0px; padding: 0px; border-width: 0px; background-color: transparent; }
	.who {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		min-height: 48px;
		padding-top: 12px;
		padding-right: 12px;
		padding-bottom: 12px;
		padding-left: 12px;
		margin-bottom: 12px;
		background-color: #FFFFFF;
		border-radius: 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #E2E8F0;
	}

	.who-copy {
		flex: 1;
		flex-direction: column;
	}

	.who-name {
		font-size: 20px;
		color: #28113C;
		font-weight: 700;
	}

	.who-meta {
		margin-top: 2px;
		font-size: 14px;
		color: #475569;
	}

	.who-trail {
		flex-direction: row;
		align-items: center;
		margin-left: 12px;
	}

	.who-account {
		font-size: 16px;
		color: #28113C;
		font-weight: 700;
	}

	.who-chevron {
		margin-left: 2px;
		font-size: 20px;
		color: #475569;
	}

	.page.home-page {
		padding-top: 16px;
		padding-right: 16px;
		padding-bottom: 16px;
		padding-left: 16px;
	}

	.btn-primary.btn-scan {
		margin-top: 0;
		margin-bottom: 0;
	}

	.btn-scan-label {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: 700;
	}

	.scan-mark {
		width: 22px;
		height: 22px;
		margin-right: 8px;
		flex-direction: column;
		justify-content: space-between;
	}

	.scan-row {
		width: 22px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

