import { apiGet } from '../../shared/api/http.uts'
import { getToken } from '../../shared/api/session.uts'
import { loginConnected } from '../../shared/channel/headers.uts'
import {
	entryInWorkbench,
	entryPagePath,
	entrySupportsPlatform,
	findEntryByKey,
	installedPackages,
	packageBadge,
	packageScope
} from '../registry/index.uts'

export type WorkCell = {
	uid : string
	key : string
	label : string
	icon : string
	iconGroup : string
	solo : boolean
	missing : boolean
	pagePath : string
	route : string
}

export type WorkSection = {
	uid : string
	title : string
	showTitle : boolean
	cells : Array<WorkCell>
}

export type WorkScope = {
	scope : string
	showBadge : boolean
	badgeNote : string
	pendingText : string
	overdueText : string
	pendingCount : number
	overdueCount : number
	sections : Array<WorkSection>
	errorText : string
}

function readString(obj : any | null, key : string) : string {
	if (obj == null || (obj as UTSJSONObject)[key] == null) {
		return ''
	}
	return String((obj as UTSJSONObject)[key]).trim()
}

function hasOwn(obj : any | null, key : string) : boolean {
	if (obj == null) {
		return false
	}
	return (obj as UTSJSONObject)[key] != null
}

function readSections(payload : any | null) : Array<any> {
	if (payload == null) {
		return []
	}
	if (Array.isArray(payload)) {
		return payload as Array<any>
	}
	return []
}

async function loadBadge(pkg : any) : Promise<WorkScope | null> {
	const loader = packageBadge(pkg)
	if (loader == null) {
		return null
	}
	const counts = await loader()
	const pendingRaw = counts == null ? null : (counts as UTSJSONObject)['pending_fault_count']
	const overdueRaw = counts == null ? null : (counts as UTSJSONObject)['overdue_maintenance_reminder_count']
	const block = {
		scope: packageScope(pkg),
		showBadge: pendingRaw != null || overdueRaw != null,
		badgeNote: '',
		pendingText: '',
		overdueText: '',
		pendingCount: 0,
		overdueCount: 0,
		sections: [] as Array<WorkSection>,
		errorText: ''
	} as WorkScope
	if (pendingRaw != null) {
		block.pendingCount = Number(pendingRaw)
		block.pendingText = String(block.pendingCount)
	}
	if (overdueRaw != null) {
		block.overdueCount = Number(overdueRaw)
		block.overdueText = String(block.overdueCount)
	}
	return block
}

export async function loadWorkbench() : Promise<WorkScope[]> {
	if (!loginConnected() || getToken().length == 0) {
		return []
	}
	const packages = installedPackages()
	const blocks : Array<WorkScope> = []
	const seen : Array<string> = []
	for (let i = 0; i < packages.length; i++) {
		const pkg = packages[i]
		const scope = packageScope(pkg)
		if (scope.length == 0 || seen.indexOf(scope) >= 0) {
			continue
		}
		seen.push(scope)
		let payload : any | null = null
		try {
			payload = await apiGet('/apps/kuaizhizao/mobile/workbench', [
				{ key: 'scope', value: scope }
			])
		} catch (err) {
			const message = err instanceof Error ? err.message : '工作台未能加载'
			blocks.push({
				scope: scope,
				showBadge: false,
				badgeNote: '',
				pendingText: '',
				overdueText: '',
				pendingCount: 0,
				overdueCount: 0,
				sections: [] as Array<WorkSection>,
				errorText: message
			} as WorkScope)
			continue
		}
		const sections = readSections(payload)
		const viewSections : Array<WorkSection> = []
		for (let s = 0; s < sections.length; s++) {
			const section = sections[s]
			const title = readString(section, 'title')
			const entries = section == null ? null : (section as UTSJSONObject)['entries']
			if (entries == null || !Array.isArray(entries)) {
				continue
			}
			const list = entries as Array<any>
			const cells : Array<WorkCell> = []
			for (let e = 0; e < list.length; e++) {
				const item = list[e]
				const key = readString(item, 'key')
				const label = readString(item, 'label')
				const local = findEntryByKey(scope, key)
				if (local != null && !entrySupportsPlatform(local)) {
					continue
				}
				if (local != null && !entryInWorkbench(local)) {
					continue
				}
				const missing = local == null
				let pagePath = ''
				if (!missing && local != null) {
					pagePath = entryPagePath(local)
				}
				let iconGroup = ''
				if (hasOwn(item, 'icon_group')) {
					iconGroup = readString(item, 'icon_group')
				}
				const solo = item != null && (item as UTSJSONObject)['solo_row'] == true
				cells.push({
					uid: scope + '-' + key + '-' + e.toString(),
					key: key,
					label: label.length > 0 ? label : key,
					icon: readString(item, 'icon'),
					iconGroup: iconGroup,
					solo: solo,
					missing: missing,
					pagePath: pagePath,
					route: readString(item, 'route')
				} as WorkCell)
			}
			if (cells.length == 0) {
				continue
			}
			viewSections.push({
				uid: scope + '-section-' + s.toString(),
				title: title,
				showTitle: title.length > 0,
				cells: cells
			} as WorkSection)
		}
		if (viewSections.length == 0) {
			continue
		}
		const block = {
			scope: scope,
			showBadge: false,
			badgeNote: '',
			pendingText: '',
			overdueText: '',
			pendingCount: 0,
			overdueCount: 0,
			sections: viewSections,
			errorText: ''
		} as WorkScope
		if (packageBadge(pkg) != null) {
			try {
				const badge = await loadBadge(pkg)
				if (badge != null && badge.showBadge) {
					block.showBadge = true
					block.pendingText = badge.pendingText
					block.overdueText = badge.overdueText
					block.pendingCount = badge.pendingCount
					block.overdueCount = badge.overdueCount
				}
			} catch (_err) {
				block.badgeNote = '角标未能读取'
			}
		}
		blocks.push(block)
	}
	return blocks
}
