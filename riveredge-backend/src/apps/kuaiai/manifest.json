            "sort_order": 2
          },
          {
            "title": "app.kuaiai.menu.pulse",
            "path": "/apps/kuaiai/pulse",
            "icon": "triangle-alert",
            "permission": "kuaiai:pulse:display",
            "sort_order": 3
          },
          {
            "title": "app.kuaiai.menu.chat",
            "path": "/apps/kuaiai/chat",
