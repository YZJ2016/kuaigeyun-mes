{
  "code": "kuaiai",
  "name": "星AI",
  "version": "2.0.0",
  "is_pro": true,
  "market_category": "pro",
  "description": "嵌入业务场景的 AI 智能辅助引擎：全宽对话、顶栏助手、Agent 档案、知识库与 MCP 白名单",
  "icon": "sparkles",
  "author": "StarTech",
  "entry_point": "../apps/kuaiai/index.tsx",
  "route_path": "/apps/kuaiai",
  "sort_order": 350,
  "menu_config": {
    "title": "app.kuaiai.name",
    "icon": "sparkles",
