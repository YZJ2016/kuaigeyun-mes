  "ai_tools": [
    {
      "name": "search_knowledge",
      "label": "检索知识库",
      "kind": "read",
      "description": "检索企业知识库（返回相关文档片段）",
      "permission": "kuaiai:act:execute",
      "handler": "apps.kuaiai.services.chat_tools:search_knowledge",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索问题"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "query_work_orders",
      "label": "查询工单",
      "kind": "read",
      "description": "查询生产工单（view=summary 按 id/编码/关键词/状态查摘要列表；view=operations 查指定工单工序任务，须 work_order_id）",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.chat_tools:query_work_orders",
      "parameters": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "operations"
            ],
            "description": "查询视图：summary 摘要/列表（默认），operations 工序任务（须 work_order_id）"
          },
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "code": {
            "type": "string",
            "description": "工单编码（模糊）"
          },
          "keyword": {
            "type": "string",
            "description": "关键词（编码/名称/产品）"
          },
          "status": {
            "type": "string",
            "description": "工单状态过滤"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10）"
          }
        }
      }
    },
    {
      "name": "submit_production_feedback",
      "label": "提交报工",
      "kind": "write",
      "description": "为工单工序提交报工（本人自报；代报/小组报工走业务页面）",
      "permission": "kuaizhizao:production-execution-reporting:create",
      "handler": "apps.kuaiai.services.chat_tools:submit_production_feedback",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "operation_id": {
            "type": "integer",
            "description": "工序 ID（query_work_orders view=operations 返回的 operation_id）"
          },
          "reported_quantity": {
            "type": "number",
            "description": "报工数量"
          },
          "qualified_quantity": {
            "type": "number",
            "description": "合格数量（缺省=报工-不合格）"
          },
          "unqualified_quantity": {
            "type": "number",
            "description": "不合格数量"
          },
          "work_hours": {
            "type": "number",
            "description": "工时（小时，可空）"
          },
          "remarks": {
            "type": "string",
            "description": "备注"
          }
        },
        "required": [
          "work_order_id",
          "operation_id",
          "reported_quantity"
        ]
      }
    },
    {
      "name": "update_workorder_status",
      "label": "更新工单状态",
      "kind": "write",
      "description": "更新工单状态（仅放行迁移：已下达→in_progress、in_progress→paused、paused→in_progress、in_progress→cancelled）",
      "permission": "kuaizhizao:work-order:update",
      "handler": "apps.kuaiai.services.chat_tools:update_workorder_status",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "paused",
              "cancelled"
            ],
            "description": "目标状态"
          }
        },
        "required": [
          "work_order_id",
          "status"
        ]
      }
    },
    {
      "name": "query_inventory",
      "label": "查询库存",
      "kind": "read",
      "description": "查询即时库存余额（物料×仓库结存，支持关键词/仓库过滤）",
      "permission": "kuaizhizao:inventory:read",
      "handler": "apps.kuaiai.services.scene_tools:query_inventory",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "关键词（物料编码/名称/仓库）"
          },
          "warehouse_id": {
            "type": "integer",
            "description": "仓库 ID"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "analyze_delivery_risk",
      "label": "分析交期风险",
      "kind": "read",
      "description": "查询工单交期风险（逾期/MTO连带），按当前用户工单数据范围过滤",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.scene_tools:analyze_delivery_risk",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_purchase_orders",
      "label": "查询采购订单",
      "kind": "read",
      "description": "查询采购订单摘要（供应商/采购员/状态/到货日期过滤，按当前用户采购数据范围过滤）",
      "permission": "kuaizhizao:purchase-order:read",
      "handler": "apps.kuaiai.services.scene_tools:query_purchase_orders",
      "parameters": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID"
          },
          "buyer_id": {
            "type": "integer",
            "description": "采购员 ID"
          },
          "status": {
            "type": "string",
            "description": "订单状态"
          },
          "delivery_date_from": {
            "type": "string",
            "description": "要求到货日期起（YYYY-MM-DD）"
          },
          "delivery_date_to": {
            "type": "string",
            "description": "要求到货日期止（YYYY-MM-DD）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_schedule",
      "label": "查询排程",
      "kind": "read",
      "description": "查询某日已发布滚动排程摘要（仅 published/closed 计划可读）",
      "permission": "kuaizhizao:plan-management-rolling-scheduling:read",
      "handler": "apps.kuaiai.services.scene_tools:query_schedule",
      "parameters": {
        "type": "object",
        "properties": {
          "plan_date": {
            "type": "string",
            "description": "计划日期（YYYY-MM-DD）"
          }
        },
        "required": [
          "plan_date"
        ]
      }
    },
    {
      "name": "analyze_quality",
      "label": "分析质量异常",
      "kind": "read",
      "description": "查询质量异常记录摘要（不合格检验，按检验类型/日期/物料/供应商过滤）",
      "permission": "kuaizhizao:quality-analysis:read",
      "handler": "apps.kuaiai.services.scene_tools:analyze_quality",
      "parameters": {
        "type": "object",
        "properties": {
          "inspection_type": {
            "type": "string",
            "enum": [
              "incoming",
              "process",
              "finished"
            ],
            "description": "检验类型"
          },
          "start_date": {
            "type": "string",
            "description": "开始日期（YYYY-MM-DD）"
          },
          "end_date": {
            "type": "string",
            "description": "结束日期（YYYY-MM-DD）"
          },
          "material_id": {
            "type": "integer",
            "description": "物料 ID"
          },
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID（仅来料检验）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_sales_orders",
      "label": "查询销售订单",
      "kind": "read",
      "description": "查询销售订单交付进度（view=summary 表头摘要：单号/客户/状态/交期/交货进度；view=lines 明细行：物料/数量/已交/行交期，按当前用户数据范围过滤）",
      "permission": "kuaizhizao:sales-order:read",
      "handler": "apps.kuaiai.services.tools.sales_purchase:query_sales_orders",
      "parameters": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "lines"
            ],
            "description": "查询视图：summary 表头摘要（默认），lines 明细行"
          },
          "order_code": {
            "type": "string",
            "description": "订单编码（模糊）"
          },
          "customer_name": {
            "type": "string",
            "description": "客户名称（模糊）"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_REVIEW",
              "AUDITED",
              "REJECTED",
              "CONFIRMED",
              "CLOSED",
              "CANCELLED",
              "COMPLETED"
            ],
            "description": "订单状态（DemandStatus 枚举值）"
          },
          "start_date": {
            "type": "string",
            "description": "订单日期起（YYYY-MM-DD）"
          },
          "end_date": {
            "type": "string",
            "description": "订单日期止（YYYY-MM-DD）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_purchase_arrival_warnings",
      "label": "查询采购到货预警",
      "kind": "read",
      "description": "查询采购到货预警行（临期/逾期与处理状态，与预警页同口径，按当前用户采购单数据范围过滤）",
      "permission": "kuaizhizao:purchase-arrival-warning:read",
      "handler": "apps.kuaiai.services.tools.sales_purchase:query_purchase_arrival_warnings",
      "parameters": {
        "type": "object",
        "properties": {
          "warning_level": {
            "type": "string",
            "enum": [
              "normal",
              "imminent",
              "overdue"
            ],
            "description": "预警级别：normal 正常 / imminent 临期 / overdue 逾期"
          },
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID"
          },
          "order_code": {
            "type": "string",
            "description": "采购单编码（模糊）"
          },
          "processing_status": {
            "type": "string",
            "enum": [
              "unprocessed",
              "reported",
              "pending_review",
              "approved",
              "change_pending",
              "changed",
              "rejected"
            ],
            "description": "处理状态"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_inventory_alerts",
      "label": "查询库存预警",
      "kind": "read",
      "description": "查询租户库存预警记录；摘要含物料、仓库、预警类型/级别、当前量/阈值与状态；仅返回当前用户数据范围内记录，不含金额类字段",
      "permission": "kuaizhizao:warehouse-management-inventory-alert:read",
      "handler": "apps.kuaiai.services.tools.inventory_alerts:query_inventory_alerts",
      "parameters": {
        "type": "object",
        "properties": {
          "alert_type": {
            "type": "string",
            "enum": [
              "low_stock",
              "high_stock",
              "expired"
            ],
            "description": "预警类型（可选）"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "resolved",
              "ignored"
            ],
            "description": "预警状态（可选）"
          },
          "alert_level": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "description": "预警级别（可选）"
          },
          "material_id": {
            "type": "integer",
            "description": "物料ID（可选）"
          },
          "warehouse_id": {
            "type": "integer",
            "description": "仓库ID（可选）"
          },
          "keyword": {
            "type": "string",
            "description": "关键词（编码/名称/消息，可选）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_replenishment_suggestions",
      "label": "查询补货建议",
      "kind": "read",
      "description": "查询租户补货建议；摘要含物料、建议补货量、建议下单日期、优先级与状态；仅返回当前用户数据范围内记录，不含金额类字段",
      "permission": "kuaizhizao:warehouse-management-replenishment-suggestions:read",
      "handler": "apps.kuaiai.services.tools.inventory_alerts:query_replenishment_suggestions",
      "parameters": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processed",
              "ignored"
            ],
            "description": "建议状态（可选）"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "优先级（可选）"
          },
          "suggestion_type": {
            "type": "string",
            "enum": [
              "low_stock",
              "demand_based",
              "seasonal"
            ],
            "description": "建议类型（可选）"
          },
          "material_id": {
            "type": "integer",
            "description": "物料ID（可选）"
          },
          "warehouse_id": {
            "type": "integer",
            "description": "仓库ID（可选）"
          },
          "keyword": {
            "type": "string",
            "description": "关键词（编码/名称/备注，可选）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_slow_moving_inventory",
      "label": "查询呆滞料",
      "kind": "read",
      "description": "查询租户呆滞料（物料批结存超阈值天数无变动）；摘要含物料、仓库、结存量与库龄天数；仅返回当前用户数据范围内批次，不含金额类字段",
      "permission": "kuaizhizao:warehouse-management-reports-slow-moving-inventory:read",
      "handler": "apps.kuaiai.services.tools.inventory_alerts:query_slow_moving_inventory",
      "parameters": {
        "type": "object",
        "properties": {
          "warehouse_id": {
            "type": "integer",
            "description": "仓库ID（可选，按批次可见仓库过滤）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "analyze_kitting",
      "label": "分析工单齐套",
      "kind": "read",
      "description": "分析单张工单齐套率与缺料明细（物料/需求/可用/缺口，按缺口降序前20）；纯计算不写库；仅当前用户数据范围内工单可分析",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.tools.kitting_exceptions:analyze_kitting",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单ID（必填）"
          }
        },
        "required": ["work_order_id"]
      }
    },
    {
      "name": "query_material_shortages",
      "label": "查询缺料异常",
      "kind": "read",
      "description": "查询缺料异常记录；摘要含工单、物料、需求/可用/缺口、预警级别与状态；仅返回当前用户工单数据范围内记录",
      "permission": "kuaizhizao:production-execution-material-shortage-exceptions:read",
      "handler": "apps.kuaiai.services.tools.kitting_exceptions:query_material_shortages",
      "parameters": {
