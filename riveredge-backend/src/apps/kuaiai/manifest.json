  "permissions": [
    "kuaiai:entry:read",
    "kuaiai:act:execute",
    "kuaiai:session:display",
    "kuaiai:session:read",
    "kuaiai:session:create",
    "kuaiai:session:update",
    "kuaiai:session:delete",
    "kuaiai:agent:display",
    "kuaiai:agent:read",
    "kuaiai:agent:create",
    "kuaiai:agent:update",
    "kuaiai:agent:delete",
    "kuaiai:knowledge:display",
    "kuaiai:knowledge:read",
    "kuaiai:knowledge:create",
    "kuaiai:knowledge:update",
    "kuaiai:knowledge:delete",
    "kuaiai:mcp:display",
    "kuaiai:mcp:read",
    "kuaiai:mcp:create",
    "kuaiai:mcp:update",
    "kuaiai:mcp:delete",
    "kuaiai:model:display",
    "kuaiai:model:read",
    "kuaiai:model:create",
    "kuaiai:model:update",
    "kuaiai:model:delete",
    "kuaiai:hub:display",
    "kuaiai:library:display",
    "kuaiai:library:manage",
    "kuaiai:pulse:display",
    "kuaiai:corpus:display",
    "kuaiai:corpus:create",
    "kuaiai:corpus:update",
    "kuaiai:corpus:delete",
    "kuaiai:corpus:export",
    "kuaiai:trust:display",
    "kuaiai:insights:display",
    "kuaiai:settings:display",
    "kuaiai:settings:update"
  ],
  "ai_tools": [
    {
      "name": "search_knowledge",
      "description": "检索企业知识库（返回相关文档片段）",
      "permission": "kuaiai:act:execute",
      "handler": "apps.kuaiai.services.chat_tools:search_knowledge",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索问题"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "query_workorder",
      "description": "查询生产工单（按工单 id 查详情摘要，或按编码/关键词/状态列表查询）",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.chat_tools:query_workorder",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "code": {
            "type": "string",
            "description": "工单编码（模糊）"
          },
          "keyword": {
            "type": "string",
            "description": "关键词（编码/名称/产品）"
          },
          "status": {
            "type": "string",
            "description": "工单状态过滤"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10）"
          }
        }
      }
    },
    {
      "name": "list_workorder_tasks",
      "description": "列出工单工序任务及各自状态/完成数量",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.chat_tools:list_workorder_tasks",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          }
        },
        "required": [
          "work_order_id"
        ]
      }
    },
    {
      "name": "submit_production_feedback",
      "description": "为工单工序提交报工（本人自报；代报/小组报工走业务页面）",
      "permission": "kuaizhizao:production-execution-reporting:create",
      "handler": "apps.kuaiai.services.chat_tools:submit_production_feedback",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "operation_id": {
            "type": "integer",
            "description": "工序 ID（list_workorder_tasks 返回的 operation_id）"
          },
          "reported_quantity": {
            "type": "number",
            "description": "报工数量"
          },
          "qualified_quantity": {
            "type": "number",
            "description": "合格数量（缺省=报工-不合格）"
          },
          "unqualified_quantity": {
            "type": "number",
            "description": "不合格数量"
          },
          "work_hours": {
            "type": "number",
            "description": "工时（小时，可空）"
          },
          "remarks": {
            "type": "string",
            "description": "备注"
          }
        },
        "required": [
          "work_order_id",
          "operation_id",
          "reported_quantity"
        ]
      }
    },
    {
      "name": "update_workorder_status",
      "description": "更新工单状态（仅放行迁移：已下达→in_progress、in_progress→paused、paused→in_progress、in_progress→cancelled）",
      "permission": "kuaizhizao:work-order:update",
      "handler": "apps.kuaiai.services.chat_tools:update_workorder_status",
      "parameters": {
        "type": "object",
        "properties": {
          "work_order_id": {
            "type": "integer",
            "description": "工单 ID"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "paused",
              "cancelled"
            ],
            "description": "目标状态"
          }
        },
        "required": [
          "work_order_id",
          "status"
        ]
      }
    },
    {
      "name": "query_inventory_balance",
      "description": "查询即时库存余额（物料×仓库结存，支持关键词/仓库过滤）",
      "permission": "kuaizhizao:inventory:read",
      "handler": "apps.kuaiai.services.scene_tools:query_inventory_balance",
      "parameters": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "关键词（物料编码/名称/仓库）"
          },
          "warehouse_id": {
            "type": "integer",
            "description": "仓库 ID"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_delivery_risk",
      "description": "查询工单交期风险（逾期/MTO连带），按当前用户工单数据范围过滤",
      "permission": "kuaizhizao:work-order:read",
      "handler": "apps.kuaiai.services.scene_tools:query_delivery_risk",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_purchase_followup",
      "description": "查询采购订单跟单摘要（供应商/采购员/状态/到货日期过滤）",
      "permission": "kuaizhizao:purchase-order:read",
      "handler": "apps.kuaiai.services.scene_tools:query_purchase_followup",
      "parameters": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID"
          },
          "buyer_id": {
            "type": "integer",
            "description": "采购员 ID"
          },
          "status": {
            "type": "string",
            "description": "订单状态"
          },
          "delivery_date_from": {
            "type": "string",
            "description": "要求到货日期起（YYYY-MM-DD）"
          },
          "delivery_date_to": {
            "type": "string",
            "description": "要求到货日期止（YYYY-MM-DD）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_published_schedule",
      "description": "查询某日已发布滚动排程摘要（仅 published/closed 计划可读）",
      "permission": "kuaizhizao:plan-management-rolling-scheduling:read",
      "handler": "apps.kuaiai.services.scene_tools:query_published_schedule",
      "parameters": {
        "type": "object",
        "properties": {
          "plan_date": {
            "type": "string",
            "description": "计划日期（YYYY-MM-DD）"
          }
        },
        "required": [
          "plan_date"
        ]
      }
    },
    {
      "name": "query_quality_anomalies",
      "description": "查询质量异常记录摘要（不合格检验，按检验类型/日期/物料/供应商过滤）",
      "permission": "kuaizhizao:quality-analysis:read",
      "handler": "apps.kuaiai.services.scene_tools:query_quality_anomalies",
      "parameters": {
        "type": "object",
        "properties": {
          "inspection_type": {
            "type": "string",
            "enum": [
              "incoming",
              "process",
              "finished"
            ],
            "description": "检验类型"
          },
          "start_date": {
            "type": "string",
            "description": "开始日期（YYYY-MM-DD）"
          },
          "end_date": {
            "type": "string",
            "description": "结束日期（YYYY-MM-DD）"
          },
          "material_id": {
            "type": "integer",
            "description": "物料 ID"
          },
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID（仅来料检验）"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        }
      }
    },
    {
      "name": "query_supplier_orders",
      "description": "查询指定供应商的采购订单摘要（按当前用户采购数据范围过滤）",
      "permission": "kuaizhizao:purchase-order:read",
      "handler": "apps.kuaiai.services.scene_tools:query_supplier_orders",
      "parameters": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "integer",
            "description": "供应商 ID"
          },
          "status": {
            "type": "string",
            "description": "订单状态"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数上限（默认10，最大20）"
          }
        },
        "required": [
          "supplier_id"
        ]
      }
    }
  ],
  "dependencies": {
    "riveredge-backend": ">=1.0.0",
    "riveredge-frontend": ">=1.0.0"
  }
}
